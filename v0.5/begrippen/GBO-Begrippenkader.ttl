    skos:prefLabel "Module inschrijving"@nl ;
    adms:status "proposed" .

gbobegrip:NietNatuurlijkPersoon a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0021777>,
        "Stelselcatalogus; BW boek 2; Handelsregisterwet 2007 art. 10 lid 3 en art. 12",
        "publicatie/linkml/bedrijven-en-instellingen.yaml" ;
    skos:altLabel "Non-natural Person"@en,
        "NNP"@nl ;
    skos:broader gbobegrip:Partij ;
    skos:closeMatch gbobegrip:Rechtspersoon ;
    skos:definition "Een niet-natuurlijke persoon is een deelnemer aan het rechtsverkeer die rechten en plichten kan dragen en die geen mens is: een organisatie of rechtsfiguur zoals een BV, een stichting, een vereniging, een eenmanszaak, een VOF of een buitenlandse onderneming met activiteit in Nederland."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Niet Natuurlijk Persoon"@nl ;
    skos:relatedMatch gbobegrip:MaatschappelijkeActiviteit ;
    skos:scopeNote "De functionele indeling in bedrijf, overheidsinstelling, maatschappelijke instelling, buitenlandse entiteit of overige is een afgeleide classificatie op de juridische vorm, geen aparte soort."@nl,
        "Rechtspersoonlijkheid is geen voorwaarde: ook entiteiten zonder eigen rechtspersoonlijkheid (VOF, CV, maatschap, eenmanszaak) vallen eronder wanneer zij als wederpartij in een rechtsbetrekking optreden."@nl ;
    adms:status "proposed" .

gbobegrip:OnroerendeZaakOverigBezit a skos:Concept ;
    dcterms:source "Algemeen taalgebruik",
        "Wet IB 2001 art. 5.3 jo. SBR-NT NT20" ;
    skos:altLabel "Tweede woning"@nl,
        "Verhuurpand"@nl ;
