        "Algemeen Reglement CKI 2024-07-01 art. 26",
        "Algemeen taalgebruik" ;
    skos:altLabel "Flash-lening"@nl,
        "Mini-lening"@nl ;
    skos:broader gbobegrip:KredietOvereenkomst ;
