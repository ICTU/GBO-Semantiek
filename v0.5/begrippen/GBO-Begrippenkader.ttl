        gbobegrip:HerstelMelding ;
    skos:prefLabel "Krediet feit"@nl ;
    adms:status "proposed" .

gbobegrip:UitkeringWIA a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0019057>,
        "Wet WIA" ;
    skos:broader gbobegrip:Uitkering ;
    skos:definition "Een door UWV op grond van de Wet werk en inkomen naar arbeidsvermogen toegekende periodieke uitkering aan een werknemer die na een wachttijd van twee jaar van ziekte gedeeltelijk of volledig arbeidsongeschikt is."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:narrower gbobegrip:UitkeringIVA,
        gbobegrip:UitkeringWGA ;
    skos:prefLabel "Uitkering WIA"@nl ;
    adms:status "proposed" .

gbobegrip:Aangifte a skos:Concept ;
