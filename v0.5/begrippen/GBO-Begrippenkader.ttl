gbobegrip:LijfrenteAftrek a skos:Concept ;
    dcterms:source "Algemeen taalgebruik",
        "Wet IB 2001 art. 3.124",
        "Wet IB 2001 art. 3.124 e.v." ;
    skos:altLabel "Aftrek lijfrentepremie"@nl,
