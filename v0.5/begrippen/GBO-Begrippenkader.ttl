    dcterms:source "Algemeen taalgebruik; in CKI-context vaak synoniem",
        "FIBO Financial Obligation (close, niet exact)",
        "GBO-Kern, afgeleid uit het verbintenisrecht en het Algemeen Reglement CKI" ;
    skos:altLabel "Financial Obligation"@en,
        "Schuld"@nl ;
    skos:closeMatch <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/FinancialObligation> ;
    skos:definition "Een verplichting van een natuurlijk persoon of niet-natuurlijk persoon tot het verrichten van een geldelijke prestatie aan een tegenpartij, ontstaan uit overeenkomst of uit een wettelijke regeling."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:narrower gbobegrip:KredietOvereenkomst,
        gbobegrip:SchuldhulpverleningTraject ;
    skos:prefLabel "Financiele verplichting"@nl ;
    adms:status "proposed" .

gbobegrip:FiscaalFeit a skos:Concept ;
    dcterms:source "GBO-Kern, afgeleid uit SBR-NT NT20",
        "SBR-NT terminologie" ;
    skos:altLabel "Aangiftecomponent"@nl ;
    skos:definition "Een fiscaal relevant gegeven over een belastingplichtige dat in een specifiek belastingjaar als component in een belastingaangifte verschijnt."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:narrower gbobegrip:Aftrekpost,
        gbobegrip:VermogensBestanddeel ;
    skos:prefLabel "Fiscaal feit"@nl ;
    adms:status "proposed" .

gbobegrip:FiscaleOpgave a skos:Concept ;
    dcterms:source "GBO-Kern" ;
    skos:definition "Een samenhangende opgave van de fiscale positie van een belastingplichtige over een belastingjaar, waarin fiscale feiten als rubriek zijn opgenomen."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:narrower gbobegrip:Aangifte,
        gbobegrip:Aanslag ;
    skos:prefLabel "Fiscale opgave"@nl ;
    adms:status "proposed" .

gbobegrip:InkomensOndersteuning a skos:Concept ;
    dcterms:source "GBO-Kern abstractie boven Awir en sociale-zekerheidsregelingen" ;
    skos:definition "Een door of namens de overheid aan een natuurlijk persoon verstrekte financiele bijdrage met als doel inkomensondersteuning."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:narrower gbobegrip:Toeslag,
        gbobegrip:Uitkering ;
    skos:prefLabel "Inkomens ondersteuning"@nl ;
    adms:status "proposed" .

gbobegrip:OpleidingDeelname a skos:Concept ;
    dcterms:source "ELMO 1.4 (te bevestigen)",
        "GBO-Kern, afgeleid uit PvE ROD per sector",
        "PvE ROD HO",
        "PvE ROD per sector",
        "Wet op het onderwijsnummer art. 1 onder b" ;
    skos:altLabel "Enrollment"@en,
        "Inschrijving"@nl,
        "Onderwijsdeelname"@nl,
        "Onderwijsinschrijving"@nl ;
    skos:closeMatch <https://elmo.eu/learner-enrollment> ;
    skos:definition "De inschrijving van een natuurlijk persoon voor het volgen van een opleiding bij een onderwijsinstelling, geldig binnen een afgebakende periode."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:narrower gbobegrip:BeroepspraktijkvormingPeriode,
        gbobegrip:ModuleInschrijving ;
    skos:prefLabel "Opleiding deelname"@nl ;
    skos:scopeNote "Vaststelling van het feit dat een leerling/student aan een opleiding bij een onderwijsinstelling deelneemt, op grond van de Wet op het onderwijsnummer en bijbehorende sectorwet."@nl ;
    adms:status "proposed" .

gbobegrip:UitkeringIVA a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0019057>,
        "Wet WIA hoofdstuk IV" ;
    skos:broader gbobegrip:UitkeringWIA ;
    skos:definition "De Inkomensvoorziening Volledig Arbeidsongeschikten op grond van de WIA, toegekend aan werknemers die duurzaam minder dan 20% van hun oude loon kunnen verdienen."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Uitkering IVA"@nl ;
    adms:status "proposed" .

gbobegrip:UitkeringWGA a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0019057>,
        "Wet WIA hoofdstuk VII" ;
    skos:broader gbobegrip:UitkeringWIA ;
    skos:definition "De Werkhervatting Gedeeltelijk Arbeidsongeschikten op grond van de WIA, toegekend aan werknemers die 35% tot 80% arbeidsongeschikt zijn, of volledig arbeidsongeschikt maar niet duurzaam."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Uitkering WGA"@nl ;
    adms:status "proposed" .

gbobegrip:KredietFeit a skos:Concept ;
    dcterms:source <https://www.bkr.nl/media/4dyezfiz/algemeen-reglement-cki-juli-2024.pdf>,
