  "graphql": {
    "service_reference": "bri",
    "endpoint": "/graphql",
    "document": "query Inkomensverklaring($bsn: BSN!, $jaar: Int!) {\n  aangifteOverJaar(bsn: $bsn, jaar: [$jaar]) {\n    belastingjaar\n    indieningsdatum\n    status\n    ... on AangifteInkomstenbelasting {\n      verzamelinkomen {\n        waarde\n      }\n      box1Inkomen {\n        waarde\n      }\n      box2Inkomen {\n        waarde\n      }\n      box3Inkomen {\n        waarde\n      }\n    }\n  }\n}",
    "subject_variable": "bsn",
    "parameters": {
      "jaar": {
        "type": "integer",
        "required": true
      }
    },
    "result_pointer": "/data/aangifteOverJaar"
  },
  "mapping_profile": "gbo-simple-v1",
  "mapping": {
    "belastingjaar": {
      "pointer": "/belastingjaar",
      "datatype": "gYear"
    },
    "indieningsdatum": {
      "pointer": "/indieningsdatum",
      "datatype": "date",
      "optional": true
    },
    "verzamelinkomen": {
      "pointer": "/verzamelinkomen/waarde",
      "datatype": "integer"
    },
    "inkomen_box1": {
      "pointer": "/box1Inkomen/waarde",
      "datatype": "integer",
      "optional": true
    },
    "inkomen_box2": {
      "pointer": "/box2Inkomen/waarde",
      "datatype": "integer",
      "optional": true
    },
    "inkomen_box3": {
      "pointer": "/box3Inkomen/waarde",
      "datatype": "integer",
      "optional": true
    },
    "aangifte_status": {
      "pointer": "/status",
      "datatype": "string"
    }
  },
  "attribute_schema": {
    "belastingjaar": {
      "type": "integer",
      "format": "gYear"
    },
    "indieningsdatum": {
      "type": "string",
      "format": "date"
    },
    "verzamelinkomen": {
      "type": "integer",
      "unit": "EUR"
    },
    "inkomen_box1": {
