    rdfs:label "Gereed" ;
    rdfs:subClassOf gbotm:productstatus ;
    skos:definition "Besloten en gereed, maar nog niet ingegaan; de geldigheid begint later." .

<https://lod.gbo-semantiek.nl/toestemmingen/productstatus#Geweigerd> a owl:Class ;
    rdfs:label "Geweigerd" ;
    rdfs:subClassOf gbotm:productstatus ;
    skos:definition "De aanvraag is afgewezen." .

<https://lod.gbo-semantiek.nl/toestemmingen/productstatus#InAanvraag> a owl:Class ;
    rdfs:label "InAanvraag" ;
    rdfs:subClassOf gbotm:productstatus ;
    skos:definition "De aanvraag is in behandeling." .

<https://lod.gbo-semantiek.nl/toestemmingen/productstatus#Ingetrokken> a owl:Class ;
    rdfs:label "Ingetrokken" ;
    rdfs:subClassOf gbotm:productstatus ;
    skos:definition "Door een later besluit ingetrokken voor het einde van de geldigheid." .

<https://lod.gbo-semantiek.nl/toestemmingen/productstatus#Initieel> a owl:Class ;
    rdfs:label "Initieel" ;
    rdfs:subClassOf gbotm:productstatus ;
    skos:definition "Aangemaakt, nog niet in behandeling." .

<https://lod.gbo-semantiek.nl/toestemmingen/productstatus#Verlopen> a owl:Class ;
    rdfs:label "Verlopen" ;
    rdfs:subClassOf gbotm:productstatus ;
    skos:definition "De geldigheidstermijn is verstreken." .

gbotm:producttype a owl:DatatypeProperty ;
    rdfs:label "producttype" ;
    skos:definition "Het producttype, oftewel de vergunningsoort, als code of naam uit de producten- en dienstencatalogus van de gemeente." ;
    skos:inScheme gbo:toestemmingen ;
    skos:note "Pilot: tekstveld in plaats van de relatie \"is van\" naar het objecttype Producttype. Zie de todo bovenaan dit schema." ;
    mim:lengte 80 .

gbotm:registratienummer a owl:DatatypeProperty ;
    rdfs:label "registratienummer" ;
    skos:definition "Registratie- of senumnummer van het vaartuig, voor zover aanwezig." ;
    skos:inScheme gbo:toestemmingen ;
    mim:lengte 20 .

gbotm:risicoklasse a owl:DatatypeProperty ;
    rdfs:label "risicoklasse" ;
    skos:definition "Risicoklasse volgens de regionale risicoscan: A is regulier, B is aandacht, C is risicovol." ;
    skos:inScheme gbo:toestemmingen ;
    mim:lengte 1 .

gbotm:soortEvenement a owl:DatatypeProperty ;
    rdfs:label "soortEvenement" ;
    skos:definition "Soort evenement, bijvoorbeeld muziekevenement, braderie of markt, optocht, sportevenement, buurtfeest, kermis of circus." ;
    skos:inScheme gbo:toestemmingen ;
    mim:lengte 80 .

gbotm:soortKaart a owl:ObjectProperty ;
    rdfs:label "soortKaart" ;
    skos:definition "Soort kaart naar de hoedanigheid van de houder." ;
    skos:inScheme gbo:toestemmingen .

gbotm:soortMarktplaats a owl:ObjectProperty ;
    rdfs:label "soortMarktplaats" ;
    skos:definition "Soort marktplaats waarvoor de vergunning geldt." ;
    skos:inScheme gbo:toestemmingen .

gbotm:soortOntheffing a owl:DatatypeProperty ;
    rdfs:label "soortOntheffing" ;
    skos:definition "Soort ontheffing, bijvoorbeeld blauwe zone, voetgangersgebied, milieuzone, grote voertuigen, autobedrijf of reclamevoertuig." ;
    skos:inScheme gbo:toestemmingen ;
    mim:lengte 40 .

gbotm:soortOptreden a owl:DatatypeProperty ;
    rdfs:label "soortOptreden" ;
    skos:definition "Aard van het optreden, bijvoorbeeld muziek, zang, levend standbeeld, acrobatiek, portrettekenen, rondleiding of straatfotografie." ;
    skos:inScheme gbo:toestemmingen ;
    mim:lengte 80 .

gbotm:soortStandplaats a owl:ObjectProperty ;
    rdfs:label "soortStandplaats" ;
    skos:definition "Soort standplaats naar tijdsduur." ;
    skos:inScheme gbo:toestemmingen .

gbotm:soortToestemming a owl:ObjectProperty ;
    rdfs:label "soortToestemming" ;
    skos:definition "De juridische soort van de toestemming." ;
    skos:inScheme gbo:toestemmingen ;
    skos:note "Pilot: in het wijzigingsvoorstel is dit een kenmerk van het producttype. Zolang producttype een tekstveld is, staat de soort hier, zodat vergunning en ontheffing onderscheidbaar blijven." .

<https://lod.gbo-semantiek.nl/toestemmingen/soortgehandicaptenparkeerkaart#Bestuurder> a owl:Class ;
    rdfs:label "Bestuurder" ;
