@prefix gbo: <https://lod.gbo-semantiek.nl/> .
@prefix gbobegrip: <https://begrippen.gbo-semantiek.nl/id/begrip/> .
@prefix gbotm: <https://lod.gbo-semantiek.nl/toestemmingen/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix mim: <https://lod.gbo-semantiek.nl/def/mim#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gbotm:document a owl:DatatypeProperty ;
    rdfs:label "document" ;
    skos:definition "Identificaties van de documenten waarin de toestemming is vastgelegd: de vergunning zelf, aanhangsels en tekeningen." ;
    skos:inScheme gbo:toestemmingen ;
    skos:note "Pilot: tekstveld in plaats van de relatie \"is vastgelegd in\"." ;
    mim:herkomst "RGBZ (InformatieObject.identificatie)" .

gbotm:vervanger a owl:ObjectProperty ;
    rdfs:label "vervanger" ;
    skos:definition "Personen die de vergunninghouder bij afwezigheid mogen vervangen." ;
    skos:inScheme gbo:toestemmingen ;
    skos:note "Demo-vereenvoudiging: in het wijzigingsvoorstel een Rechtspersoon (RSGB)." ;
    mim:herkomst "VNG Model Marktverordening" .

gbotm:Evenementenvergunning a owl:Class ;
    rdfs:label "Evenementenvergunning" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty gbotm:soortEvenement ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:time ;
            owl:onProperty gbotm:eindtijdMuziek ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:opbouwVanaf ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbotm:OpenbareActiviteit ;
            owl:onProperty gbotm:betreft ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty gbotm:soortEvenement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:maximaalAantalBezoekers ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty gbotm:risicoklasse ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:tijdvakPerDag ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:risicoklasse ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/datatypes/indicatie> ;
            owl:onProperty gbotm:alcoholverstrekking ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:alcoholverstrekking ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Numeriek ;
            owl:onProperty gbotm:maximaalAantalBezoekers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:afbouwTot ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:DatumTijd ;
            owl:onProperty gbotm:opbouwVanaf ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty gbotm:tijdvakPerDag ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:eindtijdMuziek ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:DatumTijd ;
            owl:onProperty gbotm:afbouwTot ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty gbotm:betreft ],
        gbotm:Toestemming ;
    skos:definition "Toestemming van de burgemeester voor het organiseren van een evenement: een voor publiek toegankelijke verrichting van vermaak op of aan de weg of in de openbare ruimte." ;
    skos:definitionSource "VNG Model-APV art. 2:25" ;
    skos:definitionSourceUri "https://vng.nl/artikelen/model-apv" ;
    skos:definition_nl "Toestemming van de burgemeester voor het organiseren van een evenement: een voor publiek toegankelijke verrichting van vermaak op of aan de weg of in de openbare ruimte, zoals een muziekevenement, braderie, optocht, sportevenement, buurtfeest, kermis of circus." ;
    skos:exactMatch gbobegrip:Evenementenvergunning,
        gbotm:Evenementenvergunning ;
    skos:inScheme gbo:toestemmingen ;
    skos:note "De geldigheid (datumStart en datumEinde) omvat de evenementdag of -dagen inclusief op- en afbouw.",
        "Het evenement zelf is een eigen ding dat meerdere besluiten kan kennen (evenementenvergunning, ontheffing art. 35 Alcoholwet, verkeersbesluit). Daarom verwijst de vergunning naar OpenbareActiviteit en herhaalt zij naam, data en organisator niet." ;
    skos:prefLabel_nl "Evenementenvergunning" ;
    skos:status "proposed" ;
    mim:bevoegdGezag "burgemeester" ;
    mim:datumOpname "2026-08-21" ;
    mim:elementtype "Objecttype" ;
    mim:herkomst "GGM (wijzigingsvoorstel Toestemming en Product, pilotversie)" ;
    mim:populatie "Alle door de burgemeester verleende evenementenvergunningen." ;
    mim:uniekeAanduiding "identificatie (geerfd van Toestemming)" ;
    mim:uniformeProductnaam "evenementenvergunning" ;
    mim:wettelijkeGrondslag "VNG Model-APV art. 2:25" .

gbotm:Gehandicaptenparkeerkaart a owl:Class ;
    rdfs:label "Gehandicaptenparkeerkaart" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gbo:Identificatie ;
            owl:onProperty gbotm:kaartnummer ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty gbotm:kaartnummer ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty gbotm:soortKaart ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbotm:soortgehandicaptenparkeerkaart ;
            owl:onProperty gbotm:soortKaart ],
        gbotm:Toestemming ;
    skos:altLabel_nl_0_source "Regeling gehandicaptenparkeerkaart (Europees model)" ;
    skos:altLabel_nl_0_value "Europese gehandicaptenparkeerkaart" ;
    skos:definition "Kaart volgens Europees model, door het college verstrekt aan een persoon met een beperking of aan een instelling, die recht geeft op het gebruik van gehandicaptenparkeerplaatsen en op de daaraan verbonden uitzonderingen op parkeerverboden." ;
    skos:definitionSource "BABW art. 49-55; Regeling gehandicaptenparkeerkaart" ;
    skos:definitionSourceUri "https://wetten.overheid.nl/BWBR0007702" ;
    skos:definition_nl "Kaart volgens Europees model, door het college verstrekt aan een persoon met een beperking (bestuurder of passagier) of aan een instelling, die recht geeft op het gebruik van gehandicaptenparkeerplaatsen en op de daaraan verbonden uitzonderingen op parkeerverboden." ;
    skos:exactMatch gbobegrip:Gehandicaptenparkeerkaart,
        gbotm:Gehandicaptenparkeerkaart ;
    skos:inScheme gbo:toestemmingen ;
    skos:note "De kaart is formeel geen vergunning maar een Europees erkend bewijs dat de houder ontheft van parkeerverboden; daarom soortToestemming \"ontheffing\".",
        "De kaart is persoonsgebonden en niet voertuiggebonden, en geldt maximaal vijf jaar (datumEinde). Medische gegevens zoals het keuringsadvies worden niet vastgelegd." ;
    skos:prefLabel_nl "Gehandicaptenparkeerkaart" ;
    skos:status "proposed" ;
    mim:bevoegdGezag "college van burgemeester en wethouders" ;
    mim:datumOpname "2026-08-21" ;
    mim:elementtype "Objecttype" ;
    mim:herkomst "GGM (wijzigingsvoorstel Toestemming en Product, pilotversie)" ;
    mim:populatie "Alle door het college verstrekte gehandicaptenparkeerkaarten." ;
    mim:uniekeAanduiding "identificatie (geerfd van Toestemming); kaartnummer is uniek per kaart" ;
    mim:uniformeProductnaam "gehandicaptenparkeerkaart bestuurder / passagier / instellingen" ;
    mim:wettelijkeGrondslag "BABW art. 49; Regeling gehandicaptenparkeerkaart" .

gbotm:Ligplaatsontheffing a owl:Class ;
    rdfs:label "Ligplaatsontheffing" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gbo:Numeriek ;
            owl:onProperty gbotm:stickernummer ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbotm:Vaartuig ;
            owl:onProperty gbotm:betreft ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:stickernummer ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:ligplaatsaanduiding ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty gbotm:ligplaatsaanduiding ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty gbotm:betreft ],
        gbotm:Toestemming ;
    skos:altLabel_nl_0_source "Uniforme Productnamenlijst (Logius)" ;
    skos:altLabel_nl_0_value "Ligplaatsvergunning" ;
    skos:definition "Toestemming om met een vaartuig een ligplaats in te nemen op of in openbaar water waar een ligplaatsverbod geldt." ;
    skos:definitionSource "VNG Model-APV art. 5:25; gemeentelijke havenverordening" ;
    skos:definitionSourceUri "https://vng.nl/artikelen/model-apv" ;
    skos:definition_nl "Toestemming om met een vaartuig een ligplaats in te nemen op of in openbaar water waar een ligplaatsverbod geldt." ;
    skos:exactMatch gbobegrip:Ligplaatsontheffing,
        gbotm:Ligplaatsontheffing ;
    skos:inScheme gbo:toestemmingen ;
    skos:note "Bestaande GGM-klasse die in de pilotversie van Toestemming gaat erven: stickernummer wordt optioneel, ligplaatsaanduiding en de relatie naar Vaartuig zijn nieuw." ;
    skos:prefLabel_nl "Ligplaatsontheffing" ;
    skos:status "proposed" ;
    mim:bevoegdGezag "college van burgemeester en wethouders" ;
    mim:datumOpname "2026-08-21" ;
    mim:elementtype "Objecttype" ;
    mim:herkomst "GGM Model VTH (bestaande klasse, uitgebreid in de pilotversie)" ;
    mim:populatie "Alle door het college verleende ligplaatsontheffingen en -vergunningen." ;
    mim:uniekeAanduiding "identificatie (geerfd van Toestemming)" ;
    mim:uniformeProductnaam "ligplaatsvergunning" ;
    mim:wettelijkeGrondslag "VNG Model-APV art. 5:25" .

gbotm:Marktvergunning a owl:Class ;
    rdfs:label "Marktvergunning" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty gbotm:soortMarktplaats ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty gbotm:marktdagen ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty gbotm:marktdagen ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty gbotm:branche ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty gbotm:markt ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:frontbreedte ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty gbotm:markt ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:standplaatsnummer ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty gbotm:branche ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbotm:soortmarktplaats ;
            owl:onProperty gbotm:soortMarktplaats ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty gbotm:standplaatsnummer ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:NatuurlijkPersoon ;
            owl:onProperty gbotm:vervanger ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Numeriek ;
            owl:onProperty gbotm:frontbreedte ],
        gbotm:Toestemming ;
    skos:definition "Toestemming van het college voor het innemen van een standplaats op een door de gemeente ingestelde warenmarkt, als vaste standplaats, dagplaats of standwerkersplaats." ;
    skos:definitionSource "VNG Model Marktverordening art. 2 e.v.; Gemeentewet art. 160" ;
    skos:definitionSourceUri "https://wetten.overheid.nl/BWBR0005416" ;
    skos:definition_nl "Toestemming van het college voor het innemen van een standplaats op een door de gemeente ingestelde warenmarkt, als vaste standplaats, dagplaats of standwerkersplaats." ;
    skos:exactMatch gbobegrip:Marktvergunning,
        gbotm:Marktvergunning ;
    skos:inScheme gbo:toestemmingen ;
    skos:note "Een vaste standplaats geldt doorgaans voor onbepaalde tijd, een dagplaats voor een enkele marktdag." ;
    skos:prefLabel_nl "Marktvergunning" ;
    skos:status "proposed" ;
    mim:bevoegdGezag "college van burgemeester en wethouders" ;
    mim:datumOpname "2026-08-21" ;
    mim:elementtype "Objecttype" ;
    mim:herkomst "GGM (wijzigingsvoorstel Toestemming en Product, pilotversie)" ;
    mim:populatie "Alle door het college verleende marktvergunningen." ;
    mim:uniekeAanduiding "identificatie (geerfd van Toestemming)" ;
    mim:uniformeProductnaam "marktvergunning" ;
    mim:wettelijkeGrondslag "VNG Model Marktverordening art. 2; Gemeentewet art. 160" .

gbotm:OpenbareActiviteit a owl:Class ;
    rdfs:label "OpenbareActiviteit" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty gbotm:datumStart ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:locatieOmschrijving ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty gbotm:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:datumStart ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty gbotm:evenementnaam ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty gbotm:datumEinde ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty gbotm:evenementnaam ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty gbotm:locatieOmschrijving ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:datumEinde ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:NatuurlijkPersoon ;
            owl:onProperty gbotm:organisator ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty gbotm:organisator ] ;
    skos:altLabel_nl_0_source "VNG Model-APV art. 2:24 (begrip evenement)" ;
    skos:altLabel_nl_0_value "Evenement" ;
    skos:definition "Een voor publiek toegankelijke activiteit in de openbare ruimte, met een naam, een tijdvak, een locatie en een organisator." ;
    skos:definitionSource "GGM Model VTH (bestaande klasse OpenbareActiviteit)" ;
    skos:definition_nl "Een voor publiek toegankelijke activiteit in de openbare ruimte, met een naam, een tijdvak, een locatie en een organisator." ;
    skos:exactMatch gbobegrip:OpenbareActiviteit,
        gbotm:OpenbareActiviteit ;
    skos:inScheme gbo:toestemmingen ;
    skos:needsReview_0 "De GGM-klasse kent geen expliciete unieke aanduiding in het wijzigingsvoorstel; in de pilot is de activiteit uitsluitend via de vergunning bereikbaar. Bij vaststelling een identificatie toevoegen." ;
    skos:note "Het evenement is een eigen ding omdat het meerdere besluiten kan kennen: evenementenvergunning, ontheffing art. 35 Alcoholwet en verkeersbesluit. De vergunning verwijst ernaar en herhaalt de gegevens niet.",
        "In de pilotversie is het bestaande GGM-attribuut evenmentnaam hernoemd naar evenementnaam en is de relatie organisator nieuw." ;
    skos:prefLabel_nl "Openbare activiteit" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-08-21" ;
    mim:elementtype "Objecttype" ;
    mim:herkomst "GGM Model VTH (bestaande klasse, uitgebreid in de pilotversie)" ;
    mim:populatie "Alle openbare activiteiten waarvoor de gemeente een toestemming verleent of een melding registreert." .

gbotm:OverigeToestemming a owl:Class ;
    rdfs:label "OverigeToestemming" ;
    rdfs:subClassOf gbotm:Toestemming ;
    skos:definition "Een toestemming van een soort waarvoor geen eigen objecttype is uitgewerkt, met uitsluitend de generieke gegevens." ;
    skos:definitionSource "GBO, afgeleid van het GGM-wijzigingsvoorstel \"Toestemming en Product\" (generiek gebruik van Toestemming)" ;
    skos:definition_nl "Een door een bestuursorgaan verleende toestemming van een soort waarvoor geen eigen objecttype is uitgewerkt, vastgelegd met uitsluitend de generieke gegevens." ;
    skos:exactMatch gbobegrip:OverigeToestemming,
        gbotm:OverigeToestemming ;
    skos:inScheme gbo:toestemmingen ;
    skos:note "Een bewonersparkeervergunning kan in de pilot zo worden vastgelegd, met producttype \"parkeervergunning\" en kenteken en gebied in omschrijving en locatieOmschrijving.",
        "Het wijzigingsvoorstel gebruikt hiervoor het generieke objecttype Toestemming zelf. Omdat Toestemming in GBO abstract is, zodat het in de GraphQL-projectie een interface wordt waarover alle soorten in een keer opvraagbaar zijn, is een concrete vangnet-klasse nodig. Semantisch is dat hetzelfde: geen eigen attributen, de soort staat in producttype." ;
    skos:prefLabel_nl "Overige toestemming" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-08-21" ;
    mim:elementtype "Objecttype" ;
    mim:herkomst "GBO" ;
    mim:populatie "Alle verleende toestemmingen waarvan de soort geen eigen objecttype heeft, zoals collectevergunning, kampeerontheffing en geluidsontheffing." ;
    mim:uniekeAanduiding "identificatie (geerfd van Toestemming)" .

gbotm:Parkeerontheffing a owl:Class ;
    rdfs:label "Parkeerontheffing" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:tijdvak ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty gbotm:gebied ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:gebied ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty gbotm:soortOntheffing ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty gbotm:soortOntheffing ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:kenteken ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty gbotm:tijdvak ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Kenteken ;
            owl:onProperty gbotm:kenteken ],
        gbotm:Toestemming ;
    skos:definition "Ontheffing van het college van een parkeerverbod, een parkeerschijfzone of een geslotenverklaring voor een bepaald voertuig." ;
    skos:definitionSource "RVV 1990 art. 87; VNG Model-APV art. 5:2-5:8" ;
    skos:definitionSourceUri "https://wetten.overheid.nl/BWBR0004825" ;
    skos:definition_nl "Ontheffing van het college van een parkeerverbod, een parkeerschijfzone (blauwe zone) of een geslotenverklaring voor een bepaald voertuig, bijvoorbeeld voor bewoners van een blauwe zone, voor het voetgangersgebied of voor grote voertuigen." ;
    skos:exactMatch gbobegrip:Parkeerontheffing,
        gbotm:Parkeerontheffing ;
    skos:inScheme gbo:toestemmingen ;
    skos:prefLabel_nl "Parkeerontheffing" ;
    skos:status "proposed" ;
    mim:bevoegdGezag "college van burgemeester en wethouders" ;
    mim:datumOpname "2026-08-21" ;
    mim:elementtype "Objecttype" ;
    mim:herkomst "GGM (wijzigingsvoorstel Toestemming en Product, pilotversie)" ;
    mim:populatie "Alle door het college verleende parkeerontheffingen." ;
    mim:uniekeAanduiding "identificatie (geerfd van Toestemming)" ;
    mim:uniformeProductnaam "parkeerontheffing; parkeerontheffing blauwe zone; parkeerontheffing grote voertuigen" ;
    mim:wettelijkeGrondslag "RVV 1990 art. 87; VNG Model-APV art. 5:2-5:8" .

gbotm:Standplaatsvergunning a owl:Class ;
    rdfs:label "Standplaatsvergunning" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty gbotm:afmetingen ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty gbotm:verkoopwaren ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty gbotm:dagen ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty gbotm:dagen ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbotm:soortstandplaats ;
            owl:onProperty gbotm:soortStandplaats ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:afmetingen ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty gbotm:branche ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:tijdvak ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty gbotm:soortStandplaats ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty gbotm:branche ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty gbotm:tijdvak ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:verkoopwaren ],
        gbotm:Toestemming ;
    skos:definition "Toestemming van het college voor het innemen of hebben van een standplaats: een vaste plaats op of aan de weg of op een andere openbare plaats, buiten een markt, voor het te koop aanbieden, verkopen of afleveren van goederen of het aanbieden van diensten." ;
    skos:definitionSource "VNG Model-APV art. 5:17-5:18" ;
    skos:definitionSourceUri "https://vng.nl/artikelen/model-apv" ;
    skos:definition_nl "Toestemming van het college voor het innemen of hebben van een standplaats, een vaste plaats op of aan de weg of op een andere openbare plaats buiten een markt, voor het te koop aanbieden, verkopen of afleveren van goederen of het aanbieden van diensten." ;
    skos:exactMatch gbobegrip:Standplaatsvergunning,
        gbotm:Standplaatsvergunning ;
    skos:inScheme gbo:toestemmingen ;
    skos:note "De houder is de ondernemer als natuurlijk persoon (eenmanszaak); in het volledige voorstel ook een vestiging. De standplaatslocatie staat in het geerfde locatieOmschrijving en wordt later een verwijzing naar een BAG-standplaats of Locatie." ;
    skos:prefLabel_nl "Standplaatsvergunning" ;
    skos:status "proposed" ;
    mim:bevoegdGezag "college van burgemeester en wethouders" ;
    mim:datumOpname "2026-08-21" ;
    mim:elementtype "Objecttype" ;
    mim:herkomst "GGM (wijzigingsvoorstel Toestemming en Product, pilotversie)" ;
    mim:populatie "Alle door het college verleende standplaatsvergunningen." ;
    mim:uniekeAanduiding "identificatie (geerfd van Toestemming)" ;
    mim:uniformeProductnaam "standplaatsvergunning" ;
    mim:wettelijkeGrondslag "VNG Model-APV art. 5:18" .

