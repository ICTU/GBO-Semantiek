    rdfs:label "Maatwerkvoorschrift" ;
    rdfs:subClassOf gbotm:soorttoestemming ;
    skos:definition "Op het individuele geval toegesneden voorschrift dat afwijkt van of aanvult op een algemene regel." .

<https://lod.gbo-semantiek.nl/toestemmingen/soorttoestemming#Ontheffing> a owl:Class ;
    rdfs:label "Ontheffing" ;
    rdfs:subClassOf gbotm:soorttoestemming ;
    skos:definition "Individuele uitzondering op een algemeen verbod, voor een bepaald geval." .

<https://lod.gbo-semantiek.nl/toestemmingen/soorttoestemming#Vergunning> a owl:Class ;
    rdfs:label "Vergunning" ;
    rdfs:subClassOf gbotm:soorttoestemming ;
    skos:definition "Toestemming binnen een verbod-behoudens-vergunningstelsel: de activiteit is verboden tenzij zij is vergund." .

<https://lod.gbo-semantiek.nl/toestemmingen/soorttoestemming#Vrijstelling> a owl:Class ;
    rdfs:label "Vrijstelling" ;
    rdfs:subClassOf gbotm:soorttoestemming ;
    skos:definition "Uitzondering op een verbod voor een categorie gevallen, bij algemeen voorschrift." .

gbotm:standplaatsnummer a owl:DatatypeProperty ;
    rdfs:label "standplaatsnummer" ;
    skos:definition "Nummer van de standplaats op de markt." ;
    skos:inScheme gbo:toestemmingen ;
    mim:lengte 10 .

gbotm:stickernummer a owl:DatatypeProperty ;
    rdfs:label "stickernummer" ;
    skos:definition "Nummer van de afgegeven sticker of het vignet." ;
    skos:inScheme gbo:toestemmingen ;
    skos:note "Bestaand GGM-attribuut; in de pilotversie optioneel geworden." .

gbotm:tijdvakPerDag a owl:DatatypeProperty ;
    rdfs:label "tijdvakPerDag" ;
    skos:definition "Tijden waarbinnen het evenement per dag mag plaatsvinden, bijvoorbeeld \"12:00-23:00; zondag tot 20:00\"." ;
    skos:inScheme gbo:toestemmingen ;
    mim:lengte 80 .

gbotm:verkoopwaren a owl:DatatypeProperty ;
    rdfs:label "verkoopwaren" ;
    skos:definition "Nadere omschrijving van de goederen of diensten die mogen worden aangeboden." ;
    skos:inScheme gbo:toestemmingen ;
    mim:lengte 200 .

gbotm:versterktGeluid a owl:ObjectProperty ;
    rdfs:label "versterktGeluid" ;
    skos:definition "Indicatie dat gebruik van geluidsversterking is toegestaan." ;
    skos:inScheme gbo:toestemmingen .

gbotm:voorschriften a owl:DatatypeProperty ;
    rdfs:label "voorschriften" ;
    skos:definition "Aan de toestemming verbonden voorschriften en beperkingen, als tekst." ;
    skos:inScheme gbo:toestemmingen ;
    skos:note "In het volledige voorstel een compositie van het objecttype Voorschrift; in de pilot bewust een tekstveld." .

gbotm:zaak a owl:DatatypeProperty ;
    rdfs:label "zaak" ;
    skos:definition "Identificatie van de zaak waarin de toestemming is aangevraagd en verleend." ;
    skos:inScheme gbo:toestemmingen ;
    skos:note "Pilot: tekstveld in plaats van de relatie \"is ontstaan uit\"." ;
    mim:herkomst "RGBZ (Zaak.identificatie)" .

gbotm:betreft a owl:ObjectProperty ;
    rdfs:label "betreft" ;
    skos:definition "Het evenement waarvoor de vergunning is verleend.",
        "Het vaartuig waarvoor de ontheffing is verleend." ;
    skos:inScheme gbo:toestemmingen ;
    gbo:inverseNaam "heeftEvenementenvergunning",
        "heeftLigplaatsontheffing" .

gbotm:branche a owl:DatatypeProperty ;
    rdfs:label "branche" ;
    skos:definition "Branche of artikelgroep, bijvoorbeeld groente en fruit, kaas of textiel.",
        "Branche of productgroep van de standplaats, bijvoorbeeld vis, bloemen, oliebollen, ijs, snacks of kerstbomen." ;
    skos:inScheme gbo:toestemmingen ;
    mim:lengte 80 .

gbotm:dagen a owl:DatatypeProperty ;
    rdfs:label "dagen" ;
    skos:definition "Dag of dagen van de week waarop de standplaats mag worden ingenomen.",
        "Dag of dagen van de week, of data, waarop mag worden opgetreden." ;
    skos:inScheme gbo:toestemmingen ;
    mim:lengte 80 .

gbotm:datumEinde a owl:DatatypeProperty ;
    rdfs:label "datumEinde" ;
    skos:definition "Datum waarop de activiteit eindigt.",
        "Datum waarop de geldigheid eindigt; afwezig betekent onbepaalde tijd." ;
    skos:inScheme gbo:toestemmingen .

gbotm:datumStart a owl:DatatypeProperty ;
    rdfs:label "datumStart" ;
    skos:definition "Datum waarop de activiteit begint.",
        "Datum waarop de toestemming ingaat." ;
    skos:inScheme gbo:toestemmingen .

gbotm:locatieOmschrijving a owl:DatatypeProperty ;
    rdfs:label "locatieOmschrijving" ;
    skos:definition "Omschrijving van de locatie of het gebied waarvoor de toestemming geldt: adres, wegvak, gebied, standplaats of ligplaats.",
        "Omschrijving van de locatie van de activiteit." ;
    skos:inScheme gbo:toestemmingen ;
    mim:lengte 300 .

gbotm:soortgehandicaptenparkeerkaart a owl:Class ;
    rdfs:label "SoortGehandicaptenparkeerkaart" ;
    owl:unionOf ( <https://lod.gbo-semantiek.nl/toestemmingen/soortgehandicaptenparkeerkaart#Bestuurder> <https://lod.gbo-semantiek.nl/toestemmingen/soortgehandicaptenparkeerkaart#Passagier> <https://lod.gbo-semantiek.nl/toestemmingen/soortgehandicaptenparkeerkaart#Instelling> ) ;
    skos:definition "De soort gehandicaptenparkeerkaart naar de hoedanigheid van de houder." ;
    skos:definitionSource "GGM-wijzigingsvoorstel \"Toestemming en Product\", bijlage A; Regeling gehandicaptenparkeerkaart" ;
    skos:definition_nl "De soort gehandicaptenparkeerkaart naar de hoedanigheid van de houder." ;
    skos:exactMatch gbobegrip:SoortGehandicaptenparkeerkaart ;
    skos:inScheme gbo:toestemmingen ;
    skos:prefLabel_nl "Soort gehandicaptenparkeerkaart" ;
    skos:status "proposed" ;
    mim:herkomst "BABW art. 49-55; Regeling gehandicaptenparkeerkaart" ;
    linkml:permissible_values <https://lod.gbo-semantiek.nl/toestemmingen/soortgehandicaptenparkeerkaart#Bestuurder>,
        <https://lod.gbo-semantiek.nl/toestemmingen/soortgehandicaptenparkeerkaart#Instelling>,
        <https://lod.gbo-semantiek.nl/toestemmingen/soortgehandicaptenparkeerkaart#Passagier> .

gbotm:soortmarktplaats a owl:Class ;
    rdfs:label "SoortMarktplaats" ;
    owl:unionOf ( <https://lod.gbo-semantiek.nl/toestemmingen/soortmarktplaats#VasteStandplaats> <https://lod.gbo-semantiek.nl/toestemmingen/soortmarktplaats#Dagplaats> <https://lod.gbo-semantiek.nl/toestemmingen/soortmarktplaats#Standwerkersplaats> ) ;
    skos:definition "De soort plaats op een warenmarkt waarvoor de vergunning geldt." ;
    skos:definitionSource "GGM-wijzigingsvoorstel \"Toestemming en Product\", bijlage A; VNG Model Marktverordening" ;
    skos:definition_nl "De soort plaats op een warenmarkt waarvoor de marktvergunning geldt." ;
    skos:exactMatch gbobegrip:SoortMarktplaats ;
    skos:inScheme gbo:toestemmingen ;
    skos:prefLabel_nl "Soort marktplaats" ;
    skos:status "proposed" ;
    mim:herkomst "VNG Model Marktverordening" ;
    linkml:permissible_values <https://lod.gbo-semantiek.nl/toestemmingen/soortmarktplaats#Dagplaats>,
        <https://lod.gbo-semantiek.nl/toestemmingen/soortmarktplaats#Standwerkersplaats>,
        <https://lod.gbo-semantiek.nl/toestemmingen/soortmarktplaats#VasteStandplaats> .

gbotm:soortstandplaats a owl:Class ;
    rdfs:label "SoortStandplaats" ;
    owl:unionOf ( <https://lod.gbo-semantiek.nl/toestemmingen/soortstandplaats#Vast> <https://lod.gbo-semantiek.nl/toestemmingen/soortstandplaats#Seizoensgebonden> <https://lod.gbo-semantiek.nl/toestemmingen/soortstandplaats#Incidenteel> ) ;
    skos:definition "De soort standplaats naar de tijdsduur waarvoor zij geldt." ;
    skos:definitionSource "GGM-wijzigingsvoorstel \"Toestemming en Product\", bijlage A; VNG Model-APV art. 5:17-5:18" ;
    skos:definition_nl "De soort standplaats naar de tijdsduur waarvoor zij geldt." ;
    skos:exactMatch gbobegrip:SoortStandplaats ;
    skos:inScheme gbo:toestemmingen ;
    skos:prefLabel_nl "Soort standplaats" ;
    skos:status "proposed" ;
    mim:herkomst "VNG Model-APV art. 5:17-5:18" ;
    linkml:permissible_values <https://lod.gbo-semantiek.nl/toestemmingen/soortstandplaats#Incidenteel>,
        <https://lod.gbo-semantiek.nl/toestemmingen/soortstandplaats#Seizoensgebonden>,
        <https://lod.gbo-semantiek.nl/toestemmingen/soortstandplaats#Vast> .

gbotm:status a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "status" ;
    skos:definition "Status in de levensloop van de toestemming.",
        "Status van de activiteit." ;
    skos:inScheme gbo:toestemmingen ;
    mim:lengte 40 .

gbotm:tijdvak a owl:DatatypeProperty ;
    rdfs:label "tijdvak" ;
    skos:definition "Tijden waarbinnen de standplaats mag worden ingenomen.",
        "Tijden waarbinnen mag worden opgetreden.",
        "Tijden, in dagen of uren, waarop de ontheffing geldt." ;
    skos:inScheme gbo:toestemmingen ;
    mim:lengte 40 .

gbotm:productstatus a owl:Class ;
    rdfs:label "Productstatus" ;
    owl:unionOf ( <https://lod.gbo-semantiek.nl/toestemmingen/productstatus#Initieel> <https://lod.gbo-semantiek.nl/toestemmingen/productstatus#InAanvraag> <https://lod.gbo-semantiek.nl/toestemmingen/productstatus#Gereed> <https://lod.gbo-semantiek.nl/toestemmingen/productstatus#Actief> <https://lod.gbo-semantiek.nl/toestemmingen/productstatus#Ingetrokken> <https://lod.gbo-semantiek.nl/toestemmingen/productstatus#Geweigerd> <https://lod.gbo-semantiek.nl/toestemmingen/productstatus#Verlopen> ) ;
    skos:definition "De status van een toestemming in haar levensloop, van aanvraag tot einde." ;
    skos:definitionSource "GGM-wijzigingsvoorstel \"Toestemming en Product\", bijlage A; waarden afgestemd op Open Product" ;
    skos:definition_nl "De status van een toestemming in haar levensloop, van aanvraag tot einde." ;
    skos:exactMatch gbobegrip:Productstatus ;
    skos:inScheme gbo:toestemmingen ;
    skos:note "De waarden zijn letterlijk afgestemd op Open Product, zodat een registratie in Open Product of de Objecten API dezelfde levensloop kent." ;
    skos:prefLabel_nl "Productstatus" ;
    skos:status "proposed" ;
    mim:herkomst "Open Product (statuswaarden)" ;
    linkml:permissible_values <https://lod.gbo-semantiek.nl/toestemmingen/productstatus#Actief>,
        <https://lod.gbo-semantiek.nl/toestemmingen/productstatus#Gereed>,
        <https://lod.gbo-semantiek.nl/toestemmingen/productstatus#Geweigerd>,
        <https://lod.gbo-semantiek.nl/toestemmingen/productstatus#InAanvraag>,
        <https://lod.gbo-semantiek.nl/toestemmingen/productstatus#Ingetrokken>,
        <https://lod.gbo-semantiek.nl/toestemmingen/productstatus#Initieel>,
        <https://lod.gbo-semantiek.nl/toestemmingen/productstatus#Verlopen> .

gbotm:soorttoestemming a owl:Class ;
    rdfs:label "SoortToestemming" ;
    owl:unionOf ( <https://lod.gbo-semantiek.nl/toestemmingen/soorttoestemming#Vergunning> <https://lod.gbo-semantiek.nl/toestemmingen/soorttoestemming#Ontheffing> <https://lod.gbo-semantiek.nl/toestemmingen/soorttoestemming#Vrijstelling> <https://lod.gbo-semantiek.nl/toestemmingen/soorttoestemming#InstemmingMetMelding> <https://lod.gbo-semantiek.nl/toestemmingen/soorttoestemming#Maatwerkvoorschrift> <https://lod.gbo-semantiek.nl/toestemmingen/soorttoestemming#Gedoogbeschikking> <https://lod.gbo-semantiek.nl/toestemmingen/soorttoestemming#ErkenningOfRegistratie> ) ;
    skos:definition "De juridische soort van een toestemming: de vorm waarin het bestuursorgaan haar verleent." ;
    skos:definitionSource "GGM-wijzigingsvoorstel \"Toestemming en Product\", bijlage A; RIHa 2.0" ;
    skos:definition_nl "De juridische soort van een toestemming, oftewel de vorm waarin het bestuursorgaan haar verleent." ;
    skos:exactMatch gbobegrip:SoortToestemming ;
    skos:inScheme gbo:toestemmingen ;
    skos:note "In het volledige voorstel is dit een kenmerk van het producttype; in de pilot staat het op Toestemming zelf." ;
    skos:prefLabel_nl "Soort toestemming" ;
    skos:status "proposed" ;
    mim:herkomst "GGM (wijzigingsvoorstel Toestemming en Product, pilotversie)" ;
    linkml:permissible_values <https://lod.gbo-semantiek.nl/toestemmingen/soorttoestemming#ErkenningOfRegistratie>,
        <https://lod.gbo-semantiek.nl/toestemmingen/soorttoestemming#Gedoogbeschikking>,
        <https://lod.gbo-semantiek.nl/toestemmingen/soorttoestemming#InstemmingMetMelding>,
        <https://lod.gbo-semantiek.nl/toestemmingen/soorttoestemming#Maatwerkvoorschrift>,
        <https://lod.gbo-semantiek.nl/toestemmingen/soorttoestemming#Ontheffing>,
        <https://lod.gbo-semantiek.nl/toestemmingen/soorttoestemming#Vergunning>,
        <https://lod.gbo-semantiek.nl/toestemmingen/soorttoestemming#Vrijstelling> .

gbotm:Toestemming a owl:Class ;
    rdfs:label "Toestemming" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:locatieOmschrijving ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty gbotm:locatieOmschrijving ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty gbotm:datumEinde ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbotm:productstatus ;
            owl:onProperty gbotm:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:NatuurlijkPersoon ;
            owl:onProperty gbotm:houder ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty gbotm:omschrijving ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty gbotm:producttype ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Identificatie ;
            owl:onProperty gbotm:besluit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:soortToestemming ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty gbotm:producttype ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:zaak ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty gbotm:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Identificatie ;
            owl:onProperty gbotm:zaak ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty gbotm:voorschriften ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty gbotm:identificatie ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:voorschriften ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gbotm:besluit ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Identificatie ;
            owl:onProperty gbotm:document ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Identificatie ;
            owl:onProperty gbotm:identificatie ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty gbotm:datumStart ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty gbotm:omschrijving ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty gbotm:houder ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:datumEinde ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbotm:soorttoestemming ;
            owl:onProperty gbotm:soortToestemming ],
        [ owl:unionOf ( gbotm:Evenementenvergunning gbotm:Gehandicaptenparkeerkaart gbotm:Ligplaatsontheffing gbotm:Marktvergunning gbotm:OverigeToestemming gbotm:Parkeerontheffing gbotm:Standplaatsvergunning gbotm:Straatartiestenontheffing ) ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:datumStart ] ;
    skos:altLabel_nl_0_source "GGM-wijzigingsvoorstel \"Toestemming en Product\" (klassenaam)" ;
    skos:altLabel_nl_0_value "Toestemming" ;
    skos:altLabel_nl_1_source "VNG Model-APV" ;
    skos:altLabel_nl_1_value "Vergunning" ;
    skos:altLabel_nl_2_source "VNG Model-APV" ;
    skos:altLabel_nl_2_value "Ontheffing" ;
    skos:definition "Een door een bestuursorgaan aan een houder verleende toestemming om een activiteit te verrichten of een situatie in stand te houden die zonder die toestemming niet is toegestaan." ;
    skos:definitionSource "RIHa 2.0, begrip TOESTEMMING; Awb art. 1:3 (beschikking)" ;
    skos:definitionSourceUri "https://wetten.overheid.nl/BWBR0005537" ;
    skos:definition_nl "Een door een bestuursorgaan aan een houder verleende toestemming om een activiteit te verrichten of een situatie in stand te houden die zonder die toestemming niet is toegestaan (vergunning, ontheffing, vrijstelling, instemming met een melding, maatwerkvoorschrift, gedoogbeschikking)." ;
    skos:exactMatch gbobegrip:BestuurlijkeToestemming,
        gbotm:Toestemming ;
    skos:inScheme gbo:toestemmingen ;
    skos:needsReview_0 "Begrip-URI BestuurlijkeToestemming gekozen omdat het voorzieningenmodel gbobegrip:Toestemming al gebruikt voor de AVG-toestemming om gegevens te delen. Bij vaststelling van het begrippenkader controleren of deze twee begrippen zo onderscheidend genoeg zijn." ;
    skos:needsReview_1 "Verhouding tot RIHa 2.0 TOESTEMMING nog niet als exactMatch of closeMatch vastgelegd; RIHa-URI ontbreekt." ;
    skos:note "Het besluit blijft de juridische handeling; de toestemming is het resultaat. De toestemming ontstaat door een besluit in een zaak, heeft daarna een eigen levensloop (actief, verlopen, ingetrokken) en kan door latere besluiten worden gewijzigd of ingetrokken.",
        "Toestemming is abstract: elke toestemming is er een van een bepaalde soort. Vergunningsoorten zonder eigen klasse (collectevergunning, kampeerontheffing, geluidsontheffing) worden als OverigeToestemming vastgelegd, met de soort in het tekstveld producttype. Zo blijft het supertype in de GraphQL-projectie een interface, waarover de afnemer alle soorten in een keer opvraagt.",
        "Vergunning en ontheffing zijn allebei beschikkingen (Awb art. 1:3) en verschillen in normstructuur (\"verbod behoudens vergunning\" tegenover \"algemeen verbod met individuele uitzondering\"), niet in gegevens. Daarom een generiek objecttype met de juridische soort als kenmerk, en niet een klasse per juridische vorm." ;
    skos:prefLabel_nl "Bestuurlijke toestemming" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-08-21" ;
    mim:elementtype "Objecttype" ;
    mim:herkomst "GGM (wijzigingsvoorstel Toestemming en Product, pilotversie)" ;
    mim:herkomstDefinitie "Bron: GGM-wijzigingsvoorstel \"Toestemming en Product\", pilotversie 2 (concept), hoofdstuk 3.1 en bijlage A. Onderliggend RIHa 2.0 (begrip TOESTEMMING) en Awb art. 1:3." ;
    mim:populatie "Alle door een gemeentelijk bestuursorgaan verleende toestemmingen die als eigen registratie worden bijgehouden, ongeacht of zij nog geldig zijn." ;
    mim:uniekeAanduiding "identificatie" .

