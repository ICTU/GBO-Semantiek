gbotm:Vaartuig a owl:Class ;
    rdfs:label "Vaartuig" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty gbotm:naamVaartuig ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:hoogte ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:breedte ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:kleur ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Identificatie ;
            owl:onProperty gbotm:registratienummer ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty gbotm:kleur ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:naamVaartuig ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Decimaal ;
            owl:onProperty gbotm:breedte ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:registratienummer ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gbotm:lengte ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Decimaal ;
            owl:onProperty gbotm:lengte ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Decimaal ;
            owl:onProperty gbotm:hoogte ] ;
    skos:definition "Een vaartuig waarmee een ligplaats wordt ingenomen, met de kenmerken waarmee het op het water herkenbaar is." ;
    skos:definitionSource "GGM Model VTH (bestaande klasse Vaartuig)" ;
    skos:definition_nl "Een vaartuig waarmee een ligplaats wordt ingenomen, met de kenmerken waarmee het op het water herkenbaar is: naam, registratienummer, kleur en afmetingen." ;
    skos:exactMatch gbobegrip:Vaartuig,
        gbotm:Vaartuig ;
    skos:inScheme gbo:toestemmingen ;
    skos:needsReview_0 "Het kernmodel kent alleen Voertuig (BRV/RDW); voor vaartuigen bestaat geen landelijke basisregistratie. Bij vaststelling controleren of aansluiting op een register (bijvoorbeeld het scheepsregister van het Kadaster) mogelijk is." ;
    skos:note "Bestaande GGM-klasse in Model VTH. Anders dan Voertuig in het kernmodel is een vaartuig niet aan een landelijke registratie ontleend; de gegevens komen uit de aanvraag." ;
    skos:prefLabel_nl "Vaartuig" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-08-21" ;
    mim:elementtype "Objecttype" ;
    mim:herkomst "GGM Model VTH (bestaande klasse)" ;
    mim:populatie "Alle vaartuigen waarvoor de gemeente een ligplaatsontheffing heeft verleend." .

gbotm:aantalPersonen a owl:DatatypeProperty ;
    rdfs:label "aantalPersonen" ;
    skos:definition "Aantal personen dat gezamenlijk optreedt." ;
    skos:inScheme gbo:toestemmingen ;
    mim:lengte 2 .

gbotm:afbouwTot a owl:DatatypeProperty ;
    rdfs:label "afbouwTot" ;
    skos:definition "Tijdstip waarop de afbouw gereed moet zijn en de locatie is opgeleverd." ;
    skos:inScheme gbo:toestemmingen .

gbotm:afmetingen a owl:DatatypeProperty ;
    rdfs:label "afmetingen" ;
    skos:definition "Toegestane afmetingen van de verkoopinrichting: lengte, breedte en hoogte in meters." ;
    skos:inScheme gbo:toestemmingen ;
    mim:lengte 40 .

gbotm:alcoholverstrekking a owl:ObjectProperty ;
    rdfs:label "alcoholverstrekking" ;
    skos:definition "Indicatie dat zwak-alcoholhoudende drank wordt verstrekt." ;
    skos:inScheme gbo:toestemmingen ;
    skos:note "De bijbehorende ontheffing op grond van Alcoholwet art. 35 wordt vaak gelijktijdig verleend, maar is een eigen toestemming." .

gbotm:besluit a owl:DatatypeProperty ;
    rdfs:label "besluit" ;
    skos:definition "Identificaties van het verleningsbesluit en van latere wijzigings-, verlengings- of intrekkingsbesluiten." ;
    skos:inScheme gbo:toestemmingen ;
    skos:note "Pilot: tekstveld in plaats van de relatie \"is gebaseerd op\"." ;
    mim:herkomst "RGBZ (Besluit.identificatie)" ;
    mim:kardinaliteit "1..*" .

gbotm:breedte a owl:DatatypeProperty ;
    rdfs:label "breedte" ;
    skos:definition "Breedte van het vaartuig in meters." ;
    skos:inScheme gbo:toestemmingen .

gbotm:eindtijdMuziek a owl:DatatypeProperty ;
    rdfs:label "eindtijdMuziek" ;
    skos:definition "Uiterste tijdstip tot wanneer versterkte muziek is toegestaan." ;
    skos:inScheme gbo:toestemmingen .

gbotm:evenementnaam a owl:DatatypeProperty ;
    rdfs:label "evenementnaam" ;
    skos:definition "Naam waaronder de activiteit wordt aangekondigd." ;
    skos:inScheme gbo:toestemmingen ;
    skos:note "Bestaand GGM-attribuut evenmentnaam, in de pilotversie hernoemd." ;
    mim:lengte 80 .

gbotm:frontbreedte a owl:DatatypeProperty ;
    rdfs:label "frontbreedte" ;
    skos:definition "Toegewezen frontbreedte in meters." ;
    skos:inScheme gbo:toestemmingen ;
    mim:lengte 3 .

gbotm:gebied a owl:DatatypeProperty ;
    rdfs:label "gebied" ;
    skos:definition "Zone of gebied waar de ontheffing geldt, bijvoorbeeld blauwe zone centrum." ;
    skos:inScheme gbo:toestemmingen ;
    mim:lengte 100 .

gbotm:hoogte a owl:DatatypeProperty ;
    rdfs:label "hoogte" ;
    skos:definition "Hoogte van het vaartuig in meters." ;
    skos:inScheme gbo:toestemmingen .

gbotm:houder a owl:ObjectProperty ;
    rdfs:label "houder" ;
    skos:definition "De persoon aan wie de toestemming is verleend." ;
    skos:inScheme gbo:toestemmingen ;
    skos:note "Demo-vereenvoudiging: in het wijzigingsvoorstel is de houder een Rechtspersoon (RSGB), dus ook een niet-natuurlijke persoon." ;
    gbo:inverseNaam "heeftToestemming" .

gbotm:identificatie a owl:DatatypeProperty ;
    rdfs:label "identificatie" ;
    skos:definition "Unieke identificatie (kenmerk of vergunningnummer) zoals toegekend door de gemeente." ;
    skos:inScheme gbo:toestemmingen ;
    mim:herkomst "gemeente (vergunningregistratie)" ;
    mim:lengte 50 .

gbotm:kaartnummer a owl:DatatypeProperty ;
    rdfs:label "kaartnummer" ;
    skos:definition "Nummer van de kaart zoals daarop vermeld, uniek per kaart." ;
    skos:inScheme gbo:toestemmingen ;
    mim:lengte 20 .

gbotm:kenteken a owl:DatatypeProperty ;
    rdfs:label "kenteken" ;
    skos:definition "Kenteken van het voertuig waarvoor de ontheffing geldt." ;
    skos:inScheme gbo:toestemmingen ;
    skos:note "Het wijzigingsvoorstel noteert AN12; GBO gebruikt het bestaande datatype Kenteken uit datatypes.yaml." ;
    mim:lengte 8 .

gbotm:kleur a owl:DatatypeProperty ;
    rdfs:label "kleur" ;
    skos:definition "Overheersende kleur van het vaartuig." ;
    skos:inScheme gbo:toestemmingen ;
    mim:lengte 40 .

gbotm:lengte a owl:DatatypeProperty ;
    rdfs:label "lengte" ;
    skos:definition "Lengte van het vaartuig in meters." ;
    skos:inScheme gbo:toestemmingen .

gbotm:ligplaatsaanduiding a owl:DatatypeProperty ;
    rdfs:label "ligplaatsaanduiding" ;
    skos:definition "Nummer of aanduiding van de ligplaats: steiger, kade of nummer." ;
    skos:inScheme gbo:toestemmingen ;
    mim:lengte 40 .

gbotm:markt a owl:DatatypeProperty ;
    rdfs:label "markt" ;
    skos:definition "Naam of aanduiding van de markt, bijvoorbeeld \"Algemene warenmarkt Markt (donderdag)\"." ;
    skos:inScheme gbo:toestemmingen ;
    mim:lengte 80 .

gbotm:marktdagen a owl:DatatypeProperty ;
    rdfs:label "marktdagen" ;
    skos:definition "Dag of dagen van de week waarop de vergunning geldt." ;
    skos:inScheme gbo:toestemmingen ;
    mim:lengte 80 .

gbotm:maximaalAantalBezoekers a owl:DatatypeProperty ;
    rdfs:label "maximaalAantalBezoekers" ;
    skos:definition "Maximaal toegestaan aantal gelijktijdig aanwezige bezoekers." ;
    skos:inScheme gbo:toestemmingen ;
    mim:lengte 6 .

gbotm:naamVaartuig a owl:DatatypeProperty ;
    rdfs:label "naamVaartuig" ;
    skos:definition "Naam van het vaartuig." ;
    skos:inScheme gbo:toestemmingen ;
    mim:lengte 80 .

gbotm:omschrijving a owl:DatatypeProperty ;
    rdfs:label "omschrijving" ;
    skos:definition "Omschrijving van de toegestane activiteit of het toegestane gebruik, zoals in het besluit verwoord." ;
    skos:inScheme gbo:toestemmingen .

gbotm:opbouwVanaf a owl:DatatypeProperty ;
    rdfs:label "opbouwVanaf" ;
    skos:definition "Tijdstip vanaf wanneer de opbouw is toegestaan." ;
    skos:inScheme gbo:toestemmingen .

gbotm:organisator a owl:ObjectProperty ;
    rdfs:label "organisator" ;
    skos:definition "De persoon die de activiteit organiseert." ;
    skos:inScheme gbo:toestemmingen ;
    skos:note "Nieuw in de pilotversie. Demo-vereenvoudiging: in het wijzigingsvoorstel een Rechtspersoon (RSGB)." ;
    gbo:inverseNaam "organiseert" .

<https://lod.gbo-semantiek.nl/toestemmingen/productstatus#Actief> a owl:Class ;
    rdfs:label "Actief" ;
    rdfs:subClassOf gbotm:productstatus ;
    skos:definition "Verleend en geldig." .

