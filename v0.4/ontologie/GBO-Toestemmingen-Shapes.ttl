    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tijden waarbinnen het evenement per dag mag plaatsvinden, bijvoorbeeld \"12:00-23:00; zondag tot 20:00\"." ;
