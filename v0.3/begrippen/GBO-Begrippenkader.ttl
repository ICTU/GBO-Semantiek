    skos:prefLabel "Kindgebonden budget"@nl ;
    adms:status "proposed" .

gbobegrip:KortKrediet a skos:Concept ;
    dcterms:source <https://www.bkr.nl/media/4dyezfiz/algemeen-reglement-cki-juli-2024.pdf>,
        "Algemeen Reglement CKI 2024-07-01 art. 26" ;
