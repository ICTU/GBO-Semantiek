    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Module inschrijving"@nl ;
    adms:status "proposed" .

gbobegrip:NatuurlijkPersoon a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0002656>,
        "Burgerlijk Wetboek art. 1:1 BW" ;
    skos:altLabel "Mens"@nl,
        "Persoon"@nl ;
    skos:definition "Een mens als drager van burgerlijke rechten en plichten."@nl ;
