@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix gbobegrip: <https://begrippen.gbo-semantiek.nl/id/begrip/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

gbobegrip:AangifteErf a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0002226>,
        "Successiewet 1956 jo. SBR-NT NT20 extensie" ;
    skos:definition "De aangifte erfbelasting waarin de nalatenschap van een overledene en de verdeling daarvan over de erfgenamen wordt opgegeven."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Aangifte erfbelasting"@nl ;
    adms:status "proposed" .

gbobegrip:AangifteIH a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0011353>,
        "Wet IB 2001 jo. SBR-NT NT20" ;
    skos:altLabel "IB-aangifte"@nl,
        "IH 2025"@nl ;
    skos:definition "De jaaraangifte inkomstenbelasting van een natuurlijk persoon waarin het verzamelinkomen over een belastingjaar wordt opgegeven."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Aangifte inkomstenbelasting"@nl ;
    adms:status "proposed" .

gbobegrip:AangifteSchenk a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0002226>,
        "Successiewet 1956 jo. SBR-NT NT20 extensie" ;
    skos:definition "De aangifte schenkbelasting waarin een schenking met haar fiscale waarde, betrokken personen, vrijstellingen en eventuele schenking-op-papier-constructie wordt opgegeven."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Aangifte schenkbelasting"@nl ;
    adms:status "proposed" .

gbobegrip:AchterstandRegistratie a skos:Concept ;
    dcterms:source <https://www.bkr.nl/media/4dyezfiz/algemeen-reglement-cki-juli-2024.pdf>,
        "Algemeen Reglement CKI 2024-07-01 art. 12 lid 1-2" ;
    skos:altLabel "A-codering"@nl ;
    skos:definition "Een melding aan het Centraal Krediet Informatiesysteem dat een kredietnemer een achterstand heeft opgelopen in de nakoming van zijn verplichtingen onder een specifieke kredietovereenkomst."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Achterstand registratie"@nl ;
    adms:status "proposed" .

gbobegrip:AflopendKrediet a skos:Concept ;
    dcterms:source <https://www.bkr.nl/media/4dyezfiz/algemeen-reglement-cki-juli-2024.pdf>,
        "Algemeen Reglement CKI 2024-07-01 art. 16" ;
    skos:altLabel "Persoonlijke lening"@nl ;
    skos:definition "Een kredietovereenkomst met een vooraf vastgesteld kredietbedrag, een vaste looptijd en periodieke aflossingen die het krediet stapsgewijs verminderen tot nul aan het einde van de looptijd."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Aflopend krediet"@nl ;
    adms:status "proposed" .

gbobegrip:Aftrekpost a skos:Concept ;
    dcterms:source "Wet IB 2001 hoofdstuk 6 jo. SBR-NT NT20" ;
    skos:definition "Een door de belastingplichtige in de IH-aangifte op te voeren betaalde uitgave die op grond van Wet IB 2001 het belastbaar inkomen verlaagt."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Aftrekpost"@nl ;
    adms:status "proposed" .

gbobegrip:AlimentatieAftrek a skos:Concept ;
    dcterms:source "Wet IB 2001 art. 6.3" ;
    skos:altLabel "Partneralimentatie betaald"@nl ;
    skos:definition "De op grond van Wet IB 2001 art. 6.3 aftrekbare partneralimentatie die de belastingplichtige in een belastingjaar aan een gewezen partner heeft betaald."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Alimentatie aftrek"@nl ;
    adms:status "proposed" .

gbobegrip:Arbeidsongeschiktheidspercentage a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0011478>,
        "Schattingsbesluit arbeidsongeschiktheidswetten" ;
    skos:altLabel "AO-percentage"@nl ;
    skos:definition "Het door een verzekeringsarts en arbeidsdeskundige vastgestelde percentage waarmee de verdiencapaciteit van een werknemer ten opzichte van zijn oude loon is verminderd."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Arbeidsongeschiktheidspercentage"@nl ;
    adms:status "proposed" .

gbobegrip:Arbeidsverhouding a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0005290>,
        "BW Boek 7 titel 10; SGR-cluster Arbeidsverhouding" ;
    skos:altLabel "Arbeidsrelatie"@nl,
        "Dienstverband"@nl ;
    skos:definition "De juridische en feitelijke relatie tussen een natuurlijk persoon als werknemer en een werkgever op grond waarvan arbeid wordt verricht tegen beloning."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Arbeidsverhouding"@nl ;
    adms:status "proposed" .

gbobegrip:ArbeidsverledenFeit a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0004045>,
        "Werkloosheidswet jo. SGR-cluster Arbeidsverhouding" ;
    skos:altLabel "Loonhistorie-element"@nl ;
    skos:definition "Een afzonderlijk feit in het arbeids- of inkomensverleden van een natuurlijk persoon dat relevant is voor de berekening van werknemersverzekerings-rechten."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Arbeidsverleden feit"@nl ;
    adms:status "proposed" .

gbobegrip:Attestatie a skos:Concept ;
    dcterms:source "eIDAS2 (verordening (EU) 2024/1183) en het Architecture and Reference Framework" ;
    skos:definition "Levering als gekwalificeerde verklaring die in een EUDI-wallet kan worden opgeslagen en later zelfstandig verifieerbaar is."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Attestatie"@nl ;
    adms:status "proposed" .

gbobegrip:Attestatiesoort a skos:Concept ;
    dcterms:source "eIDAS2 (verordening (EU) 2024/1183) en het Architecture and Reference Framework" ;
    skos:definition "De twee manieren waarop een attestatie onder eIDAS2 gekwalificeerd kan worden."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Attestatiesoort"@nl ;
    adms:status "proposed" .

gbobegrip:BankSpaartegoed a skos:Concept ;
    dcterms:source "Wet IB 2001 art. 5.3 jo. SBR-NT NT20" ;
    skos:definition "Een bank- of spaartegoed dat een natuurlijk persoon op de peildatum 1 januari aanhoudt bij een Nederlandse of buitenlandse financiele instelling en dat in Box 3 wordt opgegeven."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Bank spaartegoed"@nl ;
    adms:status "proposed" .

gbobegrip:BelastingAangifte a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0002320>,
        "GBO-Kern, afgeleid uit AWR art. 6-9" ;
    skos:altLabel "Aangifte"@nl ;
    skos:definition "Een door of namens een belastingplichtige aan de Belastingdienst ingediende opgave waarmee de grondslag voor een specifieke belastingsoort en periode wordt vastgesteld."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Belasting aangifte"@nl ;
    adms:status "proposed" .

gbobegrip:BelastingjaarAangifte a skos:Concept ;
    dcterms:source "GBO-Kern, afgeleid uit AWR en SBR-NT NT20" ;
    skos:definition "Een belastingaangifte die op een specifiek belastingjaar betrekking heeft en die de grondslag voor de aanslag over dat jaar vaststelt."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Belastingjaar aangifte"@nl ;
    adms:status "proposed" .

gbobegrip:Belegging a skos:Concept ;
    dcterms:source "Wet IB 2001 art. 5.3 jo. SBR-NT NT20" ;
    skos:definition "Een in Box 3 op te geven vermogensbestanddeel dat bestaat uit aandelen, obligaties, beleggingsfondsen, derivaten of vergelijkbare effecten."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Belegging"@nl ;
    adms:status "proposed" .

gbobegrip:BeroepspraktijkvormingPeriode a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0007625>,
        "GBO-Kern, afgeleid uit WEB art. 7.2.8 en art. 7.2.9" ;
    skos:altLabel "Work-based learning period"@en,
        "BPV-periode"@nl,
        "Stageperiode"@nl ;
    skos:definition "Een afgebakende periode waarin een MBO-student bij een erkend leerbedrijf het beroepspraktijkvorming-deel van een MBO-opleiding doorloopt."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Beroepspraktijkvorming periode"@nl ;
    adms:status "proposed" .

gbobegrip:Beslissing a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0005537>,
        "Wet SUWI jo. Algemene wet bestuursrecht" ;
    skos:altLabel "Beschikking"@nl ;
    skos:definition "Een door een uitvoerings-instelling in het SUWI-stelsel genomen besluit over het recht op, de hoogte van of de beeindiging van een uitkering of een andere voorziening voor een natuurlijk persoon."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Beslissing"@nl ;
    adms:status "proposed" .

gbobegrip:Betrokkene a skos:Concept ;
    dcterms:source "GBO (voorstel); term ontleend aan de AVG, waar de betrokkene degene is op wie persoonsgegevens betrekking hebben" ;
    skos:definition "De natuurlijke persoon om wiens gegevens het in een gegevensverzoek gaat."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Betrokkene"@nl ;
    adms:status "proposed" .

gbobegrip:BijzonderheidsCodering a skos:Concept ;
    dcterms:source <https://www.bkr.nl/media/4dyezfiz/algemeen-reglement-cki-juli-2024.pdf>,
        "Algemeen Reglement CKI 2024-07-01 art. 13" ;
    skos:altLabel "B-codering"@nl ;
    skos:definition "Een melding aan het Centraal Krediet Informatiesysteem dat een specifieke bijzonderheid is opgetreden bij de afhandeling van een kredietovereenkomst."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Bijzonderheids codering"@nl ;
    adms:status "proposed" .

gbobegrip:BorgstellingRol a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0005290>,
        "Algemeen Reglement CKI 2024-07-01 art. 1; BW 7:850" ;
    skos:altLabel "Borg"@nl ;
    skos:definition "De rol van een natuurlijk persoon die zich heeft verbonden tot het voldoen van de verplichtingen van een kredietnemer onder een specifieke kredietovereenkomst indien de kredietnemer zelf in gebreke blijft."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Borgstelling rol"@nl ;
    adms:status "proposed" .

gbobegrip:Bron a skos:Concept ;
    dcterms:source "GBO PSA" ;
    skos:definition "Een registratie of gegevensverzameling bij een bronhouder, met een wettelijke grondslag."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Bron"@nl ;
    adms:status "proposed" .

gbobegrip:BuitenlandseBetrokkene a skos:Concept ;
    dcterms:source "GBO (voorstel), afgeleid uit de SDG-verordening en het OOTS-identity-matching-patroon" ;
    skos:definition "De persoon om wiens gegevens het gaat en die door een EU-overheidsdienst is geidentificeerd, zonder dat een burgerservicenummer beschikbaar hoeft te zijn."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Buitenlandse betrokkene"@nl ;
    adms:status "proposed" .

gbobegrip:Burger a skos:Concept ;
    dcterms:source "GBO PSA" ;
    skos:definition "De persoon om wiens gegevens het gaat en die deze wil gebruiken om een dienst af te nemen; in de Nederlandse context altijd identificeerbaar met een burgerservicenummer."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Burger"@nl ;
    adms:status "proposed" .

gbobegrip:Cryptovaluta a skos:Concept ;
    dcterms:source "Wet IB 2001 art. 5.3 jo. SBR-NT NT20" ;
    skos:definition "Een in Box 3 op te geven vermogensbestanddeel dat bestaat uit een digitale valuta of cryptotegoed, vastgesteld op marktwaarde per peildatum 1 januari."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Cryptovaluta"@nl ;
    adms:status "proposed" .

gbobegrip:Dagloon a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0034857>,
        "Dagloonregels werknemersverzekeringen 2015" ;
    skos:altLabel "Uitkeringsdagloon"@nl ;
    skos:definition "Het op grond van de Dagloonregels werknemersverzekeringen voor een specifieke uitkering vastgestelde dagloon, dat dient als grondslag voor de hoogte van de uitkering en wordt berekend op basis van de inkomstenopgaven over de referteperiode."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Dagloon"@nl ;
    adms:status "proposed" .

gbobegrip:Dienst a skos:Concept ;
    dcterms:source "GBO PSA" ;
    skos:definition "Een afgebakend doel waarvoor gegevens mogen worden opgevraagd, wettelijk verankerd en met een maximale scope."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Dienst"@nl ;
    adms:status "proposed" .

gbobegrip:Dienstencatalogus a skos:Concept ;
    dcterms:source "GBO PSA" ;
    skos:definition "Het register van alle beschikbare diensten met hun scopes."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Dienstencatalogus"@nl ;
    adms:status "proposed" .

gbobegrip:DoorlopendKrediet a skos:Concept ;
    dcterms:source <https://www.bkr.nl/media/4dyezfiz/algemeen-reglement-cki-juli-2024.pdf>,
        "Algemeen Reglement CKI 2024-07-01 art. 17" ;
    skos:altLabel "Revolverend krediet"@nl ;
    skos:definition "Een kredietovereenkomst waarbij de kredietnemer tot een afgesproken kredietlimiet steeds opnieuw kan opnemen en aflossen, zonder vaste looptijd en zonder verplicht aflossingsschema."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Doorlopend krediet"@nl ;
    adms:status "proposed" .

gbobegrip:EigenWoning a skos:Concept ;
    dcterms:source "Wet IB 2001 art. 3.111" ;
    skos:definition "Een onroerende zaak die op grond van Wet IB 2001 art. 3.111 als hoofdverblijf van de belastingplichtige of zijn fiscale partner wordt aangemerkt."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Eigen woning"@nl ;
    adms:status "proposed" .

gbobegrip:Evidence a skos:Concept ;
    dcterms:source "SDG-verordening (EU) 2018/1724 en het OOTS Evidence Broker" ;
    skos:altLabel "Bewijsstuk"@nl ;
    skos:definition "Levering als bewijsstuk in de vorm die het Once-Only Technical System voorschrijft, bestemd voor een bevoegde autoriteit in een andere lidstaat."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Evidence"@nl ;
    adms:status "proposed" .

gbobegrip:FinancieleVerplichting a skos:Concept ;
    dcterms:source "GBO-Kern, afgeleid uit het verbintenisrecht en het Algemeen Reglement CKI" ;
    skos:altLabel "Financial Obligation"@en,
        "Schuld"@nl ;
    skos:definition "Een verplichting van een natuurlijk persoon of niet-natuurlijk persoon tot het verrichten van een geldelijke prestatie aan een tegenpartij, ontstaan uit overeenkomst of uit een wettelijke regeling."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Financiele verplichting"@nl ;
    adms:status "proposed" .

gbobegrip:FiscaalFeit a skos:Concept ;
    dcterms:source "GBO-Kern, afgeleid uit SBR-NT NT20" ;
    skos:altLabel "Aangiftecomponent"@nl ;
    skos:definition "Een fiscaal relevant gegeven over een belastingplichtige dat in een specifiek belastingjaar als component in een belastingaangifte verschijnt."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Fiscaal feit"@nl ;
    adms:status "proposed" .

gbobegrip:FiscalePartner a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0011353>,
        "Wet IB 2001 art. 5a" ;
    skos:definition "Een relatie tussen twee natuurlijke personen die op grond van Wet IB 2001 art. 5a fiscaal als partners worden aangemerkt en gezamenlijk gemeenschappelijke inkomensbestanddelen en aftrekposten kunnen toedelen tussen de boxen."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Fiscale partner"@nl ;
    adms:status "proposed" .

gbobegrip:Gegevenselement a skos:Concept ;
    dcterms:source "GBO PSA" ;
    skos:definition "De kleinste adresseerbare eenheid van data, die naar precies een begrip verwijst en daar structuurinformatie aan toevoegt."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Gegevenselement"@nl ;
    adms:status "proposed" .

gbobegrip:Gegevensset a skos:Concept ;
    dcterms:source "GBO (voorstel)" ;
    skos:definition "Levering als verzameling gegevenselementen in het GBO-formaat, zonder juridische waarmerking."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Gegevensset"@nl ;
    adms:status "proposed" .

gbobegrip:Gegevensverzoek a skos:Concept ;
    dcterms:source "GBO PSA" ;
    skos:definition "De transactie waarmee brondata wordt opgevraagd, op basis van precies een grondslag."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Gegevensverzoek"@nl ;
    adms:status "proposed" .

gbobegrip:GiftenAftrek a skos:Concept ;
    dcterms:source "Wet IB 2001 art. 6.32 en 6.33" ;
    skos:definition "De op grond van Wet IB 2001 art. 6.32 aftrekbare giften die de belastingplichtige in een belastingjaar heeft gedaan aan een algemeen nut beogende instelling of culturele instelling."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Giften aftrek"@nl ;
    adms:status "proposed" .

gbobegrip:Grondslag a skos:Concept ;
    dcterms:source "GBO PSA" ;
    skos:definition "De juridische basis voor gegevensuitwisseling: toestemming van de betrokkene of een wettelijke verplichting."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Grondslag"@nl ;
    adms:status "proposed" .

gbobegrip:HerstelMelding a skos:Concept ;
    dcterms:source <https://www.bkr.nl/media/4dyezfiz/algemeen-reglement-cki-juli-2024.pdf>,
        "Algemeen Reglement CKI 2024-07-01 art. 12 lid 3" ;
    skos:altLabel "H-melding"@nl ;
    skos:definition "Een melding aan het Centraal Krediet Informatiesysteem dat een eerder gemelde achterstand op een kredietovereenkomst is opgelost."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Herstel melding"@nl ;
    adms:status "proposed" .

gbobegrip:Huurtoeslag a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0008659>,
        "Wet op de huurtoeslag art. 1" ;
    skos:definition "Een inkomensafhankelijke toeslag op grond van de Wet op de huurtoeslag, toegekend aan huurders met een laag inkomen ter tegemoetkoming in de woonlasten."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Huurtoeslag"@nl ;
    adms:status "proposed" .

gbobegrip:HypothecairKredietEigenWoning a skos:Concept ;
    dcterms:source <https://www.bkr.nl/media/4dyezfiz/algemeen-reglement-cki-juli-2024.pdf>,
        "Algemeen Reglement CKI 2024-07-01 art. 19" ;
    skos:altLabel "Eigenwoningschuld"@nl ;
    skos:definition "Een kredietovereenkomst tot financiering van de eigen woning van de kredietnemer, waarbij een hypotheekrecht is gevestigd op die onroerende zaak, en waarvan op grond van het Algemeen Reglement CKI uitsluitend negatieve betalingservaringen aan het Centraal Krediet Informatiesysteem worden gemeld."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Hypothecair krediet eigen woning"@nl ;
    adms:status "proposed" .

gbobegrip:HypothecairKredietOverigeOnroerendeZaken a skos:Concept ;
    dcterms:source <https://www.bkr.nl/media/4dyezfiz/algemeen-reglement-cki-juli-2024.pdf>,
        "Algemeen Reglement CKI 2024-07-01 art. 20" ;
    skos:definition "Een kredietovereenkomst waarbij een hypotheekrecht is gevestigd op een onroerende zaak die niet de eigen woning van de kredietnemer is, zoals een tweede woning, een verhuurde woning of een beleggingspand."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Hypothecair krediet overige onroerende zaken"@nl ;
    adms:status "proposed" .

gbobegrip:Hypotheekrenteaftrek a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0011353>,
        "Wet IB 2001 art. 3.120" ;
    skos:altLabel "Eigenwoningrente"@nl ;
    skos:definition "De op grond van Wet IB 2001 art. 3.120 in Box 1 aftrekbare rente die de belastingplichtige in een belastingjaar heeft betaald voor een eigenwoningschuld op zijn eigen woning."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Hypotheekrenteaftrek"@nl ;
    adms:status "proposed" .

gbobegrip:InkomensOndersteuning a skos:Concept ;
    dcterms:source "GBO-Kern abstractie boven Awir en sociale-zekerheidsregelingen" ;
    skos:definition "Een door of namens de overheid aan een natuurlijk persoon verstrekte financiele bijdrage met als doel inkomensondersteuning."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Inkomens ondersteuning"@nl ;
    adms:status "proposed" .

gbobegrip:Inkomstenopgave a skos:Concept ;
    dcterms:source "Gegevensspecificaties aangifte loonheffingen 2026" ;
    skos:definition "De aggregatie van loongegevens van een werknemer binnen een aangifte loonheffingen over een aangifteperiode."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Inkomstenopgave"@nl ;
    adms:status "proposed" .

gbobegrip:Inkomstenperiode a skos:Concept ;
    dcterms:source "Gegevensspecificaties aangifte loonheffingen 2026" ;
    skos:definition "Een tijdvak binnen een inkomstenopgave waarin specifieke loongegevens gelden."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Inkomstenperiode"@nl ;
    adms:status "proposed" .

gbobegrip:Inkomstenverhouding a skos:Concept ;
    dcterms:source "Gegevensspecificaties aangifte loonheffingen 2026" ;
    skos:altLabel "IKV"@nl ;
    skos:definition "De administratieve relatie tussen een inhoudingsplichtige en een natuurlijk persoon op grond waarvan over een doorlopende periode loon wordt uitbetaald."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Inkomstenverhouding"@nl ;
    adms:status "proposed" .

gbobegrip:Interactiepatroon a skos:Concept ;
    dcterms:source "GBO PSA, hoofdstuk Interactiepatronen" ;
    skos:definition "Een van de manieren waarop een gegevensverzoek tot stand komt en wordt beantwoord, met vaste afspraken over wie initieert, wie ontvangt en welke grondslag geldt."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Interactiepatroon"@nl ;
    adms:status "proposed" .

gbobegrip:Kentekentenaamstelling a skos:Concept ;
