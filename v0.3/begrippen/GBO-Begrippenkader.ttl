        "Mini-lening"@nl ;
    skos:definition "Een kredietovereenkomst met een korte looptijd, doorgaans korter dan drie maanden, met een betrekkelijk klein kredietbedrag."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Kort krediet"@nl ;
    adms:status "proposed" .

gbobegrip:KredietFeit a skos:Concept ;
