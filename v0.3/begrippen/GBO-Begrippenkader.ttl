    skos:prefLabel "Kinderopvang toeslag"@nl ;
    adms:status "proposed" .

gbobegrip:KindgebondenBudget a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0023491>,
        "Wet op het kindgebonden budget" ;
    skos:definition "Een inkomensafhankelijke tegemoetkoming in de kosten voor de opvoeding en het levensonderhoud van kinderen, toegekend op grond van de Wet op het kindgebonden budget."@nl ;
