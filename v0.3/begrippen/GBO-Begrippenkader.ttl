    skos:altLabel "Educational Institution"@en,
        "Bevoegd gezag"@nl,
        "Onderwijsorganisatie"@nl,
        "School"@nl ;
    skos:definition "Een door OCW erkende rechtspersoon of bestuurlijke entiteit die onderwijs aanbiedt in een of meer Nederlandse onderwijssectoren."@nl ;
