gbobegrip:Levering a skos:Concept ;
    dcterms:source "GBO (voorstel), afgeleid uit de drie leveringsvormen in de GBO PSA" ;
    skos:definition "Het resultaat dat op een gegevensverzoek wordt teruggegeven."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Levering"@nl ;
    adms:status "proposed" .

gbobegrip:LijfrenteAftrek a skos:Concept ;
