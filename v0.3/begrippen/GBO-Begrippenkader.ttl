        "Wegenverkeerswet 1994, Kentekenreglement (tenaamstelling)" ;
    skos:altLabel "Vehicle registration (keepership)"@en,
        "Kentekenhouderschap"@nl,
        "Tenaamstelling (voertuig)"@nl ;
