    adms:status "proposed" .

gbobegrip:StudieLening a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0011453>,
        "GBO-Kern, afgeleid uit WSF 2000 hoofdstuk 6" ;
    skos:altLabel "Student loan"@en,
        "DUO-schuld"@nl,
        "Studieschuld"@nl ;
    skos:definition "Het door een (oud-)student bij DUO opgebouwde renteloze of laagrentende leningbedrag op grond van de Wet studiefinanciering 2000, samen met de aflosregeling waaronder het bedrag moet worden terugbetaald."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Studie lening"@nl ;
    adms:status "proposed" .

gbobegrip:Toeslag a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0018472>,
        "Awir art. 1 jo. art. 2" ;
    skos:definition "Een inkomensafhankelijke bijdrage die op grond van de Algemene wet inkomensafhankelijke regelingen door Belastingdienst/Toeslagen aan een natuurlijk persoon wordt toegekend voor een specifiek doel."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Toeslag"@nl ;
    adms:status "proposed" .

gbobegrip:Toestemming a skos:Concept ;
    dcterms:source "GBO PSA; AVG art. 4 lid 11 voor het toestemmingsbegrip" ;
    skos:definition "Het expliciete akkoord van de betrokkene dat een specifieke partij een specifieke set gegevens mag opvragen, gebonden aan een scope en een geldigheidsduur."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Toestemming"@nl ;
    adms:status "proposed" .

gbobegrip:Toestemmingsstatus a skos:Concept ;
    dcterms:source "GBO (voorstel)" ;
    skos:definition "De statussen die een toestemming kan doorlopen."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Toestemmingsstatus"@nl ;
    adms:status "proposed" .

gbobegrip:Uitkering a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0013060>,
        "Wet SUWI; SGR-cluster Uitkering" ;
    skos:altLabel "Sociale-zekerheidsuitkering"@nl ;
    skos:definition "Een door of namens de overheid aan een natuurlijk persoon toegekende periodieke uitkering op grond van een werknemersverzekering of volksverzekering, ter vervanging of aanvulling van loon."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Uitkering"@nl ;
    adms:status "proposed" .

gbobegrip:UitkeringAOW a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0002221>,
        "Algemene Ouderdomswet" ;
    skos:definition "Een door SVB op grond van de Algemene Ouderdomswet toegekende periodieke uitkering aan personen vanaf de AOW-gerechtigde leeftijd."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Uitkering AOW"@nl ;
    adms:status "proposed" .

gbobegrip:UitkeringIVA a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0019057>,
        "Wet WIA hoofdstuk IV" ;
    skos:definition "De Inkomensvoorziening Volledig Arbeidsongeschikten op grond van de WIA, toegekend aan werknemers die duurzaam minder dan 20% van hun oude loon kunnen verdienen."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Uitkering IVA"@nl ;
    adms:status "proposed" .

gbobegrip:UitkeringWGA a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0019057>,
        "Wet WIA hoofdstuk VII" ;
    skos:definition "De Werkhervatting Gedeeltelijk Arbeidsongeschikten op grond van de WIA, toegekend aan werknemers die 35% tot 80% arbeidsongeschikt zijn, of volledig arbeidsongeschikt maar niet duurzaam."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Uitkering WGA"@nl ;
    adms:status "proposed" .

gbobegrip:UitkeringWIA a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0019057>,
        "Wet WIA" ;
    skos:definition "Een door UWV op grond van de Wet werk en inkomen naar arbeidsvermogen toegekende periodieke uitkering aan een werknemer die na een wachttijd van twee jaar van ziekte gedeeltelijk of volledig arbeidsongeschikt is."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Uitkering WIA"@nl ;
    adms:status "proposed" .

gbobegrip:UitkeringWW a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0004045>,
        "Werkloosheidswet hoofdstuk II" ;
    skos:definition "Een door UWV aan een werkloze werknemer toegekende periodieke uitkering op grond van de Werkloosheidswet, ter vervanging van het weggevallen loon."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Uitkering WW"@nl ;
    adms:status "proposed" .

gbobegrip:UitkeringWajong a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0008657>,
        "Wajong" ;
    skos:definition "Een door UWV op grond van de Wet arbeidsongeschiktheidsvoorziening jonggehandicapten toegekende periodieke uitkering aan jonggehandicapten."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Uitkering Wajong"@nl ;
    adms:status "proposed" .

gbobegrip:UitkeringZW a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0001888>,
        "Ziektewet" ;
    skos:definition "Een door UWV aan een zieke werknemer of vangnetter toegekende periodieke uitkering op grond van de Ziektewet."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Uitkering ZW"@nl ;
    adms:status "proposed" .

gbobegrip:VermogensBestanddeel a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0011353>,
        "Wet IB 2001 art. 5.2 jo. SBR-NT NT20" ;
    skos:altLabel "Box-3-bestanddeel"@nl ;
    skos:definition "Een bezitting of schuld die op de peildatum 1 januari onder Box 3 van de inkomstenbelasting valt."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Vermogens bestanddeel"@nl ;
    adms:status "proposed" .

gbobegrip:Verzamelinkomen a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0028058>,
        "Wet basisregistratie inkomen art. 1 jo. art. 4" ;
    skos:altLabel "Authentiek inkomen"@nl,
        "Authentiek inkomen gegeven"@nl ;
    skos:definition "Het door de Belastingdienst vastgestelde verzamelinkomen of belastbaar loon van een natuurlijk persoon over een belastingjaar, aangewezen als authentiek gegeven in de Basisregistratie Inkomen."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Verzamelinkomen"@nl ;
    adms:status "proposed" .

gbobegrip:VerzuimMelding a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0002628>,
        "GBO-Kern, afgeleid uit Leerplichtwet art. 21a en WEB art. 8.1.7" ;
    skos:altLabel "Melding voortijdig schoolverlater"@nl,
        "Verzuimmelding"@nl ;
    skos:definition "Een wettelijk verplichte melding door een onderwijsinstelling van ongeoorloofd verzuim van een leerplichtige of kwalificatieplichtige leerling, of van verzuim van een 18-plus deelnemer dat langer dan vier weken aaneengesloten duurt."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Verzuim melding"@nl ;
    adms:status "proposed" .

gbobegrip:Voertuig a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0006622>,
        "Wegenverkeerswet 1994 (kentekenregister), Kentekenreglement" ;
    skos:altLabel "Vehicle"@en,
        "Kentekenhoudend voertuig"@nl,
        "Motorrijtuig"@nl ;
    skos:definition "Een voertuig dat in het kentekenregister staat geregistreerd en daarvoor een kenteken heeft gekregen, zoals een personenauto, motorfiets, vrachtwagen, aanhangwagen of bromfiets met kenteken."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Voertuig"@nl ;
    adms:status "proposed" .

gbobegrip:Vooropleiding a skos:Concept ;
    dcterms:source "GBO-Kern, afgeleid uit PvE ROD en sectorwetten" ;
    skos:altLabel "Prior qualification"@en,
        "Instroom-bewijs"@nl,
        "Toelatingsdiploma"@nl ;
    skos:definition "Een eerder behaald opleidingsresultaat dat bij een volgende onderwijsdeelname wordt aangereikt als bewijs voor de toelating tot of de instroom-positionering in een opleiding."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Vooropleiding"@nl ;
    adms:status "proposed" .

gbobegrip:WettelijkeVerplichting a skos:Concept ;
    dcterms:source "GBO (voorstel); voor OOTS de SDG-verordening (EU) 2018/1724" ;
    skos:definition "De wettelijke bepaling op grond waarvan gegevens zonder toestemming van de betrokkene mogen of moeten worden verstrekt."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Wettelijke verplichting"@nl ;
    adms:status "proposed" .

gbobegrip:ZakelijkKrediet a skos:Concept ;
    dcterms:source <https://www.bkr.nl/media/4dyezfiz/algemeen-reglement-cki-juli-2024.pdf>,
        "Algemeen Reglement CKI 2024-07-01 art. 24" ;
    skos:definition "Een kredietovereenkomst aangegaan ten behoeve van een onderneming waarbij sprake is van persoonlijke aansprakelijkheid van een of meer natuurlijke personen."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Zakelijk krediet"@nl ;
    adms:status "proposed" .

gbobegrip:ZakelijkeOverigeFinancieleVerplichting a skos:Concept ;
    dcterms:source <https://www.bkr.nl/media/4dyezfiz/algemeen-reglement-cki-juli-2024.pdf>,
        "Algemeen Reglement CKI 2024-07-01 art. 25" ;
    skos:definition "Een overige zakelijke financiele verplichting die niet onder ZakelijkKrediet valt en waarvan alleen negatieve betalingservaringen worden gemeld."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Zakelijke overige financiele verplichting"@nl ;
    adms:status "proposed" .

gbobegrip:Zorgtoeslag a skos:Concept ;
    dcterms:source <https://wetten.overheid.nl/BWBR0018451>,
        "Wet op de zorgtoeslag" ;
    skos:definition "Een inkomensafhankelijke tegemoetkoming in de premie van de basiszorgverzekering, toegekend op grond van de Wet op de zorgtoeslag."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Zorgtoeslag"@nl ;
    adms:status "proposed" .

<https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> a skos:ConceptScheme ;
    dcterms:description "Begrippenkader van de Gemeenschappelijke Bronontsluiting, gegenereerd uit de SKOS-annotaties in de LinkML-modelbron."@nl ;
