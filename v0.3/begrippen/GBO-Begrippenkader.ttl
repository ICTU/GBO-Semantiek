        "Programme"@en,
        "Onderwijsaanbod"@nl,
        "Opleidingseenheid"@nl ;
    skos:definition "Een door een bevoegd gezag aangeboden, samenhangend geheel van onderwijs- en leeractiviteiten dat tot een vooraf vastgesteld kwalificatie- of diploma-niveau leidt."@nl ;
    skos:inScheme <https://begrippen.gbo-semantiek.nl/id/conceptscheme/gbo-kern> ;
    skos:prefLabel "Opleiding"@nl ;
    adms:status "proposed" .

gbobegrip:OpleidingDeelname a skos:Concept ;
