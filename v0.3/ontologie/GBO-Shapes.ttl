<https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding> a sh:NodeShape ;
    rdfs:comment "Een door het bevoegde gemeentelijke gezag aan een adresseerbaar object toegekende aanduiding bestaande uit een huisnummer met eventueel een huisletter, een huisnummertoevoeging en een postcode, die samen met de naam van de openbare ruimte en de woonplaats het formele adres vormt." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:dateTime> ;
            sh:description "Formele tijdlijn: start van de registratie." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path <https://lod.gbo-semantiek.nl/hoofdmodel/voorkomen/tijdstipregistratie> ],
        [ sh:datatype <xsd:string> ;
            sh:description "Letter ter onderscheid binnen één huisnummer." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding/huisletter> ],
        [ sh:datatype <xsd:date> ;
            sh:description "Materiële tijdlijn: einde van de geldigheid; open betekent lopend." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path <https://lod.gbo-semantiek.nl/hoofdmodel/voorkomen/eindgeldigheid> ],
        [ sh:description "Levenscyclus-status van de nummeraanduiding." ;
            sh:in ( "NaamgevingUitgegeven" "NaamgevingIngetrokken" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding/status> ],
        [ sh:datatype <xsd:date> ;
            sh:description "Datum van het bron-document (akte)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path <https://lod.gbo-semantiek.nl/hoofdmodel/datakwaliteit/documentdatum> ],
        [ sh:datatype <xsd:string> ;
            sh:description "Identificatie van het bron-document." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path <https://lod.gbo-semantiek.nl/hoofdmodel/datakwaliteit/documentnummer> ],
        [ sh:class <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/openbareruimte> ;
            sh:description "De openbare ruimte waarin de nummeraanduiding is uitgegeven." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding/inopenbareruimte> ],
        [ sh:datatype <xsd:date> ;
            sh:description "Datum waarop officieel geconstateerd." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path <https://lod.gbo-semantiek.nl/hoofdmodel/datakwaliteit/geconstateerd> ],
        [ sh:description "Markering dat de kwaliteit in onderzoek is." ;
            sh:in ( "Ja" "Nee" "Onbekend" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 33 ;
            sh:path <https://lod.gbo-semantiek.nl/hoofdmodel/datakwaliteit/inonderzoek> ],
        [ sh:datatype <xsd:string> ;
            sh:description "Vrije aanvulling op huisnummer en huisletter (bv. 2hg, bis)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding/huisnummertoevoeging> ],
        [ sh:datatype <xsd:integer> ;
            sh:description "Numerieke aanduiding van het adres binnen de openbare ruimte." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding/huisnummer> ],
        [ sh:description "Markering dat de kwaliteit in onderzoek is." ;
            sh:in ( "Ja" "Nee" "Onbekend" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 15 ;
            sh:path <https://lod.gbo-semantiek.nl/hoofdmodel/datakwaliteit/inonderzoek> ],
        [ sh:class <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/binnenlandsadres> ;
            sh:description "Eén nummeraanduiding vormt precies één Binnenlandsadres-instantie." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding/vormt> ],
        [ sh:datatype <xsd:string> ;
            sh:description "Postcode behorend bij het huisnummer." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding/postcode> ;
            sh:pattern "^[1-9][0-9]{3} ?[A-Z]{2}$" ],
        [ sh:datatype <xsd:string> ;
            sh:description "Letter ter onderscheid binnen één huisnummer." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding/huisletter> ],
        [ sh:datatype <xsd:dateTime> ;
            sh:description "Formele tijdlijn: einde van de registratie; open betekent actueel." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path <https://lod.gbo-semantiek.nl/hoofdmodel/voorkomen/eindregistratie> ],
        [ sh:description "Aanduiding van de vorm waarop de nummeraanduiding wijst (Verblijfsobject, Ligplaats of Standplaats)." ;
            sh:in ( "Verblijfsobject" "Ligplaats" "Standplaats" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding/typeadresseerbaarobject> ],
        [ sh:datatype <xsd:date> ;
            sh:description "Materiële tijdlijn: start van de geldigheid." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path <https://lod.gbo-semantiek.nl/hoofdmodel/voorkomen/begingeldigheid> ],
        [ sh:class <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/openbareruimte> ;
            sh:description "De openbare ruimte waarin de nummeraanduiding is uitgegeven." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding/inopenbareruimte> ],
        [ sh:class <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/binnenlandsadres> ;
            sh:description "Eén nummeraanduiding vormt precies één Binnenlandsadres-instantie." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding/vormt> ],
        [ sh:datatype <xsd:integer> ;
            sh:description "Monotone versieteller." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path <https://lod.gbo-semantiek.nl/hoofdmodel/voorkomen/versie> ],
        [ sh:datatype <xsd:dateTime> ;
            sh:description "Formele tijdlijn: start van de registratie." ;
