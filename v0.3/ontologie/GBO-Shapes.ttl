            sh:path <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoon/zetel> ],
        [ sh:description "Bestuurlijke typering; van toepassing bij classificatie = Overheidsinstelling." ;
            sh:in ( "Rijksoverheid" "Ministerie" "Provincie" "Gemeente" "Waterschap" "ZBO" "RWT" "Agentschap" "OverigeOverheid" ) ;
