            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/aangifteih/box2inkomen> ],
        [ sh:datatype <xsd:string> ;
            sh:description "IH, Schenk, Erf." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/belastingjaaraangifte/belastingsoort> ],
        [ sh:class <https://lod.gbo-semantiek.nl/datatypes/bedrag> ;
            sh:description "Som van Box 1, Box 2 en Box 3, na aftrek." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/aangifteih/verzamelinkomen> ],
        [ sh:datatype <xsd:string> ;
