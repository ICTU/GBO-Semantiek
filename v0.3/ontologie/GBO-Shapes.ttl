    sh:ignoredProperties ( <https://lod.gbo-semantiek.nl/personen/nietingezetene/deelnemercoderni> rdf:type <https://lod.gbo-semantiek.nl/personen/nietingezetene/woontop> <https://lod.gbo-semantiek.nl/personen/ingezetene/heeftbriefadres> <https://lod.gbo-semantiek.nl/personen/ingezetene/datuminschrijvinggemeente> <https://lod.gbo-semantiek.nl/personen/nietingezetene/datuminschrijvingrni> <https://lod.gbo-semantiek.nl/personen/nietingezetene/landvanverblijf> <https://lod.gbo-semantiek.nl/personen/ingezetene/indicatiegeheim> <https://lod.gbo-semantiek.nl/personen/ingezetene/woontop> gbo:woontOp ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description "De gemeente of plaats waar de persoon is geboren." ;
