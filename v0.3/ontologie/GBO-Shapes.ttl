gbobegrip:Voertuig a sh:NodeShape ;
    rdfs:comment "Een door de RDW in de Basisregistratie Voertuigen geregistreerd vervoermiddel dat met een uniek kenteken aan het verkeer kan deelnemen, met de bij dat kenteken horende technische en administratieve kerngegevens." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description "Handelsbenaming (type-/modelaanduiding) van het voertuig." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://lod.gbo-semantiek.nl/voertuigen/voertuig/handelsbenaming> ],
        [ sh:datatype <xsd:string> ;
            sh:description "Merk van het voertuig." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path <https://lod.gbo-semantiek.nl/voertuigen/voertuig/merk> ],
        [ sh:datatype <xsd:string> ;
            sh:description "Handelsbenaming (type-/modelaanduiding) van het voertuig." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path <https://lod.gbo-semantiek.nl/voertuigen/voertuig/handelsbenaming> ],
        [ sh:datatype <xsd:string> ;
            sh:description "Wereldwijd uniek voertuigidentificatienummer (VIN / chassisnummer) toegekend door de fabrikant." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path <https://lod.gbo-semantiek.nl/voertuigen/voertuig/voertuigidentificatienummer> ;
            sh:pattern "^[A-Za-z0-9]*$" ],
        [ sh:datatype <xsd:dateTime> ;
            sh:description "Formele tijdlijn: einde van de registratie; open betekent actueel." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path <https://lod.gbo-semantiek.nl/hoofdmodel/voorkomen/eindregistratie> ],
        [ sh:datatype <xsd:integer> ;
            sh:description "Aantal zitplaatsen inclusief bestuurder." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path <https://lod.gbo-semantiek.nl/voertuigen/voertuig/aantalzitplaatsen> ],
        [ sh:description "Administratieve status van het voertuig." ;
            sh:in ( "Tenaamgesteld" "Bedrijfsvoorraad" "Geschorst" "Geexporteerd" "Gesloopt" "Vermist" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 15 ;
            sh:path <https://lod.gbo-semantiek.nl/voertuigen/voertuig/voertuigstatus> ],
        [ sh:datatype <xsd:dateTime> ;
            sh:description "Formele tijdlijn: start van de registratie." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path <https://lod.gbo-semantiek.nl/hoofdmodel/voorkomen/tijdstipregistratie> ],
        [ sh:class gbobegrip:Kentekentenaamstelling ;
            sh:description "De tenaamstelling(en) van dit voertuig, historisch en actueel." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path <https://lod.gbo-semantiek.nl/voertuigen/voertuig/heefttenaamstelling> ],
        [ sh:datatype <xsd:date> ;
            sh:description "Materiële tijdlijn: einde van de geldigheid; open betekent lopend." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path <https://lod.gbo-semantiek.nl/hoofdmodel/voorkomen/eindgeldigheid> ],
        [ sh:datatype <xsd:integer> ;
            sh:description "Massa van het lege voertuig in kg." ;
