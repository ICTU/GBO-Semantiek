            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path <https://lod.gbo-semantiek.nl/voertuigen/voertuig/massaledigvoertuig> ],
        [ sh:datatype <xsd:integer> ;
            sh:description "Massa van het lege voertuig in kg." ;
            sh:maxCount 1 ;
