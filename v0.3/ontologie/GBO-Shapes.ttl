gbobegrip:AangifteErf a sh:NodeShape ;
    rdfs:comment "De aangifte erfbelasting waarin de nalatenschap van een overledene en de verdeling daarvan over de erfgenamen wordt opgegeven." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class gbobegrip:NatuurlijkPersoon ;
            sh:description "De natuurlijk persoon door of namens wie de aangifte is ingediend." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/belastingjaaraangifte/ingedienddoor> ],
        [ sh:datatype <xsd:integer> ;
            sh:description "Het jaar waarop de aangifte betrekking heeft." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/belastingjaaraangifte/belastingjaar> ],
        [ sh:datatype <xsd:string> ;
            sh:description "IH, Schenk, Erf." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/belastingjaaraangifte/belastingsoort> ],
        [ sh:datatype <xsd:string> ;
            sh:description "Identificatie van de aangifte." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/belastingaangifte/aangifteidentificatie> ],
        [ sh:datatype <xsd:date> ;
            sh:description "Datum van overlijden." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/aangifteerf/overlijdensdatum> ],
        [ sh:datatype <xsd:string> ;
            sh:description "Bijvoorbeeld Ingediend, Aangeslagen, Bezwaar lopend." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/belastingaangifte/status> ],
        [ sh:datatype <xsd:date> ;
            sh:description "Begin van de aangifteperiode." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/belastingjaaraangifte/ingangsdatumaangifte> ],
        [ sh:datatype <xsd:date> ;
            sh:description "Einde van de aangifteperiode." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/belastingjaaraangifte/einddatumaangifte> ],
        [ sh:class <https://lod.gbo-semantiek.nl/datatypes/bedrag> ;
            sh:description "Fiscale waarde van de nalatenschap." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/aangifteerf/omvangnalatenschap> ],
        [ sh:datatype <xsd:string> ;
            sh:description "Identificatie van de aangifte." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/belastingaangifte/aangifteidentificatie> ],
        [ sh:datatype <xsd:string> ;
            sh:description "IH, Schenk, Erf." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/belastingjaaraangifte/belastingsoort> ],
        [ sh:datatype <xsd:date> ;
            sh:description "Begin van de aangifteperiode." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/belastingjaaraangifte/ingangsdatumaangifte> ],
        [ sh:class gbobegrip:NatuurlijkPersoon ;
            sh:description "De natuurlijk persoon door of namens wie de aangifte is ingediend." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/belastingjaaraangifte/ingedienddoor> ],
        [ sh:datatype <xsd:string> ;
            sh:description "Bijvoorbeeld Ingediend, Aangeslagen, Bezwaar lopend." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/belastingaangifte/status> ],
        [ sh:datatype <xsd:integer> ;
            sh:description "Aantal erfgenamen." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/aangifteerf/aantalerfgenamen> ],
        [ sh:datatype <xsd:integer> ;
            sh:description "Het jaar waarop de aangifte betrekking heeft." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/belastingjaaraangifte/belastingjaar> ],
        [ sh:datatype <xsd:date> ;
            sh:description "Datum van overlijden." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/aangifteerf/overlijdensdatum> ],
        [ sh:datatype <xsd:date> ;
            sh:description "Datum van feitelijke indiening." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/belastingaangifte/indieningsdatum> ],
        [ sh:datatype <xsd:date> ;
            sh:description "Einde van de aangifteperiode." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/belastingjaaraangifte/einddatumaangifte> ],
        [ sh:datatype <xsd:date> ;
            sh:description "Datum van feitelijke indiening." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/belastingaangifte/indieningsdatum> ],
        [ sh:datatype <xsd:integer> ;
            sh:description "Aantal erfgenamen." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/aangifteerf/aantalerfgenamen> ],
        [ sh:class <https://lod.gbo-semantiek.nl/datatypes/bedrag> ;
            sh:description "Fiscale waarde van de nalatenschap." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/aangifteerf/omvangnalatenschap> ] ;
    sh:targetClass gbobegrip:AangifteErf .

gbobegrip:AangifteIH a sh:NodeShape ;
    rdfs:comment "De jaaraangifte inkomstenbelasting van een natuurlijk persoon waarin het verzamelinkomen over een belastingjaar wordt opgegeven, opgebouwd uit Box 1 (werk en woning), Box 2 (aanmerkelijk belang) en Box 3 (sparen en beleggen)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Toepasselijke boxen." ;
            sh:in ( "Box1WerkEnWoning" "Box2AanmerkelijkBelang" "Box3SparenEnBeleggen" ) ;
            sh:order 17 ;
            sh:path <https://lod.gbo-semantiek.nl/belastingen/aangifteih/boxcategorie> ],
        [ sh:class <https://lod.gbo-semantiek.nl/datatypes/bedrag> ;
            sh:description "Inkomen uit aanmerkelijk belang." ;
