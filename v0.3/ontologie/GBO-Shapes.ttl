gbobegrip:OnderwijsInstelling a sh:NodeShape ;
    rdfs:comment "Een door OCW erkende rechtspersoon of bestuurlijke entiteit die onderwijs aanbiedt in een of meer Nederlandse onderwijssectoren." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Sectorale typering; van toepassing bij classificatie = MaatschappelijkeInstelling." ;
            sh:in ( "Onderwijs" "Zorg" "Religie" "Sport_Cultuur" "Welzijn" "BrancheBelangen" "OverigMaatschappelijk" ) ;
            sh:maxCount 1 ;
            sh:order 14 ;
            sh:path <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoon/typemaatschappelijk> ],
        [ sh:datatype <xsd:string> ;
