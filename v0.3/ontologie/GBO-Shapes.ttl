            sh:nodeKind sh:Literal ;
            sh:order 58 ;
            sh:path <https://lod.gbo-semantiek.nl/personen/natuurlijkpersoon/geboorteland> ;
            sh:pattern "^[A-Z]{2}$" ],
        [ sh:datatype <xsd:string> ;
            sh:description "Alle officiële voornamen van de persoon." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 53 ;
            sh:path <https://lod.gbo-semantiek.nl/personen/natuurlijkpersoon/voornamen> ],
        [ sh:datatype <xsd:string> ;
            sh:description "Het voorvoegsel bij de geslachtsnaam." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://lod.gbo-semantiek.nl/personen/natuurlijkpersoon/voorvoegsel> ],
        [ sh:description "Het geslacht van de persoon." ;
