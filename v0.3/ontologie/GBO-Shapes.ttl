        [ sh:class <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/maatschappelijkeactiviteit> ;
            sh:description "De maatschappelijke activiteit(en), de op KVK-nummer geïdentificeerde inschrijvingseenheid van het Handelsregister, waarbij deze partij als eigenaar of vennoot betrokken is." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
