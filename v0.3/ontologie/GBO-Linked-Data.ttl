    mim:datumOpname "2026-04-28" ;
    mim:herkomst "BAG" ;
    mim:herkomstDefinitie "Bron: Catalogus BAG 2018 (IMBAG). Wettelijke grondslag: Wet BAG; Catalogus BAG 2018 §2.4; IMBAG-attribuutdomein." ;
    linkml:permissible_values <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/statuspand#BouwGestart>,
