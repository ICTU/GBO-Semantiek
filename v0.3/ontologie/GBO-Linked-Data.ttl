        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Identificatie ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/maatschappelijkeactiviteit/documentnummer> ],
        [ a owl:Restriction ;
