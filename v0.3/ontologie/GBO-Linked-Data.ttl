    skos:altLabel_en_0_value "Module enrollment" ;
    skos:altLabel_nl_0_source "WHW art. 7.3a (terminologie)" ;
    skos:altLabel_nl_0_value "Onderwijseenheid-inschrijving" ;
    skos:altLabel_nl_1_source "PvE ROD HO (afkorting in koppelvlak; te bevestigen)" ;
    skos:altLabel_nl_1_value "MBI" ;
    skos:broadMatch gbobegrip:OpleidingDeelname ;
    skos:closeMatch <https://elmo.eu/module-enrollment> ;
    skos:closeMatch_0_reviewed "false" ;
    skos:definition "De inschrijving van een student voor een onderwijseenheid binnen een lopende opleiding-deelname in het hoger onderwijs, met een vastgestelde studielast in ECTS." ;
    skos:definitionSource "GBO-Kern, afgeleid uit WHW art. 7.3a en PvE ROD HO" ;
    skos:definitionSourceUri "https://wetten.overheid.nl/BWBR0005682" ;
    skos:definition_nl "De inschrijving van een student voor een onderwijseenheid binnen een opleiding-deelname in het hoger onderwijs, met een vastgestelde studielast in ECTS." ;
