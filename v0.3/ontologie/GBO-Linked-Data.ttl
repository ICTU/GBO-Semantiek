<https://lod.gbo-semantiek.nl/belastingen/codesectorindelingwhk> a owl:Class ;
    rdfs:label "CodeSectorindelingWhk" ;
    owl:unionOf ( <https://lod.gbo-semantiek.nl/belastingen/codesectorindelingwhk#AgrarischBedrijf> <https://lod.gbo-semantiek.nl/belastingen/codesectorindelingwhk#Bouwbedrijf> <https://lod.gbo-semantiek.nl/belastingen/codesectorindelingwhk#Metaalindustrie> <https://lod.gbo-semantiek.nl/belastingen/codesectorindelingwhk#DetailhandelEnAmbachten> <https://lod.gbo-semantiek.nl/belastingen/codesectorindelingwhk#Grootwinkelbedrijf> <https://lod.gbo-semantiek.nl/belastingen/codesectorindelingwhk#Gezondheidszorg> <https://lod.gbo-semantiek.nl/belastingen/codesectorindelingwhk#OverheidRijk> <https://lod.gbo-semantiek.nl/belastingen/codesectorindelingwhk#OverheidProvincie> <https://lod.gbo-semantiek.nl/belastingen/codesectorindelingwhk#OverheidGemeente> <https://lod.gbo-semantiek.nl/belastingen/codesectorindelingwhk#WerkEnReIntegratie> ) ;
    skos:definition "De codelijst voor de sectorindeling Werkhervattingskas die de hoogte van de gedifferentieerde premie voor werknemersverzekeringen bepaalt." ;
    skos:exactMatch gbobegrip:CodeSectorindelingWhk ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/belastingen> ;
    skos:note "Doorgaans ruim 60 sectoren; opgenomen is de top 10.",
        "Gebruikt door de Loonheffingenaangifte-rubriek en sector-context; geen direct attribuut binnen dit deelmodel." ;
    mim:datumOpname "2026-05-19" ;
    mim:herkomst "Loonheffingen 2026 + UWV" ;
    mim:herkomstDefinitie "Bron: Gegevensspecificaties aangifte loonheffingen 2026, bijlage (Belastingdienst/UWV, jaargang 2026, definitief). Wettelijke grondslag: Gegevensspecificaties aangifte loonheffingen 2026 bijlage; UWV-Werkgeversadministratie." ;
    linkml:permissible_values <https://lod.gbo-semantiek.nl/belastingen/codesectorindelingwhk#AgrarischBedrijf>,
        <https://lod.gbo-semantiek.nl/belastingen/codesectorindelingwhk#Bouwbedrijf>,
