gbobegrip:BijzonderheidsCodering a owl:Class ;
    rdfs:label "BijzonderheidsCodering" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/krediet/bijzonderheidscode> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/bijzonderheidscodering/bijzonderheidscode> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/bijzonderheidscodering/datumgebeurtenis> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbobegrip:AchterstandRegistratie ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/bijzonderheidscodering/begeleidt> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/bijzonderheidscodering/bijzonderheidscode> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/bijzonderheidscodering/datumgebeurtenis> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/bijzonderheidscodering/begeleidt> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbobegrip:KredietOvereenkomst ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/bijzonderheidscodering/betreft> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/bijzonderheidscodering/betreft> ],
        gbobegrip:KredietFeit ;
    skos:altLabel "B-codering" ;
    skos:altLabel_nl_0_source "CKI-praktijk" ;
    skos:altLabel_nl_0_value "B-codering" ;
    skos:broadMatch gbobegrip:KredietFeit ;
    skos:definition "Een melding aan het Centraal Krediet Informatiesysteem dat een specifieke bijzonderheid is opgetreden bij de afhandeling van een kredietovereenkomst, gecodeerd volgens de waardenset van art. 13 Algemeen Reglement CKI." ;
    skos:definitionSource "Algemeen Reglement CKI 2024-07-01 art. 13" ;
    skos:definitionSourceUri "https://www.bkr.nl/media/4dyezfiz/algemeen-reglement-cki-juli-2024.pdf" ;
    skos:definition_nl "Een melding aan het Centraal Krediet Informatiesysteem dat een specifieke bijzonderheid is opgetreden bij de afhandeling van een kredietovereenkomst." ;
    skos:exactMatch gbo:BijzonderheidsCodering ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/krediet> ;
    skos:note "De vijf codes verwijzen naar aflossingsregeling na achterstand, opgeeisen door zakelijke klant, afboeking door zakelijke klant, onbereikbaarheid van de consument en schriftelijke preventieve betaalregeling voor hypothecair krediet. Combinaties op één achterstand zijn toegestaan: één kredietovereenkomst kan meerdere bijzonderheids-coderingen kennen, elk met een eigen code en datum." ;
    skos:prefLabel_nl "Bijzonderheids codering" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-05-19" ;
    mim:herkomst "CKI" ;
    mim:herkomstDefinitie "Bron: Algemeen Reglement CKI (Stichting BKR), versie 1 juli 2024. Wettelijke grondslag: Algemeen Reglement CKI van 1 juli 2024, art. 13." ;
    mim:populatie "Alle aan CKI gemelde bijzonderheidscoderingen op kredietovereenkomsten, gedurende de bewaartermijn." .

gbobegrip:FinancieleVerplichting a owl:Class ;
    rdfs:label "FinancieleVerplichting" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gbo:Identificatie ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/financieleverplichting/identificatie> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/financieleverplichting/ingangsdatum> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/financieleverplichting/bewaartermijnperiode> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/financieleverplichting/einddatumwerkelijk> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/financieleverplichting/einddatumwerkelijk> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/financieleverplichting/identificatie> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/financieleverplichting/ingangsdatum> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:duration ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/financieleverplichting/bewaartermijnperiode> ],
        [ owl:unionOf ( gbobegrip:KredietOvereenkomst gbobegrip:SchuldhulpverleningTraject ) ] ;
    skos:altLabel "Financial Obligation",
        "Schuld" ;
    skos:altLabel_en_0_source "FIBO Financial Obligation (close, niet exact)" ;
    skos:altLabel_en_0_value "Financial Obligation" ;
    skos:altLabel_nl_0_source "Algemeen taalgebruik; in CKI-context vaak synoniem" ;
    skos:altLabel_nl_0_value "Schuld" ;
    skos:closeMatch <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/FinancialObligation> ;
    skos:closeMatch_0_reviewed "false" ;
    skos:definition "Een verplichting van een natuurlijk persoon of niet-natuurlijk persoon tot het verrichten van een geldelijke prestatie aan een tegenpartij, ontstaan uit overeenkomst of uit een wettelijke regeling." ;
    skos:definitionSource "GBO-Kern, afgeleid uit het verbintenisrecht en het Algemeen Reglement CKI" ;
    skos:definition_nl "Een verplichting van een natuurlijk persoon of niet-natuurlijk persoon tot het verrichten van een geldelijke prestatie aan een tegenpartij, ontstaan uit overeenkomst of uit een wettelijke regeling." ;
    skos:exactMatch gbo:FinancieleVerplichting ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/krediet> ;
    skos:narrowMatch gbobegrip:KredietOvereenkomst,
        gbobegrip:SchuldhulpverleningTraject ;
    skos:needsReview_0 "closeMatch naar FIBO FinancialObligation scope-vergelijking nog niet handmatig geverifieerd." ;
    skos:needsReview_1 "Verhouding met Burgerlijk Wetboek-verbintenisrecht: nu afgeleid; eventueel als formele bron toevoegen." ;
    skos:note "Abstract; concrete varianten zijn KredietOvereenkomst en SchuldhulpverleningTraject. De grens van het concept ligt bij verplichtingen die via een geformaliseerde registratie zichtbaar zijn voor derden. Privaatrechtelijke verplichtingen zonder registratie zoals een persoonlijke lening tussen familieleden vallen er niet onder." ;
    skos:prefLabel_nl "Financiele verplichting" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-05-19" ;
    mim:herkomst "CKI; Wgs" ;
    mim:herkomstDefinitie "GBO-Kern. Afgeleid uit het verbintenisrecht in het Burgerlijk Wetboek en uit de Wet op het financieel toezicht art. 4:32 (sectorregistratie kredietverlening). Operationele invulling: Algemeen Reglement CKI 2024-07-01 art. 1 voor het kredietdomein en Wet gemeentelijke schuldhulpverlening voor het schuldhulpverleningstraject." ;
    mim:populatie "Abstract. Concrete populatie wordt bepaald door de subklassen KredietOvereenkomst en SchuldhulpverleningTraject: alle in CKI of in een gemeentelijke beschikking geformaliseerde geldelijke verplichtingen van een natuurlijk of niet-natuurlijk persoon." .

gbobegrip:FiscaalFeit a owl:Class ;
