gbo:Aangifteperiode a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:intersectionOf ( gbo:Tekst [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^[0-9]{4}(-[MW][0-9]{2})?$" ] ) ] ) ] .

gbo:Breuk a rdfs:Datatype ;
    owl:equivalentClass [ owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^[0-9]+/[0-9]+$" ] ) ] ) ] .

