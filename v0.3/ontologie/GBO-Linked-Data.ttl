            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/kredietovereenkomst/aangegaandoor> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/kredietovereenkomst/looptijdmaanden> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/kredietovereenkomst/rentepercentage> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/kredietovereenkomst/kredietbedragoorspronkelijk> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/datatypes/bedrag> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/kredietovereenkomst/kredietbedragoorspronkelijk> ],
        [ a owl:Restriction ;
