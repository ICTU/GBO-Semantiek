            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/onderneming/heefthandelsnaam> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/onderneming/omschrijving> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:KVKnummer ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/onderneming/kvknummer> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/onderneming/startdatum> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/onderneming/omschrijving> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/onderneming/startdatum> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/onderneming/identificatie> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/onderneming/heefthandelsnaam> ] ;
    skos:definition "Een voldoende zelfstandig optredende organisatorische eenheid waarin door inbreng van arbeid of middelen goederen of diensten aan derden worden geleverd met het oogmerk materieel voordeel te behalen." ;
    skos:exactMatch gbobegrip:Onderneming,
        gbo:Onderneming ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/bedrijven-en-instellingen> ;
    skos:note "De Onderneming is de economische eenheid binnen een MaatschappelijkeActiviteit. Zij heeft geen eigen KVK-nummer in de bron (dat zit op de MA) en krijgt daarom een GBO-eigen UUID, omdat één kvk-nummer meerdere onderscheiden ondernemingen kan dekken. Onderscheid met Activiteit: de Onderneming is de onderneming als geheel (\"viskraam-onderneming\"), Activiteit is een SBI-gecodeerde deelactiviteit (\"46.38.1 Detailhandel in vis\")." ;
    mim:datumOpname "2026-07-01" ;
    mim:herkomst "NHR; Hrb 2008 art. 2" ;
    mim:herkomstDefinitie "Bron: KVK Handelsregister Gegevenscatalogus versie 3.0.4 (1 oktober 2019). Wettelijke grondslag: Handelsregisterbesluit 2008 art. 2 (ondernemingsbegrip); Handelsregisterwet 2007 art. 5; Beleidsregel ondernemingsbegrip in het handelsregister (23 juni 2008)." ;
    mim:populatie "Alle ondernemingen die in Nederland worden gevoerd en die tot een NHR-inschrijving leiden." ;
    mim:uniekeAanduiding "identificatie" .

<https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/rechtstoestand> a owl:Class ;
