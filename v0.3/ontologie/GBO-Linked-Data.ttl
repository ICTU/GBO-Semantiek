        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onderwijs/vooropleiding/verstrekkendeinstellingscode> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbobegrip:OpleidingResultaat ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onderwijs/vooropleiding/isbaseerd> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:CodelijstISO3166 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onderwijs/vooropleiding/landverwerving> ],
        gbobegrip:OpleidingResultaat ;
    owl:hasKey ( <https://lod.gbo-semantiek.nl/onderwijs/opleidingresultaat/behaalddoor> gbo:diplomasoort gbo:behaaldatum <https://lod.gbo-semantiek.nl/onderwijs/vooropleiding/verstrekkendeinstellingscode> ) ;
    skos:altLabel "Instroom-bewijs",
        "Prior qualification",
        "Toelatingsdiploma" ;
    skos:altLabel_en_0_source "ELMO 1.4" ;
    skos:altLabel_en_0_value "Prior qualification" ;
    skos:altLabel_nl_0_source "WHW art. 7.24 (toelatingseisen HO)" ;
    skos:altLabel_nl_0_value "Toelatingsdiploma" ;
    skos:altLabel_nl_1_source "PvE ROD MBO" ;
    skos:altLabel_nl_1_value "Instroom-bewijs" ;
    skos:broadMatch gbobegrip:OpleidingResultaat ;
    skos:definition "Een eerder behaald opleidingsresultaat dat bij een volgende onderwijsdeelname wordt aangereikt als bewijs voor de toelating tot of de instroompositionering in een opleiding." ;
    skos:definitionSource "GBO-Kern, afgeleid uit PvE ROD en sectorwetten" ;
    skos:definition_nl "Een eerder behaald opleidingsresultaat dat bij een volgende onderwijsdeelname wordt aangereikt als bewijs voor de toelating tot of de instroom-positionering in een opleiding." ;
    skos:exactMatch gbo:Vooropleiding ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/onderwijs> ;
    skos:needsReview_0 "Verhouding tot OpleidingResultaat: opslaan als zelfstandig record met sterke koppeling, of als view op OpleidingResultaat in een specifieke rol?" ;
    skos:needsReview_1 "Buitenlandse vooropleidingen: aparte codelijst voor gelijkstelling (DUO doet hier gelijkwaardigheidsbepaling) bevestigen." ;
    skos:note "Vooropleiding is hetzelfde objecttype als OpleidingResultaat, ingezet in een tweede rol. Een MBO-deelname met een HAVO-diploma als vooropleiding wordt in ROD doorgegeven met een verwijzing naar het VO-OpleidingResultaat; analoog voor een HO-deelname met een MBO-niveau-4-diploma als instroom. Buitenlandse vooropleidingen worden niet door ROD geverifieerd tegen een binnenlands resultaat; de instelling beoordeelt de gelijkstelling, doorgaans op basis van een gelijkwaardigheidsverklaring (door DUO of Nuffic afgegeven).",
        "needs_review, brondocument-versie te verifiëren (versiedatums van Handleiding ROD VO en PvE ROD HO nog niet bevestigd)." ;
    skos:prefLabel_nl "Vooropleiding" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-05-19" ;
    mim:herkomst "Register Onderwijsdeelnemers per sector" ;
    mim:herkomstDefinitie "Bron: Programma van Eisen ROD per sector (DUO): PvE ROD PO (versie 2025-07-02), Handleiding ROD VO, PvE ROD MBO en VAVO (versie 2025-12-19) en PvE ROD HO. Wettelijke grondslag: WHW art. 7.24 en volgende (toelatingseisen HO); WEB art. 8.2.1 (toelating MBO); WVO 2020 voor doorstroomeisen binnen VO." ;
    mim:kwaliteit "ROD valideert de combinatie persoon-vooropleiding tegen het bestaande OpleidingResultaat-record waar aanwezig. Buitenlandse vooropleidingen worden aangereikt zonder ROD-tegenpaar; de instelling staat in voor de gelijkstelling." ;
    mim:populatie "Alle door instellingen geregistreerde vooropleidingen bij ROD-inschrijvingen, inclusief in het buitenland behaalde gelijkstellingen." ;
    mim:uniekeAanduiding "Combinatie van persoon, diplomasoort, behaaldatum en verstrekkende instelling." .

gbo:BRINcode a rdfs:Datatype ;
