    skos:prefLabel_nl "Uitkering Wajong" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-05-19" ;
    mim:herkomst "SGR cluster Uitkering" ;
    mim:herkomstDefinitie "Bron: Suwi Gegevensregister (SGR), beheerd door BKWI namens UWV. Wettelijke grondslag: Wajong (drie generaties: oude Wajong, Wajong 2010, Wajong 2015)." ;
    mim:populatie "Alle door UWV toegekende Wajong-uitkeringen aan jonggehandicapten, verdeeld over de drie generaties oude Wajong (toekenningen voor 2010), Wajong 2010 en Wajong 2015." .

gbobegrip:UitkeringZW a owl:Class ;
    rdfs:label "UitkeringZW" ;
