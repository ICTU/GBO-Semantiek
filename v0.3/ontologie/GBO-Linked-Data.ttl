            owl:onProperty <https://lod.gbo-semantiek.nl/waarde-onroerende-zaken/belanghebbende/datumeinde> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Breuk ;
            owl:onProperty <https://lod.gbo-semantiek.nl/waarde-onroerende-zaken/belanghebbende/aandeel> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/waarde-onroerende-zaken/belanghebbende/ispartij> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/waarde-onroerende-zaken/belanghebbende/datumeinde> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/waarde-onroerende-zaken/belanghebbende/datumingang> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/hoofdmodel/partij> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/waarde-onroerende-zaken/belanghebbende/ispartij> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/waarde-onroerende-zaken/belanghebbende/vanwozobject> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/waarde-onroerende-zaken/belanghebbende/aandeel> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/waarde-onroerende-zaken/rolbelanghebbende> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/waarde-onroerende-zaken/belanghebbende/rolbelanghebbende> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/waarde-onroerende-zaken/belanghebbende/datumingang> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/waarde-onroerende-zaken/belanghebbende/rolbelanghebbende> ] ;
    owl:hasKey ( <https://lod.gbo-semantiek.nl/waarde-onroerende-zaken/belanghebbende/ispartij> <https://lod.gbo-semantiek.nl/waarde-onroerende-zaken/belanghebbende/vanwozobject> <https://lod.gbo-semantiek.nl/waarde-onroerende-zaken/belanghebbende/rolbelanghebbende> gbo:datumIngang ) ;
    skos:definition "De geregistreerde rechtsbetrekking tussen een partij en een WOZ-object, waarbij de partij voor de Wet WOZ als eigenaar, gebruiker of beide rollen heeft en daarom de WOZ-beschikking ontvangt voor het object." ;
    skos:exactMatch gbobegrip:Belanghebbende,
        gbo:Belanghebbende ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/waarde-onroerende-zaken> ;
    skos:note "Belanghebbende is de fiscale tegenpartij die de WOZ-beschikking ontvangt en aanslagontvanger is voor afgeleide heffingen. De relatie kan afwijken van de BRK-tenaamstelling (juridisch eigenaar uit het Kadaster) bij erfpacht of opstal, en van de BAG-bewoner (feitelijk gebruiker uit BRP) die niet altijd fiscaal-gebruiker is. GBO gebruikt één relatie met een rol-aanduiding (Eigenaar, Gebruiker, EigenaarEnGebruiker), in plaats van twee afzonderlijke velden op het WOZ-object zoals in HC-WOZ.",
        "needs_review, brondocument-versie te verifieren; er is geen publieke WOZ-Catalogus met citeerbare versie of datum (zie bronnenprioritering)." ;
    mim:datumOpname "2026-04-28" ;
    mim:herkomst "WOZ" ;
    mim:herkomstDefinitie "Bron: LV-WOZ-catalogus (formeel informatiemodel van de Landelijke Voorziening WOZ, beheer Waarderingskamer). Wettelijke grondslag: Wet WOZ art. 24 e.v. (bekendmaking beschikking), Algemene wet bestuursrecht art. 1:2 (algemeen belanghebbende-begrip) en de LV-WOZ-catalogus." ;
    mim:populatie "Alle in de LV-WOZ geregistreerde belanghebbende-relaties: eigenaars en gebruikers van WOZ-objecten, inclusief historische rollen." ;
    mim:uniekeAanduiding "Samengesteld uit (Partij, WOZObject, rolBelanghebbende, datumIngang)" .

xsd:gYear a rdfs:Datatype ;
