        <https://lod.gbo-semantiek.nl/waarde-onroerende-zaken/beschikkingstatus#HogerBeroep>,
        <https://lod.gbo-semantiek.nl/waarde-onroerende-zaken/beschikkingstatus#Onherroepelijk> .

<https://lod.gbo-semantiek.nl/werk-en-inkomen/beslissingsoort> a owl:Class ;
    rdfs:label "BeslissingSoort" ;
    owl:unionOf ( <https://lod.gbo-semantiek.nl/werk-en-inkomen/beslissingsoort#Toekenning> <https://lod.gbo-semantiek.nl/werk-en-inkomen/beslissingsoort#Herziening> <https://lod.gbo-semantiek.nl/werk-en-inkomen/beslissingsoort#Beeindiging> <https://lod.gbo-semantiek.nl/werk-en-inkomen/beslissingsoort#Afwijzing> <https://lod.gbo-semantiek.nl/werk-en-inkomen/beslissingsoort#Bezwaar> <https://lod.gbo-semantiek.nl/werk-en-inkomen/beslissingsoort#Sanctie> ) ;
    skos:definition "De soorten besluit die in het SUWI-stelsel door UWV of SVB kunnen worden genomen over uitkeringen en voorzieningen." ;
    skos:exactMatch gbobegrip:BeslissingSoort ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/werk-en-inkomen> ;
    skos:note "De waardenset onderscheidt de juridisch relevante beslissoorten die een uitkering doen ontstaan, wijzigen of laten eindigen, plus de procedurele soorten afwijzing, beslissing op bezwaar en sanctie. Per uitkering kan een keten van Beslissingen bestaan, beginnend bij een Toekenning en eventueel gevolgd door Herziening of Beeindiging.",
        "Gebruikt door: Beslissing.beslissingSoort.",
        "needs_review brondocument-versie te verifieren (SGR-versie 19.0 en publicatiedatum nog te bevestigen, zie WERK-INKOMEN-OQ-001)." ;
    mim:datumOpname "2026-05-19" ;
    mim:herkomst "SGR" ;
    mim:herkomstDefinitie "Bron: Suwi Gegevensregister (SGR), beheerd door BKWI namens UWV (cluster Beslissing)." ;
    linkml:permissible_values <https://lod.gbo-semantiek.nl/werk-en-inkomen/beslissingsoort#Afwijzing>,
        <https://lod.gbo-semantiek.nl/werk-en-inkomen/beslissingsoort#Beeindiging>,
        <https://lod.gbo-semantiek.nl/werk-en-inkomen/beslissingsoort#Bezwaar>,
        <https://lod.gbo-semantiek.nl/werk-en-inkomen/beslissingsoort#Herziening>,
        <https://lod.gbo-semantiek.nl/werk-en-inkomen/beslissingsoort#Sanctie>,
        <https://lod.gbo-semantiek.nl/werk-en-inkomen/beslissingsoort#Toekenning> .

gbobegrip:BelastingjaarAangifte a owl:Class ;
    rdfs:label "BelastingjaarAangifte" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gbobegrip:NatuurlijkPersoon ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/belastingjaaraangifte/ingedienddoor> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/belastingjaaraangifte/einddatumaangifte> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Numeriek ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/belastingjaaraangifte/belastingjaar> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/belastingjaaraangifte/belastingsoort> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/belastingjaaraangifte/einddatumaangifte> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/belastingjaaraangifte/ingangsdatumaangifte> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/belastingjaaraangifte/ingedienddoor> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/belastingjaaraangifte/belastingjaar> ],
        [ owl:unionOf ( gbobegrip:AangifteErf gbobegrip:AangifteIH gbobegrip:AangifteSchenk ) ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/belastingjaaraangifte/belastingsoort> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/belastingjaaraangifte/ingangsdatumaangifte> ],
        gbobegrip:BelastingAangifte ;
    skos:broadMatch gbobegrip:BelastingAangifte ;
    skos:definition "Een belastingaangifte die op een specifiek belastingjaar betrekking heeft en die de grondslag voor de aanslag over dat jaar vaststelt." ;
    skos:definitionSource "GBO-Kern, afgeleid uit AWR en SBR-NT NT20" ;
    skos:definition_nl "Een belastingaangifte die op een specifiek belastingjaar betrekking heeft en die de grondslag voor de aanslag over dat jaar vaststelt." ;
    skos:exactMatch gbo:BelastingjaarAangifte ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/belastingen> ;
    skos:narrowMatch gbobegrip:AangifteErf,
        gbobegrip:AangifteIH,
        gbobegrip:AangifteSchenk ;
    skos:note "Drie concrete varianten zijn opgenomen: AangifteIH (Wet IB), AangifteSchenk en AangifteErf (Successiewet 1956). Vennootschapsbelasting valt onder de bredere SBR-NT NT20 maar is voor de eerste batch buiten scope." ;
    skos:prefLabel_nl "Belastingjaar aangifte" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-05-19" ;
    mim:herkomst "SBR-NT NT20" ;
    mim:herkomstDefinitie "Bron: SBR Nederlandse Taxonomie NT20 hoofdrelease (release NT20_20251210, 2025-12-10). Wettelijke grondslag: AWR art. 9 jo. de materiele belastingwetten; SBR-NT NT20 entrypoints per belastingsoort en jaar." ;
    mim:populatie "Alle belastingaangiften die op een specifiek belastingjaar betrekking hebben, ongeacht de belastingsoort (IH, Schenk, Erf)." .

