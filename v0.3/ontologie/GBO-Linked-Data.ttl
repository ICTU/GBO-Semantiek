    skos:definition "Een door of namens de overheid aan een natuurlijk persoon toegekende periodieke uitkering op grond van een werknemersverzekering of volksverzekering, ter vervanging of aanvulling van loon." ;
    skos:definitionSource "Wet SUWI; SGR-cluster Uitkering" ;
    skos:definitionSourceUri "https://wetten.overheid.nl/BWBR0013060" ;
    skos:definition_nl "Een door of namens de overheid aan een natuurlijk persoon toegekende periodieke uitkering op grond van een werknemersverzekering of volksverzekering, ter vervanging of aanvulling van loon." ;
    skos:exactMatch gbo:Uitkering ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/werk-en-inkomen> ;
    skos:narrowMatch gbobegrip:UitkeringAOW,
        gbobegrip:UitkeringIVA,
        gbobegrip:UitkeringWGA,
        gbobegrip:UitkeringWIA,
        gbobegrip:UitkeringWW,
        gbobegrip:UitkeringWajong,
        gbobegrip:UitkeringZW ;
    skos:note "Zeven concrete varianten, uitgevoerd door UWV (WW, ZW, WIA, IVA, WGA, Wajong) of SVB (AOW).",
        "needs_review brondocument-versie te verifieren (SGR-versie 19.0 en publicatiedatum nog te bevestigen, zie WERK-INKOMEN-OQ-001)." ;
    skos:prefLabel_nl "Uitkering" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-05-19" ;
    mim:herkomst "SGR cluster Uitkering" ;
    mim:herkomstDefinitie "Bron: Suwi Gegevensregister (SGR), beheerd door BKWI namens UWV. Wettelijke grondslag: Wet SUWI plus de afzonderlijke werknemers- en volksverzekeringswetten (Werkloosheidswet, Ziektewet, Wet WIA, Wajong, AOW)." ;
    mim:populatie "Alle aan natuurlijke personen toegekende periodieke uitkeringen op grond van een werknemersverzekering (WW, ZW, WIA, IVA, WGA, Wajong) of volksverzekering (AOW), uitgevoerd door UWV of SVB." .

