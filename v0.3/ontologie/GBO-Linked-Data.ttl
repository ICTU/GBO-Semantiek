        <https://lod.gbo-semantiek.nl/onderwijs/beurssoort#Studentenreisproduct> .

<https://lod.gbo-semantiek.nl/onderwijs/codestelsel> a owl:Class ;
    rdfs:label "Codestelsel" ;
    owl:unionOf ( <https://lod.gbo-semantiek.nl/onderwijs/codestelsel#CROHO> <https://lod.gbo-semantiek.nl/onderwijs/codestelsel#CREBO> <https://lod.gbo-semantiek.nl/onderwijs/codestelsel#SchoolsoortPO> <https://lod.gbo-semantiek.nl/onderwijs/codestelsel#SchoolsoortVO> ) ;
    skos:definition "Identificatiestelsel waarvan een opleidingscode deel uitmaakt." ;
    skos:exactMatch gbobegrip:Codestelsel ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/onderwijs> ;
    skos:note "Het stelsel bepaalt vorm en betekenis van de opleidingscode. CROHO geldt voor het hoger onderwijs, CREBO voor het middelbaar beroepsonderwijs; voor PO en VO is er geen unieke nationale opleidingscode, daar werkt het deelmodel met een schoolsoort-code." ;
    mim:datumOpname "2026-05-19" ;
    mim:herkomst "GBO-Kern" ;
    mim:herkomstDefinitie "GBO-Kern, op basis van de sectorpraktijk in RIO en de PvE ROD per sector." ;
    linkml:permissible_values <https://lod.gbo-semantiek.nl/onderwijs/codestelsel#CREBO>,
        <https://lod.gbo-semantiek.nl/onderwijs/codestelsel#CROHO>,
        <https://lod.gbo-semantiek.nl/onderwijs/codestelsel#SchoolsoortPO>,
        <https://lod.gbo-semantiek.nl/onderwijs/codestelsel#SchoolsoortVO> .

<https://lod.gbo-semantiek.nl/onroerende-zaken/aardbeslag> a owl:Class ;
    rdfs:label "AardBeslag" ;
    owl:unionOf ( <https://lod.gbo-semantiek.nl/onroerende-zaken/aardbeslag#Conservatoir> <https://lod.gbo-semantiek.nl/onroerende-zaken/aardbeslag#Executoriaal> <https://lod.gbo-semantiek.nl/onroerende-zaken/aardbeslag#Fiscaal> <https://lod.gbo-semantiek.nl/onroerende-zaken/aardbeslag#OverigBeslag> ) ;
    skos:definition "Aard van een op een kadastraal onroerende zaak gelegd beslag, gerelateerd aan de juridische grondslag en het doel ervan." ;
    skos:exactMatch gbobegrip:AardBeslag ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/onroerende-zaken> ;
    skos:note "Alleen van toepassing bij Zekerheidsrecht.typeZekerheidsrecht = Beslag. Conservatoir beslag dient ter zekerstelling vooruitlopend op een gerechtelijke uitspraak; executoriaal beslag volgt op een titel en strekt tot verhaal; fiscaal beslag wordt door de Belastingdienst gelegd op grond van de Invorderingswet." ;
    mim:datumOpname "2026-04-28" ;
    mim:herkomst "BRK" ;
    mim:herkomstDefinitie "Bron: BRK Catalogus, versie 1.0, 10 december 2020. Wettelijke grondslag: Wetboek van Burgerlijke Rechtsvordering (beslagregels); Invorderingswet 1990 (fiscaal beslag); BRK-Catalogus." ;
    linkml:permissible_values <https://lod.gbo-semantiek.nl/onroerende-zaken/aardbeslag#Conservatoir>,
        <https://lod.gbo-semantiek.nl/onroerende-zaken/aardbeslag#Executoriaal>,
        <https://lod.gbo-semantiek.nl/onroerende-zaken/aardbeslag#Fiscaal>,
        <https://lod.gbo-semantiek.nl/onroerende-zaken/aardbeslag#OverigBeslag> .

<https://lod.gbo-semantiek.nl/personen/opschortingbijhouding> a owl:Class ;
    rdfs:label "OpschortingBijhouding" ;
    owl:unionOf ( <https://lod.gbo-semantiek.nl/personen/opschortingbijhouding#Overlijden> <https://lod.gbo-semantiek.nl/personen/opschortingbijhouding#Emigratie> <https://lod.gbo-semantiek.nl/personen/opschortingbijhouding#Vermissing> <https://lod.gbo-semantiek.nl/personen/opschortingbijhouding#FoutAangelegdOfFraude> ) ;
    skos:definition "Reden waarom de bijhouding van een persoonslijst in de basisregistratie is opgeschort." ;
    skos:exactMatch gbobegrip:OpschortingBijhouding ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/personen> ;
    skos:note "Een opgeschorte persoonslijst wordt niet langer bijgewerkt maar blijft beschikbaar voor historisch en juridisch gebruik. De reden van opschorting is een belangrijk datakwaliteits-signaal voor afnemers." ;
    mim:datumOpname "2026-04-28" ;
    mim:herkomst "BRP cat 07 grp 67 Opschorting" ;
    mim:herkomstDefinitie "Bron: Logisch Ontwerp BRP v4.3.0 (RvIG, 15 mei 2023), §4.6 cat 07 grp 67 Opschorting bijhouding. Wettelijke grondslag: Wet BRP." ;
    linkml:permissible_values <https://lod.gbo-semantiek.nl/personen/opschortingbijhouding#Emigratie>,
        <https://lod.gbo-semantiek.nl/personen/opschortingbijhouding#FoutAangelegdOfFraude>,
        <https://lod.gbo-semantiek.nl/personen/opschortingbijhouding#Overlijden>,
        <https://lod.gbo-semantiek.nl/personen/opschortingbijhouding#Vermissing> .

gbobegrip:KredietFeit a owl:Class ;
    rdfs:label "KredietFeit" ;
    rdfs:subClassOf [ owl:unionOf ( gbobegrip:AchterstandRegistratie gbobegrip:BijzonderheidsCodering gbobegrip:HerstelMelding ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/kredietfeit/datumgebeurtenis> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/kredietfeit/datumgebeurtenis> ] ;
    skos:altLabel "Credit Event",
        "Kredietgebeurtenis" ;
    skos:altLabel_en_0_source "FIBO CreditEvent (close)" ;
    skos:altLabel_en_0_value "Credit Event" ;
    skos:altLabel_nl_0_source "Algemeen taalgebruik" ;
    skos:altLabel_nl_0_value "Kredietgebeurtenis" ;
    skos:closeMatch <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditEvent> ;
    skos:closeMatch_0_reviewed "false" ;
    skos:definition "Een tijdens de looptijd van een kredietovereenkomst opgetreden gebeurtenis die op grond van het Algemeen Reglement CKI aan het Centraal Krediet Informatiesysteem wordt gemeld, zoals het ontstaan van een achterstand, het herstel van een achterstand of het optreden van een bijzonderheid." ;
    skos:definitionSource "Algemeen Reglement CKI 2024-07-01 art. 12 en art. 13" ;
    skos:definitionSourceUri "https://www.bkr.nl/media/4dyezfiz/algemeen-reglement-cki-juli-2024.pdf" ;
    skos:definition_nl "Een tijdens de looptijd van een kredietovereenkomst opgetreden gebeurtenis die op grond van het Algemeen Reglement CKI aan het Centraal Krediet Informatiesysteem wordt gemeld." ;
    skos:exactMatch gbo:KredietFeit ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/krediet> ;
    skos:narrowMatch gbobegrip:AchterstandRegistratie,
        gbobegrip:BijzonderheidsCodering,
        gbobegrip:HerstelMelding ;
    skos:needsReview_0 "closeMatch naar FIBO CreditEvent scope-vergelijking nog niet handmatig geverifieerd." ;
    skos:note "Abstract; concrete varianten zijn AchterstandRegistratie, HerstelMelding en BijzonderheidsCodering. Gebeurtenis-modellering is hier gekozen boven attribuut-modellering op de kredietovereenkomst zelf, omdat een overeenkomst in haar looptijd meerdere keren een achterstand kan kennen, gevolgd door herstel, gevolgd door opnieuw een achterstand." ;
    skos:prefLabel_nl "Krediet feit" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-05-19" ;
    mim:herkomst "CKI" ;
    mim:herkomstDefinitie "Bron: Algemeen Reglement CKI (Stichting BKR), versie 1 juli 2024. Wettelijke grondslag: Algemeen Reglement CKI van 1 juli 2024, art. 12 en art. 13." ;
    mim:populatie "Abstract. Concrete populatie wordt bepaald door de subklassen AchterstandRegistratie, HerstelMelding en BijzonderheidsCodering: alle gedurende de looptijd van een kredietovereenkomst aan CKI gemelde gebeurtenissen." .

