        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/kadastraleonroerendezaak/soortgrootte> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
