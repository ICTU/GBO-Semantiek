        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/publiekrechtelijkebeperking/grondslag> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/publiekrechtelijkebeperking/identificatie> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
