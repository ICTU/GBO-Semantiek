        [ a owl:Restriction ;
            owl:allValuesFrom gbo:CodelijstTOOI ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoon/bevoegdgezagcode> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/datatypes/indicatie> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoon/anbistatus> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:CodelijstKVKRechtsvorm ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoon/rechtsvorm> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoon/heeftrechtstoestand> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/rechtstoestand> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoon/heeftrechtstoestand> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/activiteit> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoon/heeftactiviteit> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoon/voertmaatschappelijkeactiviteit> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoon/rechtsvormomschrijving> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoon/hoofdsbicode> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/typemaatschappelijk> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoon/typemaatschappelijk> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/datatypes/indicatie> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoon/heeftonderneming> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoon/aansprakelijkheid> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoon/kvknummer> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:KVKnummer ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoon/kvknummer> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoon/rsin> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoon/heeftnaamgeving> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/naamgeving> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoon/heeftnaamgeving> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/herkomst> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoon/herkomst> ],
        <https://lod.gbo-semantiek.nl/hoofdmodel/partij> ;
    owl:hasKey ( <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoon/rsin> ),
        ( gbo:kvkNummer ) ;
    skos:definition "Een organisatie of rechtsfiguur, geen mens, die als rechtsdragend subject kan deelnemen aan rechtsbetrekkingen. Omvat rechtspersonen (BV, NV, stichting, vereniging, coöperatie, publiekrechtelijke rechtspersoon, kerkgenootschap), entiteiten zonder eigen rechtspersoonlijkheid (eenmanszaak, VOF, CV, maatschap) en buitenlandse entiteiten met activiteit in Nederland." ;
    skos:exactMatch gbobegrip:NietNatuurlijkPersoon,
        gbo:NietNatuurlijkPersoon ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/bedrijven-en-instellingen> ;
    skos:note "Een NietNatuurlijkPersoon heeft precies één eigen inschrijving: de relatie voertMaatschappelijkeActiviteit is 1 -> 1. Het kvk-nummer is daarmee enkelvoudig via de MaatschappelijkeActiviteit af te leiden (kvkNummer := voertMaatschappelijkeActiviteit.kvkNummer); RSIN is de eigen sleutel. Meervoudigheid ontstaat alleen aan de rolzijde (een persoon als eigenaar/vennoot bij meerdere inschrijvingen); dat loopt via de vertegenwoordiging/rol-relatie op Partij, niet via de eigen identiteit van deze NNP.",
        "Een NietNatuurlijkPersoon is vindbaar via twee externe sleutels: rsin en kvkNummer. Beide zijn als unique_key gedeclareerd zodat de pipeline er query-ingangen voor genereert; het van Partij geërfde id (UUID) blijft de interne technische identifier.",
        "NietNatuurlijkPersoon is een concreet objecttype (geen abstract supertype meer). De vroegere functionele subtypen (Bedrijf, Instelling, Overheidsinstelling, MaatschappelijkeInstelling, BuitenlandseEntiteit, OverigeNietNatuurlijkPersoon) zijn vervangen door één afgeleide classificatie op de rechtsvorm-as (attribuut classificatie). Reden: die functionele indeling is géén objecttype in het Handelsregister en niet zonder ambiguïteit als klassenboom af te leiden — een vereniging die commercieel handelt (met onderneming) zou anders zowel Bedrijf als Instelling zijn. Door classificatie deterministisch uit de rechtsvorm af te leiden en het feit \"voert een onderneming\" apart in heeftOnderneming vast te leggen, blijft elke entiteit eenduidig te plaatsen." ;
    mim:datumOpname "2026-07-01" ;
    mim:herkomst "NHR (basis); semantische verbreding buiten-KVK-scope" ;
    mim:herkomstDefinitie "Bron: KVK Handelsregister Gegevenscatalogus versie 3.0.4 (1 oktober 2019). Wettelijke grondslag: Burgerlijk Wetboek boek 2 (rechtspersonen); Handelsregisterwet 2007 art. 10 lid 3 en 12 (RSIN); stelselcatalogus (\"een NietNatuurlijkPersoon is een Persoon met rechten en plichten die geen NatuurlijkPersoon is\"); semantische verbreding zodat ook entiteiten zonder rechtspersoonlijkheid en buiten-KVK-overheidsorganen onder dit type vallen." ;
    mim:populatie "Alle niet-natuurlijke rechtsdragende subjecten relevant voor een overheidsorganisatie, KVK-ingeschreven én entiteiten buiten KVK-scope (overheidsorganen via TOOI/OIN, buitenlandse entiteiten zonder NL-vestiging)." ;
    mim:uniekeAanduiding "rsin; kvkNummer" .

<https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoonclassificatie> a owl:Class ;
    rdfs:label "NietNatuurlijkPersoonClassificatie" ;
    owl:unionOf ( <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoonclassificatie#Bedrijf> <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoonclassificatie#Overheidsinstelling> <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoonclassificatie#MaatschappelijkeInstelling> <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoonclassificatie#BuitenlandseEntiteit> <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoonclassificatie#Overige> ) ;
    skos:definition "Functionele indeling van een niet-natuurlijke persoon, deterministisch afgeleid uit de rechtsvorm. Vervangt de vroegere subtype-hiërarchie." ;
    skos:exactMatch gbobegrip:NietNatuurlijkPersoonClassificatie ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/bedrijven-en-instellingen> ;
    skos:note "De classificatie is een afgeleide, queryable indeling op de rechtsvorm-as; het feit of de entiteit commercieel handelt staat orthogonaal in heeftOnderneming. Zo landt een commercieel handelende vereniging eenduidig als MaatschappelijkeInstelling (op rechtsvorm), met heeftOnderneming = Ja." ;
    mim:datumOpname "2026-07-01" ;
    mim:herkomst "GBO (afgeleid)" ;
    mim:herkomstDefinitie "GBO-classificatie, deterministisch afgeleid uit de KVK-rechtsvorm (zie mim:afleiding op NietNatuurlijkPersoon.classificatie)." ;
    linkml:permissible_values <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoonclassificatie#Bedrijf>,
        <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoonclassificatie#BuitenlandseEntiteit>,
        <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoonclassificatie#MaatschappelijkeInstelling>,
        <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoonclassificatie#Overheidsinstelling>,
        <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/nietnatuurlijkpersoonclassificatie#Overige> .

