            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/uitkeringzw/uitkeringspercentage> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/uitkeringzw/dagloonbedrag> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/uitkeringzw/uitkeringspercentage> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/datatypes/bedrag> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/uitkeringzw/dagloonbedrag> ],
        gbobegrip:Uitkering ;
    skos:broadMatch gbobegrip:Uitkering ;
    skos:definition "Een door UWV aan een zieke werknemer of vangnetter toegekende periodieke uitkering op grond van de Ziektewet, ter vervanging van het door ziekte weggevallen loon." ;
    skos:definitionSource "Ziektewet" ;
    skos:definitionSourceUri "https://wetten.overheid.nl/BWBR0001888" ;
    skos:definition_nl "Een door UWV aan een zieke werknemer of vangnetter toegekende periodieke uitkering op grond van de Ziektewet." ;
    skos:exactMatch gbo:UitkeringZW ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/werk-en-inkomen> ;
    skos:notation "ZW" ;
    skos:note "ZW dekt het vangnet-deel van de ziektevoorziening: uitzendkrachten, oproepkrachten, werklozen en werknemers zonder doorbetalingsplichtige werkgever. Werknemers met een doorbetalingsplichtige werkgever krijgen loondoorbetaling van die werkgever en vallen niet onder ZW.",
        "needs_review brondocument-versie te verifieren (SGR-versie 19.0 en publicatiedatum nog te bevestigen, zie WERK-INKOMEN-OQ-001)." ;
    skos:prefLabel_nl "Uitkering ZW" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-05-19" ;
    mim:herkomst "SGR cluster Uitkering" ;
    mim:herkomstDefinitie "Bron: Suwi Gegevensregister (SGR), beheerd door BKWI namens UWV. Wettelijke grondslag: Ziektewet." ;
    mim:populatie "Alle door UWV toegekende ZW-uitkeringen aan zieke werknemers en vangnetters (uitzendkrachten, oproepkrachten, werklozen, werknemers zonder doorbetalingsplichtige werkgever) ter vervanging van weggevallen loon." .

gbobegrip:ZakelijkKrediet a owl:Class ;
    rdfs:label "ZakelijkKrediet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/maatschappelijkeactiviteit> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/zakelijkkrediet/tenbehoevevan> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:duration ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/zakelijkkrediet/achterstandstermijn> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/krediet/kredietvormcode> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/zakelijkkrediet/kredietvormcode> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/zakelijkkrediet/tenbehoevevan> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/zakelijkkrediet/achterstandstermijn> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/datatypes/bedrag> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/zakelijkkrediet/meldingsdrempel> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/zakelijkkrediet/kredietvormcode> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/zakelijkkrediet/meldingsdrempel> ],
        gbobegrip:KredietOvereenkomst ;
    skos:broadMatch gbobegrip:KredietOvereenkomst ;
    skos:definition "Een kredietovereenkomst aangegaan ten behoeve van een onderneming waarbij sprake is van persoonlijke aansprakelijkheid van een of meer natuurlijke personen, en die boven de meldingsdrempel valt." ;
    skos:definitionSource "Algemeen Reglement CKI 2024-07-01 art. 24" ;
    skos:definitionSourceUri "https://www.bkr.nl/media/4dyezfiz/algemeen-reglement-cki-juli-2024.pdf" ;
    skos:definition_nl "Een kredietovereenkomst aangegaan ten behoeve van een onderneming waarbij sprake is van persoonlijke aansprakelijkheid van een of meer natuurlijke personen." ;
    skos:exactMatch gbo:ZakelijkKrediet ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/krediet> ;
    skos:notation "ZK" ;
    skos:note "Sleutel-criterium voor opname in CKI is persoonlijke aansprakelijkheid. Een BV of NV met eigen rechtspersoonlijkheid zonder borgstelling of medeschuldenaarschap van een natuurlijk persoon wordt niet gemeld. Bij ZZP-ondernemers en eenmanszaken is de aansprakelijkheid prive en zijn de kredieten dus wel meldingsplichtig." ;
    skos:prefLabel_nl "Zakelijk krediet" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-05-19" ;
    mim:herkomst "CKI" ;
    mim:herkomstDefinitie "Bron: Algemeen Reglement CKI (Stichting BKR), versie 1 juli 2024. Wettelijke grondslag: Algemeen Reglement CKI van 1 juli 2024, art. 24." ;
    mim:populatie "Aan CKI gemelde zakelijke kredieten boven EUR 1.000 met persoonlijke aansprakelijkheid van een of meer natuurlijke personen (typisch ZZP en eenmanszaken, en BV/NV met persoonlijke borgstelling)." .

gbobegrip:ZakelijkeOverigeFinancieleVerplichting a owl:Class ;
    rdfs:label "ZakelijkeOverigeFinancieleVerplichting" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/krediet/kredietvormcode> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/zakelijkeoverigefinancieleverplichting/kredietvormcode> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/zakelijkeoverigefinancieleverplichting/achterstandstermijn> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:duration ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/zakelijkeoverigefinancieleverplichting/achterstandstermijn> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/zakelijkeoverigefinancieleverplichting/kredietvormcode> ],
        gbobegrip:KredietOvereenkomst ;
    skos:broadMatch gbobegrip:KredietOvereenkomst ;
    skos:definition "Een overige zakelijke financiele verplichting die niet onder zakelijk krediet valt en waarvan op grond van het Algemeen Reglement CKI alleen negatieve betalingservaringen aan het Centraal Krediet Informatiesysteem worden gemeld." ;
    skos:definitionSource "Algemeen Reglement CKI 2024-07-01 art. 25" ;
    skos:definitionSourceUri "https://www.bkr.nl/media/4dyezfiz/algemeen-reglement-cki-juli-2024.pdf" ;
    skos:definition_nl "Een overige zakelijke financiele verplichting die niet onder ZakelijkKrediet valt en waarvan alleen negatieve betalingservaringen worden gemeld." ;
    skos:exactMatch gbo:ZakelijkeOverigeFinancieleVerplichting ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/krediet> ;
    skos:notation "ZO" ;
    skos:note "Zakelijke tegenhanger van de overige financiele verplichting prive. Net als RO alleen negatieve registratie. Bij combinatie van persoonlijke aansprakelijkheid en zakelijke verplichting kunnen zowel ZK als ZO van toepassing zijn." ;
    skos:prefLabel_nl "Zakelijke overige financiele verplichting" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-05-19" ;
    mim:herkomst "CKI" ;
    mim:herkomstDefinitie "Bron: Algemeen Reglement CKI (Stichting BKR), versie 1 juli 2024. Wettelijke grondslag: Algemeen Reglement CKI van 1 juli 2024, art. 25." ;
    mim:populatie "Aan CKI gemelde overige zakelijke financiele verplichtingen boven EUR 1.000 die niet onder ZakelijkKrediet vallen, voor zover een negatieve betalingservaring is gemeld." .

