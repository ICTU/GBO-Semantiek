            owl:allValuesFrom <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/statusadresseerbaarobject> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/ligplaats/status> ],
        [ a owl:Restriction ;
