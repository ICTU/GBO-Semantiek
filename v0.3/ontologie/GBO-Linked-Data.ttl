gbobegrip:HerstelMelding a owl:Class ;
    rdfs:label "HerstelMelding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/herstelmelding/datumgebeurtenis> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/herstelmelding/datumgebeurtenis> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/herstelmelding/volgtop> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbobegrip:AchterstandRegistratie ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/herstelmelding/volgtop> ],
        gbobegrip:KredietFeit ;
    skos:altLabel "H-melding" ;
    skos:altLabel_nl_0_source "CKI-praktijk" ;
    skos:altLabel_nl_0_value "H-melding" ;
    skos:broadMatch gbobegrip:KredietFeit ;
    skos:definition "Een melding aan het Centraal Krediet Informatiesysteem dat een eerder gemelde achterstand op een kredietovereenkomst is opgelost doordat de kredietnemer zijn betalingsverplichtingen weer volledig nakomt of de gehele schuld heeft voldaan." ;
    skos:definitionSource "Algemeen Reglement CKI 2024-07-01 art. 12 lid 3" ;
    skos:definitionSourceUri "https://www.bkr.nl/media/4dyezfiz/algemeen-reglement-cki-juli-2024.pdf" ;
    skos:definition_nl "Een melding aan het Centraal Krediet Informatiesysteem dat een eerder gemelde achterstand op een kredietovereenkomst is opgelost." ;
    skos:exactMatch gbo:HerstelMelding ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/krediet> ;
    skos:note "De melding markeert het einde van de actieve achterstand. Het moment is bindend voor de bewaartermijn van de oorspronkelijke achterstandsregistratie. Voor de kredietwaardigheidsbeoordeling door derden blijft een gemelde maar herstelde achterstand zichtbaar, doch telt zachter mee dan een lopende." ;
    skos:prefLabel_nl "Herstel melding" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-05-19" ;
    mim:herkomst "CKI" ;
    mim:herkomstDefinitie "Bron: Algemeen Reglement CKI (Stichting BKR), versie 1 juli 2024. Wettelijke grondslag: Algemeen Reglement CKI van 1 juli 2024, art. 12 lid 3." ;
    mim:populatie "Alle aan CKI gemelde herstellen van eerder geregistreerde achterstanden, gedurende de bewaartermijn van de oorspronkelijke achterstand." .

gbobegrip:Inkomstenopgave a owl:Class ;
    rdfs:label "Inkomstenopgave" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/inkomstenopgave/loonsvbedrag> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Aangifteperiode ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/inkomstenopgave/aangifteperiode> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/datatypes/bedrag> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/inkomstenopgave/ingehoudenloonheffing> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/datatypes/bedrag> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/inkomstenopgave/loonsvbedrag> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/inkomstenopgave/ingehoudenloonheffing> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/datatypes/bedrag> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/inkomstenopgave/loonhuidigperiodebedrag> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbobegrip:Inkomstenverhouding ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/inkomstenopgave/binneninkomstenverhouding> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/inkomstenopgave/binneninkomstenverhouding> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/inkomstenopgave/aangifteperiode> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/inkomstenopgave/binnenloonaangifte> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbobegrip:LoonAangifte ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/inkomstenopgave/binnenloonaangifte> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/inkomstenopgave/loonhuidigperiodebedrag> ] ;
    skos:definition "De aggregatie van loongegevens van een werknemer binnen een aangifte loonheffingen over een aangifteperiode, opgebouwd uit een of meer inkomstenperioden en alle daarop horende loonbestanddelen." ;
    skos:definitionSource "Gegevensspecificaties aangifte loonheffingen 2026" ;
    skos:definition_nl "De aggregatie van loongegevens van een werknemer binnen een aangifte loonheffingen over een aangifteperiode." ;
    skos:exactMatch gbo:Inkomstenopgave ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/belastingen> ;
    skos:note "Per inkomstenverhouding en per aangifteperiode is er een inkomstenopgave. De aangifteperiode is doorgaans een maand, vier weken of week, afhankelijk van de loonperiode van de inhoudingsplichtige." ;
    skos:prefLabel_nl "Inkomstenopgave" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-05-19" ;
    mim:herkomst "Loonheffingen 2026" ;
    mim:herkomstDefinitie "Bron: Gegevensspecificaties aangifte loonheffingen 2026 (Belastingdienst/UWV, jaargang 2026, definitief). Wettelijke grondslag: Gegevensspecificaties aangifte loonheffingen 2026." ;
    mim:populatie "Alle aggregaties van loongegevens van een werknemer binnen een aangifte loonheffingen over een aangifteperiode (typisch maand, vier weken of week)." .

gbobegrip:Saneringskrediet a owl:Class ;
    rdfs:label "Saneringskrediet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/saneringskrediet/meldingsdrempel> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/krediet/kredietvormcode> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/saneringskrediet/kredietvormcode> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/datatypes/bedrag> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/saneringskrediet/meldingsdrempel> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:duration ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/saneringskrediet/achterstandstermijn> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/saneringskrediet/achterstandstermijn> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/saneringskrediet/kredietvormcode> ],
        gbobegrip:KredietOvereenkomst ;
    skos:broadMatch gbobegrip:KredietOvereenkomst ;
    skos:definition "Een kredietovereenkomst waarbij een gemeente of een door de gemeente aangewezen kredietbank een persoonlijke lening verstrekt aan een schuldenaar om bestaande schulden te bundelen en gefaseerd af te lossen onder begeleiding van schuldhulpverlening." ;
    skos:definitionSource "Algemeen Reglement CKI 2024-07-01 art. 18" ;
    skos:definitionSourceUri "https://www.bkr.nl/media/4dyezfiz/algemeen-reglement-cki-juli-2024.pdf" ;
    skos:definition_nl "Een kredietovereenkomst waarbij een gemeente of door de gemeente aangewezen kredietbank een persoonlijke lening verstrekt aan een schuldenaar om bestaande schulden te bundelen en gefaseerd af te lossen onder begeleiding van schuldhulpverlening." ;
    skos:exactMatch gbo:Saneringskrediet ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/krediet> ;
    skos:notation "SK" ;
    skos:note "Specifieke vorm van aflopend krediet met een schuldhulpverlenings-doel. Wordt verstrekt door een gemeente of door een door de gemeente aangewezen kredietbank, niet door een commerciele bank. Kan zelfstandig bestaan of onderdeel zijn van een schuldhulpverleningstraject." ;
    skos:prefLabel_nl "Saneringskrediet" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-05-19" ;
    mim:herkomst "CKI" ;
    mim:herkomstDefinitie "Bron: Algemeen Reglement CKI (Stichting BKR), versie 1 juli 2024. Wettelijke grondslag: Algemeen Reglement CKI van 1 juli 2024, art. 18; Wet gemeentelijke schuldhulpverlening." ;
    mim:populatie "Aan CKI gemelde saneringskredieten boven EUR 250, verstrekt door een gemeente of door de gemeente aangewezen kredietbank in het kader van schuldhulpverlening." .

gbo:Alfanumeriek a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:intersectionOf ( gbo:Tekst [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^[A-Za-z0-9]*$" ] ) ] ) ] .

gbo:CodelijstLT33 a rdfs:Datatype ;
    owl:equivalentClass [ owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^[0-9]{4}$" ] ) ] ) ] .

gbo:KVKnummer a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:intersectionOf ( gbo:Tekst [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^[0-9]{8}$" ] ) ] ) ] .

gbo:NEN3610ID a rdfs:Datatype ;
    owl:equivalentClass xsd:string .

gbo:Postcode a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:intersectionOf ( gbo:Tekst [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^[1-9][0-9]{3} ?[A-Z]{2}$" ] ) ] ) ] .

