<https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/onderneming> a owl:Class ;
    rdfs:label "Onderneming" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
