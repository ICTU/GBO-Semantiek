<https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/naamgeving> a owl:Class ;
    rdfs:label "Naamgeving" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/naamgeving/naam> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/naamgeving/ookgenoemd> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/naamgeving/ookgenoemd> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/naamgeving/einddatum> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/naamgeving/startdatum> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/naamgeving/statutairenaam> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/naamgeving/naam> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/naamgeving/startdatum> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/naamgeving/statutairenaam> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/naamgeving/einddatum> ] ;
    skos:definition "De statutaire naam en alternatieve benamingen van een niet-natuurlijke persoon, elk met een eigen geldigheidstermijn." ;
    skos:exactMatch gbobegrip:Naamgeving,
        gbo:Naamgeving ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/bedrijven-en-instellingen> ;
    skos:note "De unieke aanduiding is samengesteld (naam + startdatum) en geldt per NietNatuurlijkPersoon; die scoping is niet als LinkML-identifier of unique_keys uitdrukbaar.",
        "Naamgeving draagt de statutaire naam (bij geregistreerde statuten), de werknaam en alternatieve benamingen (ookGenoemd) van de NNP. Handelsnamen zijn geen onderdeel meer van Naamgeving: die horen bij de Onderneming en de Vestiging (zie Handelsnaam), conform de bron waar statutaire naam en handelsnaam op verschillende objecten liggen." ;
    mim:datumOpname "2026-07-01" ;
    mim:herkomst "NHR" ;
    mim:herkomstDefinitie "Bron: KVK Handelsregister Gegevenscatalogus versie 3.0.4 (1 oktober 2019). Wettelijke grondslag: Handelsregisterwet 2007 art. 11 lid 1 sub b (naamregistratie); KVK Naamgeving-API." ;
    mim:populatie "Alle geldige en historische statutaire naamvoeringen per NNP." ;
    mim:uniekeAanduiding "samengesteld (naam + startdatum per NietNatuurlijkPersoon)" .

