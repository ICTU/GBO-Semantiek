            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/activiteit/soortactiviteit> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/activiteit/sbiversie> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/datatypes/indicatie> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/activiteit/ishoofdactiviteit> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:CodelijstCBSSBI ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/activiteit/sbicode> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/activiteit/omschrijving> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/activiteit/sbicode> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/activiteit/ishoofdactiviteit> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:CodelijstCBSSBI ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/activiteit/sbiversie> ] ;
    skos:definition "Een geregistreerde bedrijfsactiviteit die in het Handelsregister wordt vastgelegd, gecodeerd volgens de CBS Standaard Bedrijfsindeling (SBI), met onderscheid tussen hoofd- en nevenactiviteit per drager." ;
    skos:exactMatch gbobegrip:Activiteit,
        gbo:Activiteit ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/bedrijven-en-instellingen> ;
    skos:note "Activiteit is een zelfstandig gegeven omdat het bij meerdere dragers kan horen: een Vestiging (locatie-specifieke uitvoering) of rechtstreeks een NietNatuurlijkPersoon (rechtspersoon zonder vestiging). Per drager geldt op enig moment ten hoogste één activiteit met soortActiviteit = Hoofd. SBI-codes komen uit een externe codelijst van het CBS en zijn versie-gebonden." ;
    mim:datumOpname "2026-07-01" ;
    mim:herkomst "NHR; CBS Standaard Bedrijfsindeling" ;
    mim:herkomstDefinitie "Bron: KVK Handelsregister Gegevenscatalogus versie 3.0.4 (1 oktober 2019). Wettelijke grondslag: Handelsregisterbesluit 2008 art. 11b en 15 lid 1 sub a (registratie bedrijfsactiviteit); CBS Standaard Bedrijfsindeling (huidig SBI 2008, opvolger SBI 2025) als classificatiestandaard; KVK Basisprofiel- en Vestigingsprofiel-API." ;
    mim:populatie "Alle SBI-gecodeerde bedrijfsactiviteiten geregistreerd op een NHR-Vestiging of rechtstreeks op een rechtspersoon." ;
    mim:uniekeAanduiding "samengesteld (sbiCode + soortActiviteit + drager-context)" .

