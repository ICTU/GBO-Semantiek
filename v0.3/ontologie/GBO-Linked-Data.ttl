gbobegrip:Arbeidsongeschiktheidspercentage a owl:Class ;
    rdfs:label "Arbeidsongeschiktheidspercentage" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsongeschiktheidspercentage/vaststellingsdatum> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbobegrip:Beslissing ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsongeschiktheidspercentage/bepaalddoor> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsongeschiktheidspercentage/duurzaamindicatie> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/datatypes/indicatie> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsongeschiktheidspercentage/duurzaamindicatie> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Decimaal ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsongeschiktheidspercentage/percentage> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsongeschiktheidspercentage/bepaalddoor> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsongeschiktheidspercentage/percentage> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsongeschiktheidspercentage/vaststellingsdatum> ] ;
    skos:altLabel "AO-percentage" ;
    skos:altLabel_nl_0_source "WIA-praktijk" ;
    skos:altLabel_nl_0_value "AO-percentage" ;
    skos:definition "Het door een verzekeringsarts en arbeidsdeskundige vastgestelde percentage waarmee de verdiencapaciteit van een werknemer ten opzichte van zijn oude loon is verminderd, op grond waarvan de WIA-uitkering wordt geclassificeerd in IVA of WGA met hun fasen." ;
    skos:definitionSource "Schattingsbesluit arbeidsongeschiktheidswetten" ;
    skos:definitionSourceUri "https://wetten.overheid.nl/BWBR0011478" ;
    skos:definition_nl "Het door een verzekeringsarts en arbeidsdeskundige vastgestelde percentage waarmee de verdiencapaciteit van een werknemer ten opzichte van zijn oude loon is verminderd." ;
    skos:exactMatch gbo:Arbeidsongeschiktheidspercentage ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/werk-en-inkomen> ;
    skos:note "Het percentage bepaalt de uitkeringstak: 80% of meer duurzaam geeft IVA; 35% tot 80% of 80% of meer niet-duurzaam geeft WGA; minder dan 35% geeft geen recht op WIA. Een herziening kan leiden tot een wijziging van uitkeringssoort en hoogte.",
        "needs_review brondocument-versie te verifieren (SGR-versie 19.0 en publicatiedatum nog te bevestigen, zie WERK-INKOMEN-OQ-001)." ;
    skos:prefLabel_nl "Arbeidsongeschiktheidspercentage" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-05-19" ;
    mim:herkomst "SGR cluster Beslissing" ;
    mim:herkomstDefinitie "Bron: Suwi Gegevensregister (SGR), beheerd door BKWI namens UWV. Wettelijke grondslag: Schattingsbesluit arbeidsongeschiktheidswetten; Wet werk en inkomen naar arbeidsvermogen." ;
    mim:populatie "Alle door UWV vastgestelde arbeidsongeschiktheidspercentages die de basis vormen voor classificatie van een WIA-uitkering in IVA of WGA, inclusief herzieningen." .

gbobegrip:Arbeidsverhouding a owl:Class ;
    rdfs:label "Arbeidsverhouding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverhouding/soortdienstverband> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverhouding/overnameindicatie> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverhouding/heeftwerknemer> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverhouding/einddatum> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/datatypes/indicatie> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverhouding/overnameindicatie> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/belastingen/codeaardarbeidsverhouding> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverhouding/soortdienstverband> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverhouding/beroep> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbobegrip:NatuurlijkPersoon ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverhouding/heeftwerknemer> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverhouding/beroep> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverhouding/ingangsdatum> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverhouding/redeneinde> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/belastingen/coderedeneindearbeidsverhouding> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverhouding/redeneinde> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverhouding/einddatum> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverhouding/proeftijdeinddatum> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverhouding/proeftijdeinddatum> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/maatschappelijkeactiviteit> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverhouding/heeftwerkgever> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbobegrip:Inkomstenverhouding ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverhouding/komttotuitingin> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverhouding/heeftwerkgever> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverhouding/ingangsdatum> ] ;
    skos:altLabel "Arbeidsrelatie",
        "Dienstverband" ;
    skos:altLabel_nl_0_source "Algemeen taalgebruik" ;
    skos:altLabel_nl_0_value "Dienstverband" ;
    skos:altLabel_nl_1_source "Algemeen taalgebruik" ;
    skos:altLabel_nl_1_value "Arbeidsrelatie" ;
    skos:definition "De juridische en feitelijke relatie tussen een natuurlijk persoon als werknemer en een werkgever op grond waarvan arbeid wordt verricht tegen beloning, gedurende een bepaalde of onbepaalde periode." ;
    skos:definitionSource "BW Boek 7 titel 10; SGR-cluster Arbeidsverhouding" ;
    skos:definitionSourceUri "https://wetten.overheid.nl/BWBR0005290" ;
    skos:definition_nl "De juridische en feitelijke relatie tussen een natuurlijk persoon als werknemer en een werkgever op grond waarvan arbeid wordt verricht tegen beloning." ;
    skos:exactMatch gbo:Arbeidsverhouding ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/werk-en-inkomen> ;
    skos:note "Arbeidsverhouding ligt boven Inkomstenverhouding in Belastingen: één arbeidsverhouding kan in de tijd meerdere inkomstenverhoudingen genereren (na contractvernieuwing of bij wisseling van loonperiode-type). De Arbeidsverhouding-attributen leggen de afspraak vast; de bijbehorende inkomstenverhoudingen leggen de uitvoering en de aangifte loonheffingen vast.",
        "needs_review brondocument-versie te verifieren (SGR-versie 19.0 en publicatiedatum nog te bevestigen, zie WERK-INKOMEN-OQ-001)." ;
    skos:prefLabel_nl "Arbeidsverhouding" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-05-19" ;
    mim:herkomst "SGR cluster Arbeidsverhouding" ;
    mim:herkomstDefinitie "Bron: Suwi Gegevensregister (SGR), beheerd door BKWI namens UWV. Wettelijke grondslag: Burgerlijk Wetboek Boek 7 titel 10 (arbeidsovereenkomst); Wet SUWI voor het SUWI-aspect." ;
    mim:populatie "Alle juridische en feitelijke arbeidsrelaties tussen een natuurlijk persoon als werknemer en een onderneming als werkgever die zichtbaar zijn in het Suwi Gegevensregister." .

gbobegrip:ArbeidsverledenFeit a owl:Class ;
    rdfs:label "ArbeidsverledenFeit" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverledenfeit/begindatum> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverledenfeit/betreft> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbobegrip:NatuurlijkPersoon ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverledenfeit/betreft> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverledenfeit/begindatum> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverledenfeit/einddatum> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverledenfeit/soortfeit> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/datatypes/bedrag> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverledenfeit/sv-loonbedrag> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverledenfeit/soortfeit> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverledenfeit/sv-loonbedrag> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/arbeidsverledenfeit/einddatum> ] ;
    skos:altLabel "Loonhistorie-element" ;
    skos:altLabel_nl_0_source "Algemeen taalgebruik" ;
    skos:altLabel_nl_0_value "Loonhistorie-element" ;
    skos:definition "Een afzonderlijk feit in het arbeids- of inkomensverleden van een natuurlijk persoon, zoals een periode in dienst, een periode met uitkering of een leerwerk-periode, dat relevant is voor de berekening van werknemersverzekerings-rechten." ;
    skos:definitionSource "Werkloosheidswet jo. SGR-cluster Arbeidsverhouding" ;
    skos:definitionSourceUri "https://wetten.overheid.nl/BWBR0004045" ;
    skos:definition_nl "Een afzonderlijk feit in het arbeids- of inkomensverleden van een natuurlijk persoon dat relevant is voor de berekening van werknemersverzekerings-rechten." ;
    skos:exactMatch gbo:ArbeidsverledenFeit ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/werk-en-inkomen> ;
    skos:note "Arbeidsverleden bepaalt onder andere de WW-duur. ArbeidsverledenFeit dient als bouwsteen waarmee UWV een arbeidsverleden-overzicht kan opstellen, met feit-typen voor dienstverband, uitkeringsperiode, leerwerk-periode en periode van zelfstandig werk.",
        "needs_review brondocument-versie te verifieren (SGR-versie 19.0 en publicatiedatum nog te bevestigen, zie WERK-INKOMEN-OQ-001)." ;
    skos:prefLabel_nl "Arbeidsverleden feit" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-05-19" ;
    mim:herkomst "SGR cluster Arbeidsverhouding" ;
    mim:herkomstDefinitie "Bron: Suwi Gegevensregister (SGR), beheerd door BKWI namens UWV (cluster Arbeidsverhouding). Wettelijke grondslag: Werkloosheidswet (refertes 26-uit-36-weken en 4-uit-5-jaren)." ;
    mim:populatie "Alle afzonderlijke feiten in het arbeids- of inkomensverleden van een natuurlijk persoon (dienstverband, uitkeringsperiode, leerwerk-periode of periode zelfstandig werk) die relevant zijn voor de berekening van werknemersverzekerings-rechten." .

gbobegrip:AuthentiekInkomen a owl:Class ;
    rdfs:label "AuthentiekInkomen" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/authentiekinkomen/inkomenbedrag> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/belastingen/vaststellingsbroninkomen> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/authentiekinkomen/vaststellingsbron> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/authentiekinkomen/vaststellingsbron> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/authentiekinkomen/vaststellingsdatum> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbobegrip:NatuurlijkPersoon ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/authentiekinkomen/gegrondvestop> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/authentiekinkomen/belastingjaar> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Numeriek ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/authentiekinkomen/belastingjaar> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/datatypes/bedrag> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/authentiekinkomen/inkomenbedrag> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/authentiekinkomen/vaststellingsdatum> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/belastingen/authentiekinkomen/gegrondvestop> ] ;
    skos:altLabel "Authentiek inkomen gegeven",
        "Verzamelinkomen (in BRI-context)" ;
    skos:altLabel_nl_0_source "Stelselcatalogus BRI" ;
    skos:altLabel_nl_0_value "Authentiek inkomen gegeven" ;
    skos:altLabel_nl_1_source "Wet BRI" ;
    skos:altLabel_nl_1_value "Verzamelinkomen (in BRI-context)" ;
    skos:definition "Het door de Belastingdienst vastgestelde verzamelinkomen of belastbaar loon van een natuurlijk persoon over een belastingjaar, aangewezen als authentiek gegeven in de Basisregistratie Inkomen." ;
    skos:definitionSource "Wet basisregistratie inkomen art. 1 jo. art. 4" ;
    skos:definitionSourceUri "https://wetten.overheid.nl/BWBR0028058" ;
    skos:definition_nl "Het door de Belastingdienst vastgestelde verzamelinkomen of belastbaar loon van een natuurlijk persoon over een belastingjaar, aangewezen als authentiek gegeven in de Basisregistratie Inkomen." ;
    skos:exactMatch gbo:AuthentiekInkomen,
        <https://opendata.stelselcatalogus.nl/bri/id/begrip/authentiek_inkomen> ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/belastingen> ;
    skos:note "De BRI is een register met een enkel authentiek gegeven: het inkomen per persoon per belastingjaar. De waarde komt uit een definitief vastgestelde IH-aangifte, of, voor personen zonder IH-aangifte, uit de loonaangifteketen. Afnemers van inkomensgegevens in inkomensafhankelijke regelingen zijn verplicht het BRI-inkomen te gebruiken." ;
    skos:prefLabel_nl "Authentiek inkomen" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-05-19" ;
    mim:herkomst "BRI; Stelselcatalogus" ;
    mim:herkomstDefinitie "Bron: Stelselcatalogus BRI-begrippen (Logius/Belastingdienst, SKOS-publicatie, geraadpleegd 2026-05-19). Wettelijke grondslag: Wet basisregistratie inkomen; Stelselcatalogus BRI, begrip authentiek_inkomen_gegeven." ;
    mim:populatie "Alle door de Belastingdienst vastgestelde authentieke inkomensgegevens per natuurlijk persoon per belastingjaar, opgenomen in de Basisregistratie Inkomen." .

gbobegrip:BorgstellingRol a owl:Class ;
    rdfs:label "BorgstellingRol" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/borgstellingrol/einddatumwerkelijk> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/borgstellingrol/gedragendoor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/borgstellingrol/ingangsdatum> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbobegrip:KredietOvereenkomst ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/borgstellingrol/voorkredietovereenkomst> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbobegrip:NatuurlijkPersoon ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/borgstellingrol/gedragendoor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/datatypes/bedrag> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/borgstellingrol/omvangborg> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/borgstellingrol/ingangsdatum> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/borgstellingrol/einddatumwerkelijk> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/borgstellingrol/omvangborg> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/krediet/borgstellingrol/voorkredietovereenkomst> ] ;
    skos:altLabel "Borg" ;
    skos:altLabel_nl_0_source "Algemeen Reglement CKI art. 1; BW Boek 7 titel 14" ;
    skos:altLabel_nl_0_value "Borg" ;
    skos:broadMatch gbobegrip:Rol ;
    skos:definition "De rol van een natuurlijk persoon die zich heeft verbonden tot het voldoen van de verplichtingen van een kredietnemer onder een specifieke kredietovereenkomst indien de kredietnemer zelf in gebreke blijft." ;
    skos:definitionSource "Algemeen Reglement CKI 2024-07-01 art. 1; BW 7:850" ;
    skos:definitionSourceUri "https://wetten.overheid.nl/BWBR0005290" ;
    skos:definition_nl "De rol van een natuurlijk persoon die zich heeft verbonden tot het voldoen van de verplichtingen van een kredietnemer onder een specifieke kredietovereenkomst indien de kredietnemer zelf in gebreke blijft." ;
    skos:exactMatch gbo:BorgstellingRol ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/krediet> ;
    skos:needsReview_0 "KREDIET-OQ-002: BorgstellingRol als zelfstandig wortel-concept of via [[gbo-core/concepts/algemeen/rol]] modelleren." ;
    skos:note "De borg is geen partij bij de hoofdverplichting maar staat ervoor in. Bij activering, wanneer de kredietnemer zijn verplichtingen niet nakomt en de borg moet betalen, kan de borgstelling als negatieve betalingservaring in CKI verschijnen onder de overige financiele verplichting prive of zakelijk afhankelijk van de aard." ;
    skos:prefLabel_nl "Borgstelling rol" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-05-19" ;
    mim:herkomst "CKI; BW" ;
    mim:herkomstDefinitie "Bron: Algemeen Reglement CKI (Stichting BKR), versie 1 juli 2024. Wettelijke grondslag: Algemeen Reglement CKI van 1 juli 2024, art. 1 (definitie Borg) en art. 23, 25; Burgerlijk Wetboek Boek 7 titel 14 (borgtocht), met name art. 7:850." ;
    mim:populatie "Natuurlijke personen die zich als borg hebben verbonden voor een kredietovereenkomst; in CKI alleen zichtbaar bij activering van de borgstelling via een negatieve betalingservaring." .

