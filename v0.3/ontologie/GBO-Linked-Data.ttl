    skos:additional_0_nl "Voor HO: een opleiding leidt op tot graadverlening (bachelor, master, associate degree)." ;
    skos:additional_0_source "WHW art. 7.3a" ;
    skos:additional_1_as "scopeNote" ;
    skos:additional_1_nl "Voor MBO: een opleiding is gekoppeld aan een kwalificatiedossier en leidt tot een MBO-diploma." ;
    skos:additional_1_source "WEB art. 7.1.3" ;
    skos:altLabel "Curriculum",
        "Onderwijsaanbod",
        "Opleidingseenheid",
        "Programme" ;
    skos:altLabel_en_0_source "ELMO 1.4" ;
    skos:altLabel_en_0_value "Programme" ;
    skos:altLabel_en_1_source "schema.org Course (gerelateerd)" ;
    skos:altLabel_en_1_value "Curriculum" ;
