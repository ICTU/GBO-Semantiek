        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/typevestiging> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/vestiging/typevestiging> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/vestiging/adresseerbaarobjectid> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/vestiging/typevestiging> ] ;
    skos:definition "Een fysieke of functionele locatie waar onder een inschrijving activiteiten worden uitgevoerd, geïdentificeerd door een vestigingsnummer en optioneel gekoppeld aan een BAG-adresseerbaar object." ;
    skos:exactMatch gbobegrip:Vestiging,
        gbo:Vestiging ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/bedrijven-en-instellingen> ;
    skos:note "Vestiging hangt aan de MaatschappelijkeActiviteit. Adres-koppeling loopt via adresseerbaarObjectId naar het deelmodel Adressen en gebouwen; de vestiging zelf bevat geen adres-kenmerken. Het onderscheid commerciële versus niet-commerciële vestiging is afleidbaar (een commerciële vestiging hoort bij een Onderneming); het wordt niet als subtype gemodelleerd." ;
    mim:datumOpname "2026-07-01" ;
    mim:herkomst "NHR; HRW 2007 art. 11 en 14" ;
    mim:herkomstDefinitie "Bron: KVK Handelsregister Gegevenscatalogus versie 3.0.4 (1 oktober 2019). Wettelijke grondslag: Handelsregisterwet 2007 art. 11 en 14 (vestiging als gebouw of complex van gebouwen waar duurzame uitoefening van activiteiten plaatsvindt); KVK Vestigingsprofiel-API; BAG-koppeling via NEN 3610-identificatie." ;
    mim:populatie "Alle vestigingen geregistreerd in het NHR, ten hoogste één hoofdvestiging per inschrijving plus nul of meer nevenvestigingen." ;
    mim:uniekeAanduiding "vestigingsnummer" .

