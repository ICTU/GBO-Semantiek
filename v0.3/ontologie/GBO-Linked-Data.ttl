<https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/typeoverheid> a owl:Class ;
    rdfs:label "TypeOverheid" ;
    owl:unionOf ( <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/typeoverheid#Rijksoverheid> <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/typeoverheid#Ministerie> <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/typeoverheid#Provincie> <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/typeoverheid#Gemeente> <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/typeoverheid#Waterschap> <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/typeoverheid#ZBO> <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/typeoverheid#RWT> <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/typeoverheid#Agentschap> <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/typeoverheid#OverigeOverheid> ) ;
    skos:definition "Bestuurlijke typering van een overheidsinstelling: het bestuurlijke niveau of de bestuursvorm waaraan zij toebehoort." ;
