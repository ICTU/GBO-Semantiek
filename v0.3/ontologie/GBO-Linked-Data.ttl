    skos:additional_0_as "scopeNote" ;
    skos:additional_0_nl "Vaststelling van het feit dat een leerling/student aan een opleiding bij een onderwijsinstelling deelneemt, op grond van de Wet op het onderwijsnummer en bijbehorende sectorwet." ;
    skos:additional_0_source "Wet op het onderwijsnummer art. 1 onder b" ;
    skos:altLabel "Enrollment",
        "Inschrijving",
        "Onderwijsdeelname",
        "Onderwijsinschrijving" ;
    skos:altLabel_en_0_source "ELMO 1.4 (te bevestigen)" ;
    skos:altLabel_en_0_value "Enrollment" ;
    skos:altLabel_nl_0_source "[[gbo-core/sources/duo-gegevenswoordenboek]] (te bevestigen)" ;
    skos:altLabel_nl_0_value "Onderwijsdeelname" ;
    skos:altLabel_nl_1_source "PvE ROD per sector" ;
    skos:altLabel_nl_1_value "Inschrijving" ;
    skos:altLabel_nl_2_source "PvE ROD HO" ;
    skos:altLabel_nl_2_value "Onderwijsinschrijving" ;
    skos:broadMatch gbobegrip:Inschrijving ;
    skos:closeMatch <https://elmo.eu/learner-enrollment> ;
    skos:closeMatch_0_reviewed "false" ;
    skos:definition "De inschrijving van een natuurlijk persoon voor het volgen van een opleiding bij een onderwijsinstelling, geldig binnen een afgebakende periode." ;
    skos:definitionSource "GBO-Kern, afgeleid uit PvE ROD per sector" ;
    skos:definition_nl "De inschrijving van een natuurlijk persoon voor het volgen van een opleiding bij een onderwijsinstelling, geldig binnen een afgebakende periode." ;
    skos:exactMatch gbo:OpleidingDeelname ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/onderwijs> ;
    skos:narrowMatch gbobegrip:BeroepspraktijkvormingPeriode,
        gbobegrip:ModuleInschrijving ;
    skos:needsReview_0 "Concrete XSD-elementnaam per sector nog te bevestigen tegen lokale PvE-XSD-bijlage." ;
    skos:needsReview_1 "altLabel 'Onderwijsdeelname' bron-citatie afhankelijk van Gegevenswoordenboek-DUO-publicatie (zie [[gbo-core/sources/duo-gegevenswoordenboek]], DVTP-DUO-OQ-001)." ;
    skos:needsReview_2 "closeMatch op ELMO-enrollment scope-vergelijking nog niet handmatig geverifieerd." ;
    skos:needsReview_3 "Generalisatie naar [[gbo-core/concepts/bedrijven-en-instellingen/inschrijving]] te bevestigen als concrete modeleerkeuze." ;
    skos:note "OpleidingDeelname is de centrale registratie van het feit dat een persoon onderwijs volgt. Eén deelname dekt één combinatie van Persoon, Opleiding en Onderwijsinstelling binnen één periode. Een wijziging van leerweg of vestiging leidt doorgaans tot een nieuwe deelname; de exacte sectorregel staat in het bijbehorende PvE. Een afgeronde deelname leidt vaak, niet altijd, tot een OpleidingResultaat. Voortijdige beëindiging zonder resultaat heeft een redenUitschrijving uit de sector-specifieke codelijst.",
        "needs_review, brondocument-versie te verifiëren (versiedatums van Handleiding ROD VO en PvE ROD HO nog niet bevestigd)." ;
    skos:prefLabel_nl "Opleiding deelname" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-05-19" ;
    mim:herkomst "Register Onderwijsdeelnemers per sector" ;
    mim:herkomstDefinitie "Bron: Programma van Eisen ROD per sector (DUO): PvE ROD PO (versie 2025-07-02), Handleiding ROD VO, PvE ROD MBO en VAVO (versie 2025-12-19) en PvE ROD HO. Wettelijke grondslag: Wet op het onderwijsnummer art. 1 onder b (deelnemer); sectorwetten WPO, WVO 2020, WEB en WHW; operationele invulling in het Programma van Eisen voor het Register Onderwijsdeelnemers per sector." ;
    mim:kwaliteit "ROD-bijhouding is per sector wettelijk verplicht; de onderwijsinstelling levert via Edukoppeling. Tijdigheid van overgangs- en uitschrijfmeldingen en juistheid van peilmoment worden door DUO teruggekoppeld aan de instelling." ;
    mim:populatie "Alle inschrijvingen die op grond van een sectorwet aan ROD moeten worden gemeld: in PO en VO ingeschreven leerlingen, in MBO en VAVO ingeschreven studenten, in HO ingeschreven studenten en, waar van toepassing, extranei." ;
    mim:uniekeAanduiding "deelnameId" .

gbobegrip:UitkeringWIA a owl:Class ;
    rdfs:label "UitkeringWIA" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/datatypes/bedrag> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/uitkeringwia/dagloonbedrag> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Decimaal ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/uitkeringwia/arbeidsongeschiktheidspercentage> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/uitkeringwia/arbeidsongeschiktheidspercentage> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/uitkeringwia/dagloonbedrag> ],
        gbobegrip:Uitkering ;
    skos:broadMatch gbobegrip:Uitkering ;
    skos:definition "Een door UWV op grond van de Wet werk en inkomen naar arbeidsvermogen toegekende periodieke uitkering aan een werknemer die na een wachttijd van twee jaar van ziekte gedeeltelijk of volledig arbeidsongeschikt is." ;
    skos:definitionSource "Wet WIA" ;
    skos:definitionSourceUri "https://wetten.overheid.nl/BWBR0019057" ;
    skos:definition_nl "Een door UWV op grond van de Wet werk en inkomen naar arbeidsvermogen toegekende periodieke uitkering aan een werknemer die na een wachttijd van twee jaar van ziekte gedeeltelijk of volledig arbeidsongeschikt is." ;
    skos:exactMatch gbo:UitkeringWIA ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/werk-en-inkomen> ;
    skos:narrowMatch gbobegrip:UitkeringIVA,
        gbobegrip:UitkeringWGA ;
    skos:notation "WIA" ;
    skos:note "De WIA splitst zich in IVA (volledig duurzaam arbeidsongeschikt) en WGA (gedeeltelijk of niet-duurzaam arbeidsongeschikt). UitkeringWIA is in dit deelmodel de gemeenschappelijke aanwijzing; concrete varianten zijn UitkeringIVA en UitkeringWGA.",
        "needs_review brondocument-versie te verifieren (SGR-versie 19.0 en publicatiedatum nog te bevestigen, zie WERK-INKOMEN-OQ-001)." ;
    skos:prefLabel_nl "Uitkering WIA" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-05-19" ;
    mim:herkomst "SGR cluster Uitkering" ;
    mim:herkomstDefinitie "Bron: Suwi Gegevensregister (SGR), beheerd door BKWI namens UWV. Wettelijke grondslag: Wet WIA." ;
    mim:populatie "Alle door UWV toegekende WIA-uitkeringen aan werknemers die na de wachttijd van twee jaar ziekte gedeeltelijk of volledig arbeidsongeschikt zijn; concreet uitgesplitst naar UitkeringIVA en UitkeringWGA." .

gbo:UUID a rdfs:Datatype ;
