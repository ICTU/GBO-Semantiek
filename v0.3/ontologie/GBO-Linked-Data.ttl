    skos:definitionSource "AWR art. 53; ODB Belastingdienst" ;
    skos:definitionSourceUri "https://wetten.overheid.nl/BWBR0002320" ;
    skos:definition_nl "Een melding die een renseigneringsplichtige derde aan de Belastingdienst doet over gegevens die relevant zijn voor de belastingheffing van een natuurlijk persoon." ;
    skos:exactMatch gbo:Renseignering ;
