            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/kadastraleonroerendezaak/kadastraalonroerendezaakstatus> ],
        [ owl:unionOf ( <https://lod.gbo-semantiek.nl/onroerende-zaken/appartementsrecht> <https://lod.gbo-semantiek.nl/onroerende-zaken/perceel> ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/onroerende-zaken/soortgrootte> ;
