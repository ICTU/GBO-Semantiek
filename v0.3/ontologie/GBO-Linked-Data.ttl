<https://lod.gbo-semantiek.nl/informatiemodel/gbo.owl.ttl> a owl:Ontology ;
    rdfs:label "gbo" ;
    dcterms:license "https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12" ;
    dcterms:title "GBO-Informatiemodel" ;
    pav:version "0.3.0" ;
    skos:definition "Semantisch informatiemodel van de Gemeenschappelijke Bronontsluiting (GBO): een landelijke, sectoroverstijgende beschrijving van basisgegevens uit overheidsregistraties. Dit LinkML-schema is afgeleid van de documentatie in docs/informatiemodel/gbo-kern/; de documentatie is leidend." .

<https://lod.gbo-semantiek.nl/onroerende-zaken/aantekening> a owl:Class ;
    rdfs:label "Aantekening" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/aantekening/opkadastraleonroerendezaak> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/aantekening/omschrijving> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/aantekening/aardaantekening> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/onroerende-zaken/kadastraleonroerendezaak> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/aantekening/opkadastraleonroerendezaak> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:CodelijstBRK ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/aantekening/aardaantekening> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/aantekening/omschrijving> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/aantekening/datumingang> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/aantekening/datumingang> ],
        <https://lod.gbo-semantiek.nl/hoofdmodel/voorkomen> ;
    skos:definition "Een privaatrechtelijke vermelding bij een kadastraal onroerende zaak die een kwalitatieve verplichting, bewindstelling of soortgelijke notarieel ontstane last vastlegt en die via de Basisregistratie Kadaster kenbaar wordt gemaakt." ;
    skos:exactMatch gbobegrip:Aantekening,
        gbo:Aantekening ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/onroerende-zaken> ;
    skos:note "Aantekening is de privaatrechtelijke tegenhanger van PubliekrechtelijkeBeperking: beide kunnen tegelijk op dezelfde kadastrale onroerende zaak rusten. Een aantekening ontstaat uit een notariële handeling (bijvoorbeeld de vestiging van een kwalitatieve verplichting of een bewindstelling), niet uit een bestuursbesluit." ;
    mim:datumOpname "2026-04-28" ;
    mim:herkomst "BRK (basisregistratie)" ;
    mim:herkomstDefinitie "Bron: BRK Catalogus, versie 1.0, 10 december 2020. Wettelijke grondslag: Kadasterwet art. 17; Burgerlijk Wetboek Boek 6 (kwalitatieve verplichting); BRK-Catalogus (objecttype Aantekening)." ;
    mim:populatie "Alle privaatrechtelijke aantekeningen die op grond van de Kadasterwet bij een kadastraal onroerende zaak in de BRK zijn geregistreerd." ;
    mim:uniekeAanduiding "identificatie" .

<https://lod.gbo-semantiek.nl/onroerende-zaken/appartementsrechtsplitsing> a owl:Class ;
    rdfs:label "Appartementsrechtsplitsing" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/appartementsrechtsplitsing/akteverwijzing> ],
