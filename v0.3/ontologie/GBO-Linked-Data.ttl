            owl:onProperty <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding/inopenbareruimte> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:BAGID ;
            owl:onProperty <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding/identificatie> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding/identificatie> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding/huisletter> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/typeadresseerbaarobject> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding/typeadresseerbaarobject> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Numeriek ;
            owl:onProperty <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding/huisnummer> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding/vormt> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding/status> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Postcode ;
            owl:onProperty <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding/postcode> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding/huisnummertoevoeging> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding/typeadresseerbaarobject> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding/huisnummer> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/statusnummeraanduiding> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding/status> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/nummeraanduiding/huisletter> ],
        <https://lod.gbo-semantiek.nl/hoofdmodel/datakwaliteit>,
        <https://lod.gbo-semantiek.nl/hoofdmodel/voorkomen> ;
    skos:definition "Een door het bevoegde gemeentelijke gezag aan een adresseerbaar object toegekende aanduiding bestaande uit een huisnummer met eventueel een huisletter, een huisnummertoevoeging en een postcode, die samen met de naam van de openbare ruimte en de woonplaats het formele adres vormt." ;
    skos:exactMatch gbobegrip:Nummeraanduiding,
        gbo:Nummeraanduiding ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/adressen-en-gebouwen> ;
    skos:note "Formele adres-eenheid in de BAG. Bundelt huisnummer, huisletter, huisnummertoevoeging en postcode tot één identificeerbaar adres, gekoppeld aan precies één adresseerbaar object en geplaatst in precies één openbare ruimte. Postcode is een eigen kenmerk op Nummeraanduiding, niet afgeleid van openbare ruimte." ;
    mim:datumOpname "2026-04-28" ;
    mim:herkomst "BAG (basisregistratie)" ;
    mim:herkomstDefinitie "Bron: Catalogus BAG 2018 (IMBAG). Wettelijke grondslag: Wet BAG art. 1; Catalogus BAG 2018 §2.3; IMBAG Nummeraanduiding." ;
    mim:populatie "Alle door gemeenten toegekende nummeraanduidingen in Nederland zoals geregistreerd in de BAG, hoofd- en nevenadressen, inclusief uitgegeven en ingetrokken aanduidingen." ;
    mim:uniekeAanduiding "identificatie (BAGID)" .

