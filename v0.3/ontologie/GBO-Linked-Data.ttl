        <https://lod.gbo-semantiek.nl/onroerende-zaken/typepubliekrechtelijkebeperking#Wro_Voorkeursrecht> .

<https://lod.gbo-semantiek.nl/voertuigen/voertuigstatus> a owl:Class ;
    rdfs:label "Voertuigstatus" ;
    owl:unionOf ( <https://lod.gbo-semantiek.nl/voertuigen/voertuigstatus#Tenaamgesteld> <https://lod.gbo-semantiek.nl/voertuigen/voertuigstatus#Bedrijfsvoorraad> <https://lod.gbo-semantiek.nl/voertuigen/voertuigstatus#Geschorst> <https://lod.gbo-semantiek.nl/voertuigen/voertuigstatus#Geexporteerd> <https://lod.gbo-semantiek.nl/voertuigen/voertuigstatus#Gesloopt> <https://lod.gbo-semantiek.nl/voertuigen/voertuigstatus#Vermist> ) ;
    skos:definition "Administratieve status van een voertuig in de Basisregistratie Voertuigen." ;
