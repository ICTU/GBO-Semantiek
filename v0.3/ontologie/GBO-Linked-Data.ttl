            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/maatschappelijkeactiviteit/voertonderneming> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/maatschappelijkeactiviteit/naam> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/vestiging> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/maatschappelijkeactiviteit/heeftvestiging> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/maatschappelijkeactiviteit/datumeersteinschrijving> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/maatschappelijkeactiviteit/naam> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/maatschappelijkeactiviteit/einddatum> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/maatschappelijkeactiviteit/documentdatum> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/maatschappelijkeactiviteit/kvknummer> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/maatschappelijkeactiviteit/startdatum> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:DatumIncompleet ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/maatschappelijkeactiviteit/startdatum> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/maatschappelijkeactiviteit/voertonderneming> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/bedrijven-en-instellingen/maatschappelijkeactiviteit/datumeersteinschrijving> ] ;
    skos:altLabel "Inschrijving",
        "MA" ;
    skos:definition "De in het Handelsregister ingeschreven eenheid van een natuurlijke of niet-natuurlijke persoon, dragend van het KVK-nummer; het geheel van activiteiten dat onder één inschrijving wordt gevoerd." ;
    skos:exactMatch gbobegrip:MaatschappelijkeActiviteit,
        gbo:MaatschappelijkeActiviteit ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/bedrijven-en-instellingen> ;
    skos:note "De MaatschappelijkeActiviteit is de kvk-nummer-dragende inschrijvingseenheid (in de bron valt \"de inschrijving\" hiermee samen; alias Inschrijving). Zij hangt 1:1 aan de NNP die haar voert, kan nul of één Onderneming omvatten en draagt de vestigingen. Continuïteit bij rechtsvormwijziging (eenmanszaak naar BV, fusie, splitsing) loopt via het Partij-supertype, niet via de MA-identiteit.",
        "Onderscheid met Onderneming: de MA is de administratieve inschrijving (het totaal van activiteiten van de persoon); de Onderneming is de economische eenheid daarbinnen (Hrb 2008 art. 2). Een MA kan bestaan zonder onderneming (rechtspersoon zonder onderneming, art. 13 Hrw)." ;
    mim:datumOpname "2026-07-01" ;
    mim:herkomst "NHR; HRW 2007 art. 13" ;
    mim:herkomstDefinitie "Bron: KVK Handelsregister Gegevenscatalogus versie 3.0.4 (1 oktober 2019). Wettelijke grondslag: Handelsregisterwet 2007 art. 13; catalogus-definitie: \"een MaatschappelijkeActiviteit is de activiteit van een NatuurlijkPersoon of NietNatuurlijkPersoon\" en is \"het totaal van alle activiteiten\" van die persoon (dus één per persoon). Het kvk-nummer is het identificerende gegeven van de MA." ;
    mim:populatie "Alle inschrijvingen in het Nederlandse Handelsregister, één per ingeschreven persoon." ;
    mim:uniekeAanduiding "kvkNummer" .

