        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/publiekrechtelijkebeperking/typebeperking> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/publiekrechtelijkebeperking/omschrijving> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/publiekrechtelijkebeperking/documentdatum> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/publiekrechtelijkebeperking/grondslag> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/onroerende-zaken/kadastraleonroerendezaak> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/publiekrechtelijkebeperking/opkadastraleonroerendezaak> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/onroerende-zaken/typepubliekrechtelijkebeperking> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/publiekrechtelijkebeperking/typebeperking> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/publiekrechtelijkebeperking/datumeinde> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:NEN3610ID ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/publiekrechtelijkebeperking/identificatie> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/publiekrechtelijkebeperking/documentdatum> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/publiekrechtelijkebeperking/datumingang> ],
        <https://lod.gbo-semantiek.nl/hoofdmodel/voorkomen> ;
    skos:altLabel "BRK-PB" ;
    skos:definition "Een beperking van het gebruiksrecht op een kadastraal onroerende zaak die voortvloeit uit een publiekrechtelijk besluit van een bestuursorgaan en die op grond van de Wet kenbaarheid publiekrechtelijke beperkingen kenbaar wordt gemaakt via de Basisregistratie Kadaster." ;
    skos:exactMatch gbobegrip:PubliekrechtelijkeBeperking,
        gbo:PubliekrechtelijkeBeperking ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/onroerende-zaken> ;
    skos:note "Eigen registratie binnen de Kadasterwet, los van het zakelijk-recht-cluster. Beperkingen worden opgelegd door de overheid (gemeente, provincie, Rijk) zonder instemming van de eigenaar, in tegenstelling tot privaatrechtelijke aantekeningen die uit notariële handelingen voortvloeien. Eén besluit kan meerdere kadastrale onroerende zaken raken: in dat geval ontstaan meerdere registraties die naar hetzelfde brondocument verwijzen." ;
    mim:datumOpname "2026-04-28" ;
    mim:herkomst "BRK (basisregistratie)" ;
    mim:herkomstDefinitie "Bron: BRK Catalogus, versie 1.0, 10 december 2020. Wettelijke grondslag: Wet kenbaarheid publiekrechtelijke beperkingen onroerende zaken (Wkpb) art. 1; Kadasterwet; BRK-Catalogus (objecttype PubliekrechtelijkeBeperking)." ;
    mim:populatie "Alle door bestuursorganen opgelegde publiekrechtelijke beperkingen die op grond van de Wkpb in de BRK worden geregistreerd (monumentenstatus, voorkeursrecht, onteigening, archeologische bescherming, bodemsanering-plicht en dergelijke)." ;
    mim:uniekeAanduiding "identificatie" .

<https://lod.gbo-semantiek.nl/onroerende-zaken/tenaamstelling> a owl:Class ;
    rdfs:label "Tenaamstelling" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/hoofdmodel/partij> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/tenaamstelling/tenaamgesteldop> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/tenaamstelling/aandeel> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/tenaamstelling/gezamenlijkaandeel> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/tenaamstelling/datumingang> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/onroerende-zaken/zakelijkrecht> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/tenaamstelling/voorzakelijkrecht> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/datatypes/indicatie> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/tenaamstelling/gezamenlijkaandeel> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/tenaamstelling/voorzakelijkrecht> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/tenaamstelling/datumeinde> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/tenaamstelling/datumeinde> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/tenaamstelling/tenaamgesteldop> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Breuk ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/tenaamstelling/aandeel> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/tenaamstelling/datumingang> ],
        <https://lod.gbo-semantiek.nl/hoofdmodel/voorkomen> ;
    owl:hasKey ( <https://lod.gbo-semantiek.nl/onroerende-zaken/tenaamstelling/tenaamgesteldop> <https://lod.gbo-semantiek.nl/onroerende-zaken/tenaamstelling/voorzakelijkrecht> gbo:datumIngang ) ;
    skos:definition "De geregistreerde rechtsbetrekking tussen een rechthebbende partij en een zakelijk recht op een kadastraal onroerende zaak, met vermelding van het aandeel waarmee de partij in het recht deelneemt." ;
    skos:exactMatch gbobegrip:Tenaamstelling,
        gbo:Tenaamstelling ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/onroerende-zaken> ;
    skos:note "MIM-element: Relatieklasse (verdinglijkte relatie).",
        "Tenaamstelling is een verbinding met eigen kenmerken tussen Partij en ZakelijkRecht. Meervoudige eigendomsverhoudingen worden expliciet gemodelleerd: een echtpaar in gemeenschap van goederen krijgt twee tenaamstellingen met gezamenlijkAandeel = ja, mede-eigendom van een vakantiehuis krijgt meerdere tenaamstellingen met elk een breuk-aandeel, en erfopvolging leidt tot een nieuwe tenaamstelling met latere datumIngang terwijl de oude een datumEinde krijgt. De Haal-Centraal-API consolideert Tenaamstelling × ZakelijkRecht × Partij tot één ZakelijkGerechtigde-resource; GBO houdt de drie zaken gescheiden omdat dat rijker is voor historie en meervoudige tenaamstelling." ;
    mim:datumOpname "2026-04-28" ;
    mim:herkomst "BRK (basisregistratie)" ;
    mim:herkomstDefinitie "Bron: BRK Catalogus, versie 1.0, 10 december 2020. Wettelijke grondslag: Kadasterwet; Burgerlijk Wetboek Boek 3 (registergoederen, mede-eigendom art. 166 e.v.); BRK-Catalogus (associatieklasse Tenaamstelling)." ;
    mim:populatie "Alle in de BRK geregistreerde tenaamstellingen, historisch en actueel, die een rechthebbende koppelen aan een zakelijk recht op een kadastraal onroerende zaak." ;
    mim:uniekeAanduiding "Samengesteld uit (Partij, ZakelijkRecht, datumIngang)" .

<https://lod.gbo-semantiek.nl/onroerende-zaken/zekerheidsrecht> a owl:Class ;
    rdfs:label "Zekerheidsrecht" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/zekerheidsrecht/opkadastraleonroerendezaak> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/zekerheidsrecht/datumvestiging> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/onroerende-zaken/typezekerheidsrecht> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/zekerheidsrecht/typezekerheidsrecht> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/zekerheidsrecht/datumvestiging> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/zekerheidsrecht/aardbeslag> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/onroerende-zaken/aardbeslag> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/zekerheidsrecht/aardbeslag> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/zekerheidsrecht/bedrag> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/zekerheidsrecht/typezekerheidsrecht> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/datatypes/bedrag> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/zekerheidsrecht/bedrag> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/onroerende-zaken/kadastraleonroerendezaak> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onroerende-zaken/zekerheidsrecht/opkadastraleonroerendezaak> ],
        <https://lod.gbo-semantiek.nl/hoofdmodel/voorkomen> ;
    skos:definition "Een op een kadastraal onroerende zaak rustend recht dat strekt tot zekerheid van een schuldvordering, te weten een hypotheek of een beslag." ;
    skos:exactMatch gbobegrip:Zekerheidsrecht,
        gbo:Zekerheidsrecht ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/onroerende-zaken> ;
    skos:note "Zekerheidsrecht staat los van ZakelijkRecht omdat het geen eigendomstitel is maar een zekerstelling: bij hypotheek strekt het recht tot zekerheid van een geldlening, bij beslag tot zekerstelling van een vordering. Beide rusten op een kadastraal onroerende zaak en bestaan zelfstandig naast de zakelijke rechten op diezelfde zaak." ;
    mim:datumOpname "2026-04-28" ;
    mim:herkomst "BRK (basisregistratie)" ;
    mim:herkomstDefinitie "Bron: BRK Catalogus, versie 1.0, 10 december 2020. Wettelijke grondslag: Burgerlijk Wetboek Boek 3 titel 9 (recht van pand en hypotheek); Wetboek van Burgerlijke Rechtsvordering (beslagregels); Kadasterwet; BRK-Catalogus." ;
    mim:populatie "Alle hypotheken en beslagen die in Nederland op kadastrale onroerende zaken zijn gevestigd en in de BRK zijn geregistreerd." ;
    mim:uniekeAanduiding "identificatie" .

<https://lod.gbo-semantiek.nl/personen/huwelijk> a owl:Class ;
    rdfs:label "Huwelijk" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/personen/huwelijk/redenontbinding> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbobegrip:NatuurlijkPersoon ;
            owl:onProperty <https://lod.gbo-semantiek.nl/personen/huwelijk/partners> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/personen/huwelijk/partners> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/personen/huwelijk/datumontbinding> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/personen/huwelijk/landvoltrekking> ],
        [ a owl:Restriction ;
