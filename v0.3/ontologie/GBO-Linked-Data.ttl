    mim:datumOpname "2026-05-19" ;
    mim:herkomst "CKI" ;
    mim:herkomstDefinitie "Bron: Algemeen Reglement CKI (Stichting BKR), versie 1 juli 2024. Wettelijke grondslag: Algemeen Reglement CKI van 1 juli 2024, art. 15 en art. 16 tot en met 26." ;
