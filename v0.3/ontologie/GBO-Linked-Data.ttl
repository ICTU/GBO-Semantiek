<https://lod.gbo-semantiek.nl/adressen-en-gebouwen/buurt> a owl:Class ;
    rdfs:label "Buurt" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/buurt/buurtnaam> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:CodelijstCBSWijkBuurt ;
            owl:onProperty <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/buurt/buurtcode> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Vlak ;
            owl:onProperty <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/buurt/geometrie> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/buurt/buurtcode> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/buurt/inwijk> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/buurt/geometrie> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/wijk> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/buurt/inwijk> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Tekst ;
            owl:onProperty <https://lod.gbo-semantiek.nl/adressen-en-gebouwen/buurt/buurtnaam> ] ;
    skos:definition "Een aaneengesloten gedeelte van een wijk waarvan de grenzen primair zijn gebaseerd op topografische elementen, vastgesteld door het Centraal Bureau voor de Statistiek." ;
    skos:exactMatch gbobegrip:Buurt,
        gbo:Buurt ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/adressen-en-gebouwen> ;
    skos:note "Wijk en Buurt staan formeel buiten de BAG (CBS-data); ze zijn in dit deelmodel opgenomen vanwege hun gangbaarheid bij beleids- en analyse-afnemers (sociaal domein, demografie). CBS herziet de buurtgrenzen jaarlijks; mutaties komen via CBS Open Data." ;
    mim:datumOpname "2026-04-28" ;
    mim:herkomst "CBS Wijk- en Buurtkaart" ;
    mim:herkomstDefinitie "CBS Wijk- en Buurtkaart (jaarlijkse vaststelling); NEN 3610 voor het algemene patroon. BAG-formeel kent geen Buurt." ;
    mim:populatie "Alle CBS-buurten binnen Nederland zoals jaarlijks vastgesteld in de CBS Wijk- en Buurtkaart." ;
    mim:uniekeAanduiding "buurtcode (CBS-code)" .

<https://lod.gbo-semantiek.nl/adressen-en-gebouwen/ligplaats> a owl:Class ;
    rdfs:label "Ligplaats" ;
