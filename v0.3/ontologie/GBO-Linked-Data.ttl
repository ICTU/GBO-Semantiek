        <https://www.bkr.nl/media/4dyezfiz/algemeen-reglement-cki-juli-2024.pdf#page=21> ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/krediet> ;
    skos:needsReview_0 "Page-anker voor art. 19 in canonieke PDF te verifieren bij parse-stap." ;
    skos:notation "HY" ;
    skos:note "Afwijkend regime ten opzichte van de overige kredietvormen. Het krediet zelf verschijnt niet in CKI bij aangaan; alleen negatieve betalingservaringen worden geregistreerd. Voor het volledige beeld van de eigenwoning-portefeuille zijn aanvullende bronnen nodig zoals de Nationale Hypotheek Garantie-administratie of de eigen kredietadministratie van de geldverstrekker." ;
    skos:prefLabel_nl "Hypothecair krediet eigen woning" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-05-19" ;
    mim:herkomst "CKI" ;
    mim:herkomstDefinitie "Bron: Algemeen Reglement CKI (Stichting BKR), versie 1 juli 2024. Wettelijke grondslag: Algemeen Reglement CKI van 1 juli 2024, art. 19; aanvullend Wet op het financieel toezicht art. 4:34 (overkrediteringsverbod) en de richtlijn hypothecair krediet 2014/17/EU." ;
    mim:populatie "Hypothecaire kredieten voor de eigen woning waarop een negatieve betalingservaring aan CKI is gemeld; reguliere kredieten zonder achterstand verschijnen niet in CKI." .

gbobegrip:InkomensOndersteuning a owl:Class ;
    rdfs:label "InkomensOndersteuning" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://lod.gbo-semantiek.nl/datatypes/bedrag> ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/inkomensondersteuning/bedragperiode> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/inkomensondersteuning/einddatum> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Datum ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/inkomensondersteuning/ingangsdatum> ],
        [ a owl:Restriction ;
            owl:allValuesFrom gbo:Identificatie ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/inkomensondersteuning/identificatie> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/inkomensondersteuning/bedragperiode> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/inkomensondersteuning/einddatum> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/inkomensondersteuning/identificatie> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/werk-en-inkomen/inkomensondersteuning/ingangsdatum> ],
        [ owl:unionOf ( gbobegrip:Toeslag gbobegrip:Uitkering ) ] ;
    skos:definition "Een door of namens de overheid aan een natuurlijk persoon verstrekte financiele bijdrage met als doel inkomensondersteuning, in de vorm van een inkomensafhankelijke regeling of een sociale-zekerheidsuitkering." ;
    skos:definitionSource "GBO-Kern abstractie boven Awir en sociale-zekerheidsregelingen" ;
    skos:definition_nl "Een door of namens de overheid aan een natuurlijk persoon verstrekte financiele bijdrage met als doel inkomensondersteuning." ;
    skos:exactMatch gbo:InkomensOndersteuning ;
    skos:inScheme <https://lod.gbo-semantiek.nl/informatiemodel/werk-en-inkomen> ;
    skos:narrowMatch gbobegrip:Toeslag,
        gbobegrip:Uitkering ;
    skos:note "Cross-domein algemene categorie boven Toeslag (in Belastingen) en Uitkering (in dit deelmodel). Beide takken delen de basis-eigenschappen rechthebbende natuurlijk persoon, toekenningsperiode, bedrag en grondslag-beschikking; de varianten verschillen in juridische basis, uitvoerings-organisatie en aanvraagprocedure.",
        "belastingen.md documenteert ditzelfde objecttype zonder attributen; de wiki-pagina's moeten nog worden geharmoniseerd (zie ook Toeslag in het deelmodel Belastingen, dat dit supertype deelt)." ;
    skos:prefLabel_nl "Inkomens ondersteuning" ;
    skos:status "proposed" ;
    mim:datumOpname "2026-05-19" ;
    mim:herkomst "Cross-domein abstractie" ;
    mim:herkomstDefinitie "Algemene wet inkomensafhankelijke regelingen (Awir) voor toeslagen; Wet SUWI en de afzonderlijke werknemers- en volksverzekeringswetten voor uitkeringen; GBO-Kern-abstractie." ;
    mim:populatie "Alle door of namens de overheid aan natuurlijke personen verstrekte financiele bijdragen met als doel inkomensondersteuning, omvattende zowel toeslagen (Awir) als sociale-zekerheidsuitkeringen (werknemers- en volksverzekeringen)." .

gbobegrip:OnderwijsInstelling a owl:Class ;
    rdfs:label "OnderwijsInstelling" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onderwijs/onderwijsinstelling/brincode> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://lod.gbo-semantiek.nl/onderwijs/onderwijsinstelling/naam> ],
