            sh:in ( "Betrokkene" "Bronhouder" "Dienstverlener" "Afnemer" "QTSP" "PubEAAProvider" "EUOverheidsdienst" "Toestemmingsvoorziening" "Pseudonimiseringsdienst" ) ;
            sh:maxCount 1 ;
