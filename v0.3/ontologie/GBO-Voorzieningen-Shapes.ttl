            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/rol/partij> ],
        [ sh:datatype xsd:date ;
            sh:description "Datum waarop de rolvervulling ingaat." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/rol/datumingang> ],
        [ sh:datatype xsd:string ;
            sh:description "GBO-eigen identifier voor een rolvervulling." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/rol/id> ;
            sh:pattern "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" ] ;
    sh:targetClass gbovz:Rol .

