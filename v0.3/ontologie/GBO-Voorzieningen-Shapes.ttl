@prefix gbovz: <https://lod.gbo-semantiek.nl/voorzieningen/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gbovz:Attestatie a sh:NodeShape ;
    rdfs:comment "Levering als gekwalificeerde verklaring die in een EUDI-wallet kan worden opgeslagen en later zelfstandig verifieerbaar is." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Identificatie van de levering." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/levering/identificatie> ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Moment waarop de attestatie vervalt." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/attestatie/geldigtot> ],
        [ sh:description "Of het een PubEAA is, uitgegeven onder verantwoordelijkheid van een overheidsorgaan, of een QEAA van een gekwalificeerde vertrouwensdienstverlener." ;
            sh:in ( "PubEAA" "QEAA" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/attestatie/attestatiesoort> ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Moment van levering." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/levering/tijdstip> ],
        [ sh:datatype xsd:string ;
            sh:description "Identificatie van de levering." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/levering/identificatie> ],
        [ sh:class gbovz:Gegevensverzoek ;
            sh:description "Het verzoek waarop deze levering het antwoord is." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/levering/beantwoordt> ],
        [ sh:class gbovz:Rol ;
            sh:description "De rol waarin de attestatie is uitgegeven; de rolsoort is PubEAAProvider of QTSP." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/attestatie/uitgever> ],
        [ sh:class gbovz:Rol ;
            sh:description "De rol waarin de levering wordt ontvangen." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/levering/ontvanger> ],
        [ sh:description "Of het een PubEAA is, uitgegeven onder verantwoordelijkheid van een overheidsorgaan, of een QEAA van een gekwalificeerde vertrouwensdienstverlener." ;
            sh:in ( "PubEAA" "QEAA" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 8 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/attestatie/attestatiesoort> ],
        [ sh:class gbovz:Gegevensverzoek ;
            sh:description "Het verzoek waarop deze levering het antwoord is." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/levering/beantwoordt> ],
        [ sh:class gbovz:Rol ;
            sh:description "De rol waarin de levering wordt ontvangen." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/levering/ontvanger> ],
        [ sh:class gbovz:Rol ;
            sh:description "De rol waarin de attestatie is uitgegeven; de rolsoort is PubEAAProvider of QTSP." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/attestatie/uitgever> ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Moment waarop de attestatie vervalt." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/attestatie/geldigtot> ],
        [ sh:class gbovz:Mapping ;
            sh:description "De mapping waarmee de brongegevens naar de leveringsvorm zijn omgezet; leeg wanneer een-op-een geleverd wordt." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/levering/gebaseerdop> ],
        [ sh:class gbovz:Mapping ;
            sh:description "De mapping waarmee de brongegevens naar de leveringsvorm zijn omgezet; leeg wanneer een-op-een geleverd wordt." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/levering/gebaseerdop> ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Moment van levering." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/levering/tijdstip> ] ;
    sh:targetClass gbovz:Attestatie .

gbovz:BuitenlandseBetrokkene a sh:NodeShape ;
    rdfs:comment "De persoon om wiens gegevens het gaat en die door een EU-overheidsdienst is geidentificeerd, zonder dat een BSN beschikbaar hoeft te zijn." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "De eIDAS-identificator waarmee de betrokkene door de notificerende lidstaat is geidentificeerd." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/buitenlandsebetrokkene/eidasidentificatie> ],
        [ sh:datatype xsd:string ;
            sh:description "De eIDAS-identificator waarmee de betrokkene door de notificerende lidstaat is geidentificeerd." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/buitenlandsebetrokkene/eidasidentificatie> ],
        [ sh:datatype xsd:string ;
            sh:description "De lidstaat die de identiteit heeft vastgesteld." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/buitenlandsebetrokkene/lidstaat> ;
            sh:pattern "^[A-Z]{2}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Uitkomst van de identity matching tegen de Nederlandse registratie." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/buitenlandsebetrokkene/matchstatus> ],
        [ sh:datatype xsd:string ;
            sh:description "GBO-eigen identifier voor een betrokkene." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/betrokkene/id> ;
            sh:pattern "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Uitkomst van de identity matching tegen de Nederlandse registratie." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/buitenlandsebetrokkene/matchstatus> ],
        [ sh:datatype xsd:string ;
            sh:description "De lidstaat die de identiteit heeft vastgesteld." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/buitenlandsebetrokkene/lidstaat> ;
            sh:pattern "^[A-Z]{2}$" ],
        [ sh:datatype xsd:string ;
            sh:description "GBO-eigen identifier voor een betrokkene." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/betrokkene/id> ;
            sh:pattern "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" ] ;
    sh:targetClass gbovz:BuitenlandseBetrokkene .

gbovz:Burger a sh:NodeShape ;
    rdfs:comment "De persoon om wiens gegevens het gaat en die deze wil gebruiken om een dienst af te nemen; in de Nederlandse context altijd identificeerbaar met een BSN." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Het burgerservicenummer van de betrokkene. Wordt nooit aan een private dienstverlener verstrekt; die ontvangt een pseudoniem." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/burger/bsn> ;
            sh:pattern "^[0-9]{9}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Het burgerservicenummer van de betrokkene. Wordt nooit aan een private dienstverlener verstrekt; die ontvangt een pseudoniem." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/burger/bsn> ;
            sh:pattern "^[0-9]{9}$" ],
        [ sh:datatype xsd:string ;
            sh:description "GBO-eigen identifier voor een betrokkene." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/betrokkene/id> ;
            sh:pattern "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Betekenisloze identificator die in plaats van het BSN wordt gebruikt richting private partijen, verstrekt door de pseudonimiseringsdienst." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/burger/pseudoniem> ],
        [ sh:datatype xsd:string ;
            sh:description "GBO-eigen identifier voor een betrokkene." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/betrokkene/id> ;
            sh:pattern "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Betekenisloze identificator die in plaats van het BSN wordt gebruikt richting private partijen, verstrekt door de pseudonimiseringsdienst." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/burger/pseudoniem> ] ;
    sh:targetClass gbovz:Burger .

gbovz:Dienstencatalogus a sh:NodeShape ;
    rdfs:comment "Het register van alle beschikbare diensten met hun scopes." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:date ;
            sh:description "Datum vanaf wanneer deze versie geldt." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/dienstencatalogus/geldigvanaf> ],
        [ sh:class gbovz:Dienst ;
            sh:description "De diensten die in deze catalogusversie staan." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/dienstencatalogus/registreert> ],
        [ sh:datatype xsd:string ;
            sh:description "De instantie die de catalogus heeft vastgesteld." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/dienstencatalogus/vastgestelddoor> ],
        [ sh:datatype xsd:string ;
            sh:description "Versieaanduiding van de catalogus." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/dienstencatalogus/versie> ],
        [ sh:datatype xsd:date ;
            sh:description "Datum vanaf wanneer deze versie geldt." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/dienstencatalogus/geldigvanaf> ],
        [ sh:datatype xsd:string ;
            sh:description "Versieaanduiding van de catalogus." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/dienstencatalogus/versie> ],
        [ sh:datatype xsd:string ;
            sh:description "De instantie die de catalogus heeft vastgesteld." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/dienstencatalogus/vastgestelddoor> ],
        [ sh:class gbovz:Dienst ;
            sh:description "De diensten die in deze catalogusversie staan." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/dienstencatalogus/registreert> ] ;
    sh:targetClass gbovz:Dienstencatalogus .

gbovz:Evidence a sh:NodeShape ;
    rdfs:comment "Levering als bewijsstuk in de vorm die het Once-Only Technical System voorschrijft, bestemd voor een bevoegde autoriteit in een andere lidstaat." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Identificatie van de levering." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/levering/identificatie> ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Moment van levering." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/levering/tijdstip> ],
        [ sh:description "Het SDG-evidence-type waaraan de levering voldoet, als verwijzing naar het Evidence Broker." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/evidence/evidencetype> ],
        [ sh:datatype xsd:string ;
            sh:description "De lidstaat van de bevoegde autoriteit die het bewijs vroeg." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/evidence/aanvragendelidstaat> ;
            sh:pattern "^[A-Z]{2}$" ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Moment van levering." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/levering/tijdstip> ],
        [ sh:description "Het SDG-evidence-type waaraan de levering voldoet, als verwijzing naar het Evidence Broker." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/evidence/evidencetype> ],
        [ sh:datatype xsd:string ;
            sh:description "Identificatie van de levering." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/levering/identificatie> ],
        [ sh:class gbovz:Rol ;
            sh:description "De rol waarin de levering wordt ontvangen." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/levering/ontvanger> ],
        [ sh:class gbovz:Mapping ;
            sh:description "De mapping waarmee de brongegevens naar de leveringsvorm zijn omgezet; leeg wanneer een-op-een geleverd wordt." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/levering/gebaseerdop> ],
        [ sh:class gbovz:Rol ;
            sh:description "De rol waarin de levering wordt ontvangen." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/levering/ontvanger> ],
        [ sh:class gbovz:Gegevensverzoek ;
            sh:description "Het verzoek waarop deze levering het antwoord is." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/levering/beantwoordt> ],
        [ sh:class gbovz:Mapping ;
            sh:description "De mapping waarmee de brongegevens naar de leveringsvorm zijn omgezet; leeg wanneer een-op-een geleverd wordt." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/levering/gebaseerdop> ],
        [ sh:class gbovz:Gegevensverzoek ;
            sh:description "Het verzoek waarop deze levering het antwoord is." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/levering/beantwoordt> ],
        [ sh:datatype xsd:string ;
            sh:description "De lidstaat van de bevoegde autoriteit die het bewijs vroeg." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <https://lod.gbo-semantiek.nl/voorzieningen/evidence/aanvragendelidstaat> ;
            sh:pattern "^[A-Z]{2}$" ] ;
    sh:targetClass gbovz:Evidence .

