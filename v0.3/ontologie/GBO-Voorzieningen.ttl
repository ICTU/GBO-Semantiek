        gbovz:Scope ;
    skos:inScheme gbo:voorzieningen ;
    skos:prefLabel_nl "Scope" ;
    skos:status "proposed" ;
    mim:elementtype "Objecttype" .

gbovz:Toestemming a owl:Class ;
    rdfs:label "Toestemming" ;
    rdfs:subClassOf [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        gbovz:Grondslag ;
    skos:definition "Het expliciete akkoord van de betrokkene dat een specifieke partij een specifieke set gegevens mag opvragen, gebonden aan een scope en een geldigheidsduur." ;
    skos:definitionSource "GBO PSA; AVG art. 4 lid 11 voor het toestemmingsbegrip" ;
    skos:definition_nl "Het expliciete akkoord van de betrokkene dat een specifieke partij een specifieke set gegevens mag opvragen, gebonden aan een scope en een geldigheidsduur." ;
    skos:exactMatch gbobegrip:Toestemming,
        gbovz:Toestemming ;
    skos:inScheme gbo:voorzieningen ;
    skos:note "De aanvrager is een Rol en geen Dienstverlener: in het wallet-patroon vraagt een QTSP of PubEAA-provider de toestemming, niet een private dienstverlener.",
        "Een toestemming is niet overdraagbaar. Wanneer een andere partij de gegevens uiteindelijk gebruikt, is daarvoor een eigen toestemming nodig." ;
    skos:prefLabel_nl "Toestemming" ;
    skos:status "proposed" ;
    mim:elementtype "Objecttype" ;
    mim:herkomst "GBO PSA" .

gbovz:WettelijkeVerplichting a owl:Class ;
    rdfs:label "WettelijkeVerplichting" ;
    rdfs:subClassOf [ ],
        [ ],
        [ ],
        [ ],
        gbovz:Grondslag ;
    skos:definition "De wettelijke bepaling op grond waarvan gegevens zonder toestemming van de betrokkene mogen of moeten worden verstrekt." ;
    skos:definitionSource "GBO (voorstel); voor OOTS de SDG-verordening (EU) 2018/1724" ;
    skos:definition_nl "De wettelijke bepaling op grond waarvan gegevens zonder toestemming van de betrokkene mogen of moeten worden verstrekt." ;
    skos:exactMatch gbobegrip:WettelijkeVerplichting,
        gbovz:WettelijkeVerplichting ;
    skos:inScheme gbo:voorzieningen ;
    skos:note "Dit is de grondslag in het OOTS-patroon: de SDG-verordening verplicht tot verstrekking op verzoek van een bevoegde EU-overheidsdienst." ;
    skos:prefLabel_nl "Wettelijke verplichting" ;
    skos:status "proposed" ;
    mim:elementtype "Objecttype" .

<https://lod.gbo-semantiek.nl/voorzieningen/attestatiesoort#PubEAA> a owl:Class ;
    rdfs:label "PubEAA" ;
    rdfs:subClassOf gbovz:attestatiesoort ;
    skos:definition "Attestatie uitgegeven onder verantwoordelijkheid van een overheidsorgaan." .

<https://lod.gbo-semantiek.nl/voorzieningen/attestatiesoort#QEAA> a owl:Class ;
    rdfs:label "QEAA" ;
    rdfs:subClassOf gbovz:attestatiesoort ;
    skos:definition "Attestatie uitgegeven door een gekwalificeerde vertrouwensdienstverlener." .

<https://lod.gbo-semantiek.nl/voorzieningen/patroonsoort#OOTSEvidence> a owl:Class ;
    rdfs:label "OOTSEvidence" ;
    rdfs:subClassOf gbovz:patroonsoort ;
    skos:definition "Een EU-overheidsdienst vraagt een bewijsstuk op bij een Nederlandse bron; grondslag is de SDG-verordening." .

<https://lod.gbo-semantiek.nl/voorzieningen/patroonsoort#ToestemmingPrivatePartij> a owl:Class ;
    rdfs:label "ToestemmingPrivatePartij" ;
    rdfs:subClassOf gbovz:patroonsoort ;
    skos:definition "Een private dienstverlener haalt gegevens op met toestemming van de betrokkene." .

<https://lod.gbo-semantiek.nl/voorzieningen/patroonsoort#WalletAttestatie> a owl:Class ;
    rdfs:label "WalletAttestatie" ;
    rdfs:subClassOf gbovz:patroonsoort ;
    skos:definition "De betrokkene vraagt een attestatie aan voor opslag in de EUDI-wallet; grondslag is toestemming." .

<https://lod.gbo-semantiek.nl/voorzieningen/rolsoort#Afnemer> a owl:Class ;
    rdfs:label "Afnemer" ;
    rdfs:subClassOf gbovz:rolsoort ;
    skos:definition "De partij die de geleverde gegevens uiteindelijk gebruikt." .

<https://lod.gbo-semantiek.nl/voorzieningen/rolsoort#Betrokkene> a owl:Class ;
    rdfs:label "Betrokkene" ;
    rdfs:subClassOf gbovz:rolsoort ;
    skos:definition "Degene om wiens gegevens het gaat; initieert in het wallet-patroon zelf het verzoek." .

<https://lod.gbo-semantiek.nl/voorzieningen/rolsoort#Bronhouder> a owl:Class ;
    rdfs:label "Bronhouder" ;
    rdfs:subClassOf gbovz:rolsoort ;
    skos:definition "Eigenaar en beheerder van een bronregistratie, verantwoordelijk voor het Policy Enforcement Point dat elk verzoek toetst." .

<https://lod.gbo-semantiek.nl/voorzieningen/rolsoort#Dienstverlener> a owl:Class ;
    rdfs:label "Dienstverlener" ;
    rdfs:subClassOf gbovz:rolsoort ;
    skos:definition "De partij die een dienst aan de betrokkene levert en daarvoor gegevens opvraagt." .

<https://lod.gbo-semantiek.nl/voorzieningen/rolsoort#EUOverheidsdienst> a owl:Class ;
    rdfs:label "EUOverheidsdienst" ;
    rdfs:subClassOf gbovz:rolsoort ;
    skos:definition "Bevoegde autoriteit in een andere lidstaat die via OOTS een bewijsstuk opvraagt." .

<https://lod.gbo-semantiek.nl/voorzieningen/rolsoort#Pseudonimiseringsdienst> a owl:Class ;
    rdfs:label "Pseudonimiseringsdienst" ;
    rdfs:subClassOf gbovz:rolsoort ;
    skos:definition "Voorziening die een BSN omzet naar een pseudoniem voor gebruik door private partijen." .

<https://lod.gbo-semantiek.nl/voorzieningen/rolsoort#PubEAAProvider> a owl:Class ;
    rdfs:label "PubEAAProvider" ;
    rdfs:subClassOf gbovz:rolsoort ;
    skos:definition "Uitgever van een attestatie onder verantwoordelijkheid van een overheidsorgaan." .

<https://lod.gbo-semantiek.nl/voorzieningen/rolsoort#QTSP> a owl:Class ;
    rdfs:label "QTSP" ;
    rdfs:subClassOf gbovz:rolsoort ;
    skos:definition "Gekwalificeerde vertrouwensdienstverlener die een QEAA uitgeeft." .

<https://lod.gbo-semantiek.nl/voorzieningen/rolsoort#Toestemmingsvoorziening> a owl:Class ;
    rdfs:label "Toestemmingsvoorziening" ;
    rdfs:subClassOf gbovz:rolsoort ;
    skos:definition "Voorziening waarin toestemmingen worden vastgelegd en gevalideerd." .

<https://lod.gbo-semantiek.nl/voorzieningen/toestemmingsstatus#Aangevraagd> a owl:Class ;
    rdfs:label "Aangevraagd" ;
    rdfs:subClassOf gbovz:toestemmingsstatus ;
    skos:definition "De toestemming is gevraagd maar nog niet verleend." .

<https://lod.gbo-semantiek.nl/voorzieningen/toestemmingsstatus#Ingetrokken> a owl:Class ;
    rdfs:label "Ingetrokken" ;
    rdfs:subClassOf gbovz:toestemmingsstatus ;
    skos:definition "De betrokkene heeft de toestemming ingetrokken." .

<https://lod.gbo-semantiek.nl/voorzieningen/toestemmingsstatus#Verleend> a owl:Class ;
    rdfs:label "Verleend" ;
    rdfs:subClassOf gbovz:toestemmingsstatus ;
    skos:definition "De betrokkene heeft de toestemming verleend." .

<https://lod.gbo-semantiek.nl/voorzieningen/toestemmingsstatus#Vervallen> a owl:Class ;
    rdfs:label "Vervallen" ;
    rdfs:subClassOf gbovz:toestemmingsstatus ;
    skos:definition "De geldigheidsduur van de toestemming is verstreken." .

