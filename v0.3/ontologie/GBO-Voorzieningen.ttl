@prefix gbo: <https://lod.gbo-semantiek.nl/> .
@prefix gbobegrip: <https://begrippen.gbo-semantiek.nl/id/begrip/> .
@prefix gbovz: <https://lod.gbo-semantiek.nl/voorzieningen/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix mim: <https://lod.gbo-semantiek.nl/def/mim#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

gbovz:aanvragendeLidstaat a owl:DatatypeProperty ;
    rdfs:label "aanvragendeLidstaat" ;
    skos:definition "De lidstaat van de bevoegde autoriteit die het bewijs vroeg." ;
    skos:inScheme gbo:voorzieningen .

gbovz:aanvrager a owl:ObjectProperty ;
    rdfs:label "aanvrager" ;
    skos:definition "De rol waarin een partij de toestemming heeft aangevraagd." ;
    skos:inScheme gbo:voorzieningen .

gbovz:beantwoordDoor a owl:ObjectProperty ;
    rdfs:label "beantwoordDoor" ;
    skos:definition "De rol waarin een partij het verzoek beantwoordt; de rolsoort is Bronhouder." ;
    skos:inScheme gbo:voorzieningen .

gbovz:beantwoordt a owl:ObjectProperty ;
    rdfs:label "beantwoordt" ;
    skos:definition "Het verzoek waarop deze levering het antwoord is." ;
    skos:inScheme gbo:voorzieningen .

gbovz:begrip a owl:DatatypeProperty ;
    rdfs:label "begrip" ;
    skos:definition "Verwijzing naar precies een begrip in het begrippenkader, dat de betekenis van dit gegevenselement vastlegt." ;
    skos:inScheme gbo:voorzieningen .

gbovz:betrokkene a owl:ObjectProperty ;
    rdfs:label "betrokkene" ;
    skos:definition "Degene die de toestemming verleent.",
        "Degene om wiens gegevens het verzoek gaat." ;
    skos:inScheme gbo:voorzieningen .

gbovz:bevat a owl:ObjectProperty ;
    rdfs:label "bevat" ;
    skos:definition "De gegevenselementen die in deze bron voorkomen." ;
    skos:inScheme gbo:voorzieningen .

gbovz:bronElement a owl:ObjectProperty ;
    rdfs:label "bronElement" ;
    skos:definition "De gegevenselementen aan de bronzijde." ;
    skos:inScheme gbo:voorzieningen .

gbovz:bronhouder a owl:ObjectProperty ;
    rdfs:label "bronhouder" ;
    skos:definition "De rol waarin een partij deze bron beheert; de rolsoort is Bronhouder." ;
    skos:inScheme gbo:voorzieningen .

gbovz:bsn a owl:DatatypeProperty ;
    rdfs:label "bsn" ;
    skos:definition "Het burgerservicenummer van de betrokkene. Wordt nooit aan een private dienstverlener verstrekt; die ontvangt een pseudoniem." ;
    skos:inScheme gbo:voorzieningen ;
    mim:authentiek "Authentiek" .

gbovz:context a owl:DatatypeProperty ;
    rdfs:label "context" ;
    skos:definition "De dienst, het interactiepatroon of het stelsel waarbinnen de rol geldt. Een partij kan dezelfde rolsoort in meerdere contexten vervullen." ;
    skos:inScheme gbo:voorzieningen .

gbovz:datatype a owl:DatatypeProperty ;
    rdfs:label "datatype" ;
    skos:definition "Het datatype van het gegevenselement." ;
    skos:inScheme gbo:voorzieningen .

gbovz:datumEinde a owl:DatatypeProperty ;
    rdfs:label "datumEinde" ;
    skos:definition "Datum waarop de rolvervulling eindigt; leeg betekent lopend." ;
    skos:inScheme gbo:voorzieningen .

gbovz:datumIngang a owl:DatatypeProperty ;
    rdfs:label "datumIngang" ;
    skos:definition "Datum waarop de rolvervulling ingaat." ;
    skos:inScheme gbo:voorzieningen .

gbovz:doelbeschrijving a owl:DatatypeProperty ;
    rdfs:label "doelbeschrijving" ;
    skos:definition "Het doel waarvoor deze scope is samengesteld." ;
    skos:inScheme gbo:voorzieningen .

gbovz:doelschema a owl:DatatypeProperty ;
    rdfs:label "doelschema" ;
    skos:definition "Het schema aan de leveringszijde: een SDG-evidence-type of een EUDI-attestatieschema." ;
    skos:inScheme gbo:voorzieningen .

gbovz:eidasIdentificatie a owl:DatatypeProperty ;
    rdfs:label "eidasIdentificatie" ;
    skos:definition "De eIDAS-identificator waarmee de betrokkene door de notificerende lidstaat is geidentificeerd." ;
    skos:inScheme gbo:voorzieningen .

gbovz:evidenceType a owl:DatatypeProperty ;
    rdfs:label "evidenceType" ;
    skos:definition "Het SDG-evidence-type waaraan de levering voldoet, als verwijzing naar het Evidence Broker." ;
    skos:inScheme gbo:voorzieningen .

gbovz:gebaseerdOp a owl:ObjectProperty ;
    rdfs:label "gebaseerdOp" ;
    skos:definition "De mapping waarmee de brongegevens naar de leveringsvorm zijn omgezet; leeg wanneer een-op-een geleverd wordt." ;
    skos:inScheme gbo:voorzieningen .

gbovz:geldigTot a owl:DatatypeProperty ;
    rdfs:label "geldigTot" ;
    skos:definition "Moment waarop de attestatie vervalt.",
        "Moment waarop de toestemming vervalt." ;
    skos:inScheme gbo:voorzieningen .

gbovz:geldigVanaf a owl:DatatypeProperty ;
    rdfs:label "geldigVanaf" ;
    skos:definition "Datum vanaf wanneer deze versie geldt." ;
    skos:inScheme gbo:voorzieningen .

gbovz:gevraagdeScope a owl:ObjectProperty ;
    rdfs:label "gevraagdeScope" ;
    skos:definition "De gevraagde verzameling gegevenselementen; nooit ruimer dan de maximale scope van de dienst." ;
    skos:inScheme gbo:voorzieningen .

gbovz:grondslag a owl:ObjectProperty ;
    rdfs:label "grondslag" ;
    skos:definition "De juridische basis voor dit verzoek: een toestemming of een wettelijke verplichting." ;
    skos:inScheme gbo:voorzieningen ;
    mim:kardinaliteit "1..1" .

gbovz:id a owl:DatatypeProperty ;
    rdfs:label "id" ;
    skos:definition "GBO-eigen identifier voor een betrokkene.",
        "GBO-eigen identifier voor een grondslag.",
        "GBO-eigen identifier voor een rolvervulling." ;
    skos:inScheme gbo:voorzieningen .

gbovz:identificatie a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "identificatie" ;
    skos:definition "Aanduiding van het interactiepatroon.",
        "Identificatie van de bron.",
        "Identificatie van de dienst.",
        "Identificatie van de levering.",
        "Identificatie van de mapping.",
        "Identificatie van de scope.",
        "Identificatie van het gegevenselement.",
        "Identificatie van het verzoek." ;
    skos:inScheme gbo:voorzieningen .

gbovz:initiatiefnemer a owl:ObjectProperty ;
    rdfs:label "initiatiefnemer" ;
    skos:definition "De rol waarin het verzoek is gestart." ;
    skos:inScheme gbo:voorzieningen .

gbovz:initiatorRolsoort a owl:ObjectProperty ;
    rdfs:label "initiatorRolsoort" ;
    skos:definition "De rolsoort die in dit patroon het verzoek initieert." ;
    skos:inScheme gbo:voorzieningen .

gbovz:kardinaliteit a owl:DatatypeProperty ;
    rdfs:label "kardinaliteit" ;
    skos:definition "De kardinaliteit binnen de objectstructuur." ;
    skos:inScheme gbo:voorzieningen .

gbovz:leveringsvorm a owl:DatatypeProperty ;
    rdfs:label "leveringsvorm" ;
    skos:definition "De vorm waarin geleverd wordt: gegevensset, attestatie of evidence." ;
    skos:inScheme gbo:voorzieningen .

gbovz:lidstaat a owl:DatatypeProperty ;
    rdfs:label "lidstaat" ;
    skos:definition "De lidstaat die de identiteit heeft vastgesteld." ;
    skos:inScheme gbo:voorzieningen .

gbovz:matchStatus a owl:DatatypeProperty ;
    rdfs:label "matchStatus" ;
    skos:definition "Uitkomst van de identity matching tegen de Nederlandse registratie." ;
    skos:inScheme gbo:voorzieningen .

gbovz:maximaleScope a owl:ObjectProperty ;
    rdfs:label "maximaleScope" ;
    skos:definition "De ruimst toegestane verzameling gegevenselementen voor deze dienst." ;
    skos:inScheme gbo:voorzieningen .

gbovz:naam a owl:DatatypeProperty ;
    rdfs:label "naam" ;
    skos:definition "Naam van de bron, bijvoorbeeld BRP of BAG.",
        "Naam van de dienst.",
        "Naam van de mapping.",
        "Naam van de scope.",
        "Naam van het gegevenselement.",
        "Naam van het patroon." ;
    skos:inScheme gbo:voorzieningen .

gbovz:omvat a owl:ObjectProperty ;
    rdfs:label "omvat" ;
    skos:definition "De gegevenselementen die de scope omvat." ;
    skos:inScheme gbo:voorzieningen .

gbovz:ontsluit a owl:ObjectProperty ;
    rdfs:label "ontsluit" ;
    skos:definition "De bronnen die voor deze dienst worden ontsloten." ;
    skos:inScheme gbo:voorzieningen .

gbovz:ontvanger a owl:ObjectProperty ;
    rdfs:label "ontvanger" ;
    skos:definition "De rol waarin de levering wordt ontvangen." ;
    skos:inScheme gbo:voorzieningen .

gbovz:ontvangerRolsoort a owl:ObjectProperty ;
    rdfs:label "ontvangerRolsoort" ;
    skos:definition "De rolsoort die de levering ontvangt." ;
    skos:inScheme gbo:voorzieningen .

gbovz:partij a owl:ObjectProperty ;
    rdfs:label "partij" ;
    skos:definition "De partij die deze rol vervult." ;
    skos:inScheme gbo:voorzieningen .

gbovz:pseudoniem a owl:DatatypeProperty ;
    rdfs:label "pseudoniem" ;
    skos:definition "Betekenisloze identificator die in plaats van het BSN wordt gebruikt richting private partijen, verstrekt door de pseudonimiseringsdienst." ;
    skos:inScheme gbo:voorzieningen .

gbovz:regelingURI a owl:DatatypeProperty ;
    rdfs:label "regelingURI" ;
    skos:definition "Verwijzing naar de gepubliceerde regeling." ;
    skos:inScheme gbo:voorzieningen .

gbovz:registreert a owl:ObjectProperty ;
    rdfs:label "registreert" ;
    skos:definition "De diensten die in deze catalogusversie staan." ;
    skos:inScheme gbo:voorzieningen .

gbovz:scope a owl:ObjectProperty ;
    rdfs:label "scope" ;
    skos:definition "De verzameling gegevenselementen waartoe de toestemming beperkt is." ;
    skos:inScheme gbo:voorzieningen .

gbovz:status a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "status" ;
    skos:definition "De actuele status van de toestemming.",
        "De actuele status van het verzoek." ;
    skos:inScheme gbo:voorzieningen .

gbovz:tijdstip a owl:DatatypeProperty ;
    rdfs:label "tijdstip" ;
    skos:definition "Moment van levering.",
        "Moment waarop het verzoek is gedaan." ;
    skos:inScheme gbo:voorzieningen .

gbovz:toegestaneGrondslag a owl:DatatypeProperty ;
    rdfs:label "toegestaneGrondslag" ;
    skos:definition "De grondslagvorm die in dit patroon van toepassing is: toestemming of wettelijke verplichting." ;
    skos:inScheme gbo:voorzieningen .

gbovz:toelichting a owl:DatatypeProperty ;
    rdfs:label "toelichting" ;
    skos:definition "Toelichting op de toepasselijkheid van deze grondslag." ;
    skos:inScheme gbo:voorzieningen .

gbovz:transformatie a owl:DatatypeProperty ;
    rdfs:label "transformatie" ;
    skos:definition "Beschrijving van de omzetting, inclusief eventuele codelijstconversies." ;
    skos:inScheme gbo:voorzieningen .

gbovz:uitgever a owl:ObjectProperty ;
    rdfs:label "uitgever" ;
    skos:definition "De rol waarin de attestatie is uitgegeven; de rolsoort is PubEAAProvider of QTSP." ;
    skos:inScheme gbo:voorzieningen .

gbovz:vastgesteldDoor a owl:DatatypeProperty ;
    rdfs:label "vastgesteldDoor" ;
    skos:definition "De instantie die de catalogus heeft vastgesteld." ;
    skos:inScheme gbo:voorzieningen .

gbovz:versie a owl:DatatypeProperty ;
    rdfs:label "versie" ;
    skos:definition "Versieaanduiding van de catalogus." ;
    skos:inScheme gbo:voorzieningen .

gbovz:volgtPatroon a owl:ObjectProperty ;
    rdfs:label "volgtPatroon" ;
    skos:definition "Het interactiepatroon waarbinnen dit verzoek valt." ;
    skos:inScheme gbo:voorzieningen .

gbovz:wettelijkeBasis a owl:DatatypeProperty ;
    rdfs:label "wettelijkeBasis" ;
    skos:definition "Aanduiding van de wet, verordening of regeling met artikel." ;
    skos:inScheme gbo:voorzieningen .

gbovz:wettelijkeGrondslag a owl:DatatypeProperty ;
    rdfs:label "wettelijkeGrondslag" ;
    skos:definition "De wettelijke basis waarop de bron wordt gehouden." ;
    skos:inScheme gbo:voorzieningen .

gbovz:wettelijkeVerankering a owl:DatatypeProperty ;
    rdfs:label "wettelijkeVerankering" ;
    skos:definition "De AMvB of ministeriele regeling waarin de dienst is vastgelegd." ;
    skos:inScheme gbo:voorzieningen .

gbovz:Attestatie a owl:Class ;
    rdfs:label "Attestatie" ;
    rdfs:subClassOf [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        gbovz:Levering ;
    skos:definition "Levering als gekwalificeerde verklaring die in een EUDI-wallet kan worden opgeslagen en later zelfstandig verifieerbaar is." ;
    skos:definitionSource "eIDAS2 (verordening (EU) 2024/1183) en het Architecture and Reference Framework" ;
    skos:definition_nl "Levering als gekwalificeerde verklaring die in een EUDI-wallet kan worden opgeslagen en later zelfstandig verifieerbaar is." ;
    skos:exactMatch gbobegrip:Attestatie,
        gbovz:Attestatie ;
    skos:inScheme gbo:voorzieningen ;
    skos:prefLabel_nl "Attestatie" ;
    skos:status "proposed" ;
    mim:elementtype "Objecttype" ;
    mim:herkomst "eIDAS2 / ARF" .

gbovz:Bron a owl:Class ;
    rdfs:label "Bron" ;
    rdfs:subClassOf [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ] ;
    skos:definition "Een registratie of gegevensverzameling bij een bronhouder, met een wettelijke grondslag." ;
    skos:definitionSource "GBO PSA" ;
    skos:definition_nl "Een registratie of gegevensverzameling bij een bronhouder, met een wettelijke grondslag." ;
    skos:exactMatch gbobegrip:Bron,
        gbovz:Bron ;
    skos:inScheme gbo:voorzieningen ;
    skos:prefLabel_nl "Bron" ;
    skos:status "proposed" ;
    mim:elementtype "Objecttype" .

gbovz:BuitenlandseBetrokkene a owl:Class ;
    rdfs:label "BuitenlandseBetrokkene" ;
    rdfs:subClassOf [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        gbovz:Betrokkene ;
    skos:definition "De persoon om wiens gegevens het gaat en die door een EU-overheidsdienst is geidentificeerd, zonder dat een BSN beschikbaar hoeft te zijn." ;
    skos:definitionSource "GBO (voorstel), afgeleid uit de SDG-verordening en het OOTS-identity-matching-patroon" ;
    skos:definition_nl "De persoon om wiens gegevens het gaat en die door een EU-overheidsdienst is geidentificeerd, zonder dat een burgerservicenummer beschikbaar hoeft te zijn." ;
    skos:exactMatch gbobegrip:BuitenlandseBetrokkene,
        gbovz:BuitenlandseBetrokkene ;
    skos:inScheme gbo:voorzieningen ;
    skos:note "Het koppelen van de buitenlandse identiteit aan een persoon in een Nederlandse registratie gebeurt via identity matching. Dat proces is een voorziening; hier wordt alleen het resultaat vastgelegd." ;
    skos:prefLabel_nl "Buitenlandse betrokkene" ;
    skos:status "proposed" ;
    mim:elementtype "Objecttype" ;
    mim:herkomst "OOTS (SDG-verordening)" .

gbovz:Burger a owl:Class ;
    rdfs:label "Burger" ;
    rdfs:subClassOf [ ],
        [ ],
        [ ],
        [ ],
        gbovz:Betrokkene ;
    skos:definition "De persoon om wiens gegevens het gaat en die deze wil gebruiken om een dienst af te nemen; in de Nederlandse context altijd identificeerbaar met een BSN." ;
    skos:definitionSource "GBO PSA" ;
    skos:definition_nl "De persoon om wiens gegevens het gaat en die deze wil gebruiken om een dienst af te nemen; in de Nederlandse context altijd identificeerbaar met een burgerservicenummer." ;
    skos:exactMatch gbobegrip:Burger,
        gbovz:Burger ;
    skos:inScheme gbo:voorzieningen ;
    skos:prefLabel_nl "Burger" ;
    skos:status "proposed" ;
    mim:elementtype "Objecttype" ;
    mim:herkomst "GBO PSA" .

gbovz:Dienst a owl:Class ;
    rdfs:label "Dienst" ;
    rdfs:subClassOf [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ] ;
    skos:definition "Een afgebakend doel waarvoor gegevens mogen worden opgevraagd, wettelijk verankerd en met een maximale scope." ;
    skos:definitionSource "GBO PSA" ;
    skos:definition_nl "Een afgebakend doel waarvoor gegevens mogen worden opgevraagd, wettelijk verankerd en met een maximale scope." ;
    skos:exactMatch gbobegrip:Dienst,
        gbovz:Dienst ;
    skos:inScheme gbo:voorzieningen ;
    skos:prefLabel_nl "Dienst" ;
    skos:status "proposed" ;
    mim:elementtype "Objecttype" .

gbovz:Dienstencatalogus a owl:Class ;
    rdfs:label "Dienstencatalogus" ;
    rdfs:subClassOf [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ] ;
    skos:definition "Het register van alle beschikbare diensten met hun scopes." ;
    skos:definitionSource "GBO PSA" ;
    skos:definition_nl "Het register van alle beschikbare diensten met hun scopes." ;
    skos:exactMatch gbobegrip:Dienstencatalogus,
        gbovz:Dienstencatalogus ;
    skos:inScheme gbo:voorzieningen ;
    skos:note "Nadrukkelijk een register van diensten, niet van losse gegevens." ;
    skos:prefLabel_nl "Dienstencatalogus" ;
    skos:status "proposed" ;
    mim:elementtype "Objecttype" .

gbovz:Evidence a owl:Class ;
    rdfs:label "Evidence" ;
    rdfs:subClassOf [ ],
        [ ],
        [ ],
        [ ],
        gbovz:Levering ;
    skos:altLabel_nl_0_source "Nederlandse aanduiding in de SDG-context" ;
    skos:altLabel_nl_0_value "Bewijsstuk" ;
    skos:definition "Levering als bewijsstuk in de vorm die het Once-Only Technical System voorschrijft, bestemd voor een bevoegde autoriteit in een andere lidstaat." ;
    skos:definitionSource "SDG-verordening (EU) 2018/1724 en het OOTS Evidence Broker" ;
    skos:definition_nl "Levering als bewijsstuk in de vorm die het Once-Only Technical System voorschrijft, bestemd voor een bevoegde autoriteit in een andere lidstaat." ;
    skos:exactMatch gbobegrip:Evidence,
        gbovz:Evidence ;
    skos:inScheme gbo:voorzieningen ;
    skos:prefLabel_nl "Evidence" ;
    skos:status "proposed" ;
    mim:elementtype "Objecttype" ;
    mim:herkomst "OOTS (SDG-verordening)" .

gbovz:Gegevenselement a owl:Class ;
    rdfs:label "Gegevenselement" ;
    rdfs:subClassOf [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ] ;
    skos:definition "De kleinste adresseerbare eenheid van data. Verwijst naar precies een begrip in het begrippenkader en voegt structuurinformatie toe." ;
    skos:definitionSource "GBO PSA" ;
    skos:definition_nl "De kleinste adresseerbare eenheid van data, die naar precies een begrip verwijst en daar structuurinformatie aan toevoegt." ;
    skos:exactMatch gbobegrip:Gegevenselement,
        gbovz:Gegevenselement ;
    skos:inScheme gbo:voorzieningen ;
    skos:prefLabel_nl "Gegevenselement" ;
    skos:status "proposed" ;
    mim:elementtype "Objecttype" .

gbovz:Gegevensset a owl:Class ;
    rdfs:label "Gegevensset" ;
    rdfs:subClassOf gbovz:Levering ;
    skos:definition "Levering als verzameling gegevenselementen in het GBO-formaat, zonder juridische waarmerking." ;
    skos:definitionSource "GBO (voorstel)" ;
    skos:definition_nl "Levering als verzameling gegevenselementen in het GBO-formaat, zonder juridische waarmerking." ;
    skos:exactMatch gbobegrip:Gegevensset,
        gbovz:Gegevensset ;
    skos:inScheme gbo:voorzieningen ;
    skos:note "Dit is de leveringsvorm in het patroon waarin een private dienstverlener met toestemming gegevens ophaalt." ;
    skos:prefLabel_nl "Gegevensset" ;
    skos:status "proposed" ;
    mim:elementtype "Objecttype" .

gbovz:Gegevensverzoek a owl:Class ;
    rdfs:label "Gegevensverzoek" ;
    rdfs:subClassOf [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ] ;
    skos:definition "De transactie waarmee brondata wordt opgevraagd, op basis van precies een grondslag." ;
    skos:definitionSource "GBO PSA" ;
    skos:definition_nl "De transactie waarmee brondata wordt opgevraagd, op basis van precies een grondslag." ;
    skos:exactMatch gbobegrip:Gegevensverzoek,
        gbovz:Gegevensverzoek ;
    skos:inScheme gbo:voorzieningen ;
    skos:note "De initiatiefnemer is een Rol en geen vast objecttype. Daarmee kan het verzoek worden gestart door een dienstverlener, door de betrokkene zelf (wallet) of door een EU-overheidsdienst (OOTS)." ;
    skos:prefLabel_nl "Gegevensverzoek" ;
    skos:status "proposed" ;
    mim:elementtype "Objecttype" .

gbovz:Interactiepatroon a owl:Class ;
    rdfs:label "Interactiepatroon" ;
    rdfs:subClassOf [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ] ;
    skos:definition "Een van de manieren waarop een gegevensverzoek tot stand komt en wordt beantwoord, met vaste afspraken over wie initieert, wie ontvangt en welke grondslag geldt." ;
    skos:definitionSource "GBO PSA, hoofdstuk Interactiepatronen" ;
    skos:definition_nl "Een van de manieren waarop een gegevensverzoek tot stand komt en wordt beantwoord, met vaste afspraken over wie initieert, wie ontvangt en welke grondslag geldt." ;
    skos:exactMatch gbobegrip:Interactiepatroon,
        gbovz:Interactiepatroon ;
    skos:inScheme gbo:voorzieningen ;
    skos:note "Het patroon is geexpliciteerd als objecttype zodat de verschillen tussen de drie kanalen in gegevens vastliggen in plaats van in de structuur van het model. Een nieuw kanaal is dan een nieuw voorkomen, geen modelwijziging." ;
    skos:prefLabel_nl "Interactiepatroon" ;
    skos:status "proposed" ;
    mim:elementtype "Objecttype" ;
    mim:herkomst "GBO PSA, hoofdstuk Interactiepatronen" .

gbovz:Mapping a owl:Class ;
    rdfs:label "Mapping" ;
    rdfs:subClassOf [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ] ;
    skos:definition "De vastgelegde omzetting tussen gegevenselementen uit een bron en de structuur die een leveringsvorm voorschrijft." ;
    skos:definitionSource "GBO (voorstel); de PSA benoemt de semantische mapping expliciet bij OOTS" ;
    skos:definition_nl "De vastgelegde omzetting tussen gegevenselementen uit een bron en de structuur die een leveringsvorm voorschrijft." ;
    skos:exactMatch gbobegrip:Mapping,
        gbovz:Mapping ;
    skos:inScheme gbo:voorzieningen ;
    skos:note "De PSA benoemt bij OOTS expliciet een semantische mapping tussen het SDG-formaat en het bronformaat. Dezelfde behoefte speelt bij EUDI-attestatieschema's. Door de mapping te benoemen is traceerbaar welk brongegeven achter een geleverd veld zit." ;
    skos:prefLabel_nl "Mapping" ;
    skos:status "proposed" ;
    mim:elementtype "Objecttype" .

gbovz:Rol a owl:Class ;
    rdfs:label "Rol" ;
    rdfs:subClassOf [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ] ;
    skos:definition "De functie die een partij in een specifieke context vervult, zoals bronhouder van een register, dienstverlener in een transactie of afnemer van een levering." ;
    skos:definitionSource "GBO (voorstel), afgeleid uit de DvTP-functionele requirements en de rolverdeling in de GBO PSA" ;
    skos:definition_nl "De functie die een partij in een specifieke context vervult, zoals bronhouder van een register, dienstverlener in een transactie of afnemer van een levering." ;
    skos:exactMatch gbobegrip:Rol,
        gbovz:Rol ;
    skos:inScheme gbo:voorzieningen ;
    skos:note "Rol staat los van Partij: een partij is een rechtsdragend subject, een rol is wat die partij in een bepaalde context doet. Dezelfde niet-natuurlijke persoon kan tegelijk dienstverlener in het ene verzoek en afnemer in het andere zijn. Door rol en partij gescheiden te houden vermijdt het model een wildgroei aan subtypes van Partij voor elke nieuwe actor die een kanaal introduceert." ;
    skos:prefLabel_nl "Rol" ;
    skos:status "proposed" ;
    mim:elementtype "Relatieklasse" ;
    mim:herkomst "GBO" ;
    mim:populatie "Alle voorkomens waarin een partij in de bronontsluiting een gedefinieerde functie vervult." ;
    mim:uniekeAanduiding "samengesteld uit (partij, rolsoort, context, datumIngang)" .

