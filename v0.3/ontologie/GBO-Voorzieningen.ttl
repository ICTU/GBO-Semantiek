        <https://lod.gbo-semantiek.nl/voorzieningen/attestatiesoort#QEAA> .

gbovz:Betrokkene a owl:Class ;
    rdfs:label "Betrokkene" ;
    rdfs:subClassOf [ ],
        [ ],
        [ ] ;
    skos:definition "De natuurlijke persoon om wiens gegevens het in een gegevensverzoek gaat." ;
    skos:definitionSource "GBO (voorstel); term ontleend aan de AVG, waar de betrokkene degene is op wie persoonsgegevens betrekking hebben" ;
    skos:definition_nl "De natuurlijke persoon om wiens gegevens het in een gegevensverzoek gaat." ;
    skos:exactMatch gbobegrip:Betrokkene,
        gbovz:Betrokkene ;
    skos:inScheme gbo:voorzieningen ;
    skos:note "Betrokkene is bewust abstract. In het Nederlandse patroon is de betrokkene een burger met een BSN; bij OOTS gaat het om een persoon die door een buitenlandse overheid is geidentificeerd en die geen BSN hoeft te hebben. Beide moeten in hetzelfde gegevensverzoek passen." ;
    skos:prefLabel_nl "Betrokkene" ;
    skos:status "proposed" ;
    mim:elementtype "Objecttype" ;
    mim:indicatieAbstractObject "Ja" .

gbovz:Grondslag a owl:Class ;
    rdfs:label "Grondslag" ;
    rdfs:subClassOf [ ],
        [ ],
        [ ],
        [ ],
        [ ] ;
    skos:definition "De juridische basis voor gegevensuitwisseling: toestemming van de betrokkene of een wettelijke verplichting." ;
    skos:definitionSource "GBO PSA" ;
    skos:definition_nl "De juridische basis voor gegevensuitwisseling: toestemming van de betrokkene of een wettelijke verplichting." ;
    skos:exactMatch gbobegrip:Grondslag,
        gbovz:Grondslag ;
    skos:inScheme gbo:voorzieningen ;
    skos:note "Grondslag is het supertype; Toestemming is een van de twee vormen, niet de enige. Een gegevensverzoek verwijst naar precies een grondslag. Dat maakt het OOTS-patroon modelleerbaar, waar de grondslag de SDG-verordening is en er geen toestemming aan te pas komt." ;
    skos:prefLabel_nl "Grondslag" ;
    skos:status "proposed" ;
    mim:elementtype "Objecttype" ;
    mim:indicatieAbstractObject "Ja" .

